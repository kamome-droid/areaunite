---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SubNav from "../components/SubNav.astro";
import Section from "../components/Section.astro";
import Timetable from "../components/Timetable.astro";
import { getCurrentEvent, resolveProgram } from "../lib/content";

const event = await getCurrentEvent();
const ev = event?.data;
const days = await Promise.all(
  (ev?.schedule ?? []).map(async (day) => ({
    day,
    blocks: await resolveProgram(day),
  }))
);
---

<BaseLayout title="Schedule｜スケジュール" description="当日のスケジュール。">
  <PageHero label="Schedule" jp="スケジュール" />

  {
    days.length > 1 && (
      <SubNav items={days.map(({ day }) => ({ href: `#${day.id}`, label: day.jp }))} />
    )
  }

  {
    days.map(({ day, blocks }, i) => (
      <Section
        id={day.id}
        label={day.label}
        jp={day.note || undefined}
        surface={i % 2 === 1}
      >
        {blocks.length > 0 ? (
          <Timetable blocks={blocks} />
        ) : (
          <p class="empty muted">準備中です。決まりしだい公開します。</p>
        )}
      </Section>
    ))
  }
</BaseLayout>

<style>
  .empty {
    padding-block: 40px;
    text-align: center;
  }
</style>
