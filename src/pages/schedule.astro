---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import DayTabs from "../components/DayTabs.astro";
import Timetable from "../components/Timetable.astro";
import ShareImage from "../components/ShareImage.astro";
import { getCurrentEvent, resolveProgram } from "../lib/content";
import { schedulePageCount } from "../lib/og/templates";
import HiddenNote from "../components/HiddenNote.astro";
import { showsComingSoon } from "../lib/visibility";

const event = await getCurrentEvent();
const ev = event?.data;
// 準備中なら COMING SOON に差し替える（URLはそのまま）
if (showsComingSoon(ev, "schedule", Astro)) return Astro.rewrite("/soon/schedule");

// コンテンツが準備中なら、表から個別ページへのリンクを外す（開いても COMING SOON になるため）
const linkItems = !showsComingSoon(ev, "contents", Astro);
const days = await Promise.all(
  (ev?.schedule ?? []).map(async (day) => ({
    day,
    blocks: (await resolveProgram(day)).map((b) =>
      linkItems ? b : { ...b, items: b.items.map((s) => ({ ...s, href: undefined })) }
    ),
  }))
);

/** 1日開催ならタブは要らないので、そのまま表を出す */
const single = days.length === 1 ? days[0] : null;
---

<BaseLayout title="Schedule｜スケジュール" description="当日のスケジュール。">
  <PageHero label="Schedule" jp="スケジュール" />
  <HiddenNote page="schedule" />

  {days.length > 1 && <DayTabs days={days} />}

  {
    single && (
      <section class="single">
        <div class="wrap">
          {single.blocks.length > 0 ? (
            <>
              <Timetable blocks={single.blocks} />
              <p class="share">
                <ShareImage
                  srcs={Array.from(
                    { length: schedulePageCount(single.blocks) },
                    (_, n) => `/api/og/schedule.png?id=${single.day.id}&page=${n + 1}`
                  )}
                  name={`areaunite-${single.day.id}`}
                  title="スケジュール"
                />
              </p>
            </>
          ) : (
            <p class="empty muted">準備中です。決まりしだい公開します。</p>
          )}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .single {
    padding-block: clamp(40px, 6vw, 72px);
  }

  .share {
    margin-top: clamp(28px, 4vw, 44px);
  }

  .empty {
    padding-block: 40px;
    text-align: center;
  }
</style>
