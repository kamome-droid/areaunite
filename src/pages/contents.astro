---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PageIndex from "../components/PageIndex.astro";
import GroupSection from "../components/GroupSection.astro";
import { parents, groupsOf } from "../config/site";
import HiddenNote from "../components/HiddenNote.astro";
import { getCurrentEvent } from "../lib/content";
import { showsComingSoon } from "../lib/visibility";

// 準備中なら COMING SOON に差し替える（URLはそのまま）
if (showsComingSoon((await getCurrentEvent())?.data, "contents", Astro)) return Astro.rewrite("/soon/contents");

/** site.ts の groups に parent:"contents" を1件足すと、
    このページにセクションが1つ増え、タブとナビにも自動で並ぶ。 */
const list = groupsOf("contents");
---

<BaseLayout
  title={`${parents.contents.label}｜${parents.contents.jp}`}
  description="当日のムービー・ライブ・トークショー・フード・ショップの内容。"
>
  <PageHero
    label={parents.contents.label}
    jp={parents.contents.jp}
  />
  <HiddenNote page="contents" />

  <PageIndex items={list.map(([key, g]) => ({ href: `#${key}`, label: g.jp }))} />

  {list.map(([key, g], i) => <GroupSection id={key} def={g} surface={i % 2 === 1} />)}
</BaseLayout>
