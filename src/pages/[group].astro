---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ItemLayout from "../components/ItemLayout.astro";
import Card from "../components/Card.astro";
import Row from "../components/Row.astro";
import { groups } from "../config/site";
import { getItems } from "../lib/content";

/** site.ts の groups に1件足すだけで、この一覧ページが1枚増える。 */
export function getStaticPaths() {
  return Object.entries(groups).map(([group, def]) => ({
    params: { group },
    props: { def },
  }));
}

const { group } = Astro.params;
const { def } = Astro.props;

const items = await getItems(group!);
const bodies = await Promise.all(items.map((i) => render(i)));
---

<BaseLayout title={`${def.label}｜${def.jp}`} description={def.lead}>
  <PageHero label={def.label} jp={def.jp} lead={def.lead} />

  <section class="page">
    <div class="wrap">
      {
        items.length === 0 ? (
          <p class="empty muted">準備中です。決まりしだい公開します。</p>
        ) : (
          <ItemLayout layout={def.layout}>
            {items.map((item, i) => {
              const Body = bodies[i].Content;
              const common = {
                title: item.data.title,
                subtitle: item.data.subtitle,
                time: item.data.time,
                image: item.data.image,
                link: item.data.link,
                linkLabel: item.data.linkLabel,
              };
              return def.layout === "list" ? (
                <Row {...common}>
                  <Body />
                </Row>
              ) : (
                <Card {...common} ratio={def.ratio}>
                  <Body />
                </Card>
              );
            })}
          </ItemLayout>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(40px, 6vw, 72px) 0;
  }

  .empty {
    padding-block: 60px;
    text-align: center;
  }
</style>
