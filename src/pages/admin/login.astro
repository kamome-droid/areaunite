---
export const prerender = false;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>ログイン｜AREA UNITE 管理</title>
  </head>
  <body>
    <form class="box" method="post" action="/api/admin/login">
      <h1>AREA UNITE<span>管理画面</span></h1>
      <label>
        パスワード
        <input type="password" name="password" autocomplete="current-password" autofocus required />
      </label>
      <button type="submit">ログイン</button>
      {
        Astro.url.searchParams.has("error") && (
          <p class="error">パスワードが違います</p>
        )
      }
    </form>

    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #1b1b1e;
        color: #fff;
        font-family: "Hiragino Sans", "Noto Sans JP", system-ui, sans-serif;
      }

      .box {
        width: min(340px, calc(100vw - 40px));
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      h1 {
        margin: 0 0 6px;
        font-size: 20px;
        letter-spacing: 0.04em;
      }

      h1 span {
        display: block;
        font-size: 11px;
        font-weight: 400;
        letter-spacing: 0.16em;
        color: #9b9ba3;
      }

      label {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 13px;
        color: #c7c7ce;
      }

      input {
        padding: 10px 12px;
        border: 1px solid #45454d;
        border-radius: 8px;
        background: #26262b;
        color: #fff;
        font: inherit;
      }

      button {
        min-height: 40px;
        border: 0;
        border-radius: 8px;
        background: #fff;
        color: #1b1b1e;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }

      .error {
        margin: 0;
        color: #ff9e97;
        font-size: 13px;
      }
    </style>
  </body>
</html>
