---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { collections } from "../../../lib/admin/schema";
import { readAll } from "../../../lib/admin/store";
import { groups } from "../../../config/site";

const key = Astro.params.collection!;
const def = collections[key];
if (!def) return Astro.redirect("/admin/");

// 単一ファイルを編集する画面は、一覧を挟まず直接フォームへ
if (def.singleton) return Astro.redirect(`/admin/${key}/${def.singleton}`);

const entries = (await readAll(def)).filter((e) => def.filter?.(e.data) ?? true);
entries.sort((a, b) => {
  if (def.groupBy) {
    const ga = String(a.data[def.groupBy] ?? "");
    const gb = String(b.data[def.groupBy] ?? "");
    if (ga !== gb) return Object.keys(groups).indexOf(ga) - Object.keys(groups).indexOf(gb);
  }
  const oa = Number(a.data[def.order ?? "order"] ?? 0);
  const ob = Number(b.data[def.order ?? "order"] ?? 0);
  if (oa !== ob) return oa - ob;
  return String(a.data[def.titleField] ?? "").localeCompare(
    String(b.data[def.titleField] ?? ""),
    "ja"
  );
});

/** 分類ごとにまとめて出す。項目が増えても探しやすい */
const sections = def.groupBy
  ? Object.entries(groups).map(([gk, g]) => ({
      key: gk,
      label: g.jp,
      rows: entries.filter((e) => e.data[def.groupBy!] === gk),
    }))
  : [{ key: "", label: "", rows: entries }];
---

<AdminLayout title={def.label} current={key}>
  <div class="tools">
    <a class="btn" href={`/admin/${key}/new`}>＋ 新しく追加</a>
    <span id="orderStatus" class="tools__status"></span>
  </div>

  {
    sections.map((section) =>
      section.rows.length === 0 && section.key ? null : (
        <div class="panel">
          <div class="group">
            <h2 class="group__name">{section.label}</h2>
            <span class="group__sort">
              並べ替え
              {section.rows.some((r) => r.data.time) && (
                <button type="button" class="group__btn" data-sort="time">
                  時刻順
                </button>
              )}
              <button type="button" class="group__btn" data-sort="title">
                名前順
              </button>
            </span>
          </div>
          <div class="panel__body">
          <ul class="rows" data-list>
            {section.rows.map((entry) => (
              <li data-id={entry.id} data-time={entry.data.time ?? ""} data-title={entry.data[def.titleField] ?? entry.id}>
                <button type="button" class="rows__grip" title="ドラッグで並べ替え" aria-label="並べ替え">
                  ☰
                </button>
                <a href={`/admin/${key}/${entry.id}`}>
                  <span class="rows__title">
                    {entry.data[def.titleField] || entry.id}
                  </span>
                  {entry.data.subtitle && (
                    <span class="rows__sub">{entry.data.subtitle}</span>
                  )}
                  {entry.data.time && (
                    <span class="rows__time">{entry.data.time}</span>
                  )}
                  {entry.data.draft && <span class="rows__draft">下書き</span>}
                </a>
                <button
                  type="button"
                  class="rows__del"
                  data-del={entry.id}
                  data-title={entry.data[def.titleField] ?? entry.id}
                  title="削除"
                  aria-label="削除"
                >
                  ✕
                </button>
              </li>
            ))}
          </ul>
          </div>
        </div>
      )
    )
  }
</AdminLayout>

<script define:vars={{ collection: key }}>
  const status = document.getElementById("orderStatus");
  const say = (text) => {
    if (status) status.textContent = text;
  };

  /** その並びを order として書き戻す */
  const save = async (list) => {
    const ids = [...list.children].map((li) => li.dataset.id);
    say("並び順を保存中…");
    const res = await fetch("/api/admin/order", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ collection, ids }),
    }).catch(() => null);
    if (!res?.ok) return say("並び順を保存できませんでした。もう一度お試しください");
    waitLive((await res.json()).commit, "並び順を保存しました");
  };

  /** 保存したあと、サイトに出るまでを知らせる（作り直しに1〜2分かかる） */
  const waitLive = (commit, done) => {
    if (!commit) return say(done);
    say(`${done}。サイトに反映しています…`);
    window.adminWaitLive(commit, {
      live: () => say(`${done}。サイトに反映されました`),
      slow: () => say(`${done}。サイトへの反映に時間がかかっています`),
    });
  };

  document.querySelectorAll("[data-list]").forEach((list) => {
    let from = null;

    list.querySelectorAll("li").forEach((li) => {
      const grip = li.querySelector(".rows__grip");
      // つまみを押したときだけ動かせるようにする
      grip?.addEventListener("pointerdown", () => (li.draggable = true));
      grip?.addEventListener("pointerup", () => (li.draggable = false));

      li.addEventListener("dragstart", (e) => {
        from = li;
        li.classList.add("is-dragging");
        e.dataTransfer.effectAllowed = "move";
      });
      li.addEventListener("dragend", () => {
        li.draggable = false;
        li.classList.remove("is-dragging");
        from = null;
        list.querySelectorAll(".is-over").forEach((n) => n.classList.remove("is-over"));
      });
      li.addEventListener("dragover", (e) => {
        // 同じ分類の中でだけ動かす
        if (!from || from === li || from.parentElement !== list) return;
        e.preventDefault();
        li.classList.add("is-over");
      });
      li.addEventListener("dragleave", () => li.classList.remove("is-over"));
      li.addEventListener("drop", (e) => {
        e.preventDefault();
        li.classList.remove("is-over");
        if (!from || from === li || from.parentElement !== list) return;
        const rows = [...list.children];
        const before = rows.indexOf(from) < rows.indexOf(li);
        li.insertAdjacentElement(before ? "afterend" : "beforebegin", from);
        save(list);
      });
    });
  });

  /** 一覧から直接消す。中身を開かずに片づけられるように */
  document.querySelectorAll("[data-del]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.dataset.del;
      const name = btn.dataset.title;
      if (!(await window.adminConfirm(`「${name}」を削除します。元に戻せません。`))) return;
      const res = await fetch("/api/admin/delete", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ collection, id }),
      });
      if (!res.ok) return say("削除できませんでした");
      btn.closest("li")?.remove();
      waitLive((await res.json()).commit, "削除しました");
    });
  });

  /** その分類の中だけを、時刻順か名前順へ並べ直す */
  document.querySelectorAll("[data-sort]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const by = btn.dataset.sort;
      const list = btn.closest(".panel")?.querySelector("[data-list]");
      if (!list) return;
      const rows = [...list.children];
      rows.sort((a, b) => {
        if (by === "time") {
          const ta = a.dataset.time || "zz";
          const tb = b.dataset.time || "zz";
          if (ta !== tb) return ta.localeCompare(tb);
        }
        return (a.dataset.title || "").localeCompare(b.dataset.title || "", "ja");
      });
      rows.forEach((row) => list.append(row));
      await save(list);
    });
  });
</script>

<style>
  /* 分類ごとに1枠。上に見出しの帯を敷いて、枠の中身だと分かるようにする */
  .panel {
    padding: 0;
    overflow: hidden;
  }

  .panel__body {
    padding: 4px 16px 12px;
  }

  .group {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0;
    padding: 12px 16px;
    background: #f4f4f2;
    border-bottom: 1px solid var(--a-line);
  }

  .group__name {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--a-muted);
  }

  .group__sort {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--a-muted);
  }

  .group__btn {
    padding: 4px 11px;
    border: 1px solid var(--a-line);
    border-radius: 999px;
    background: #fff;
    font: inherit;
    font-size: 12px;
    cursor: pointer;
  }

  .group__btn:hover {
    border-color: var(--a-ink);
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rows li + li {
    border-top: 1px solid var(--a-line);
  }

  .rows li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) 28px;
    align-items: center;
  }

  .rows__del {
    padding: 4px;
    border: 0;
    background: none;
    color: var(--a-muted);
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
  }

  .rows__del:hover {
    color: var(--a-danger);
  }

  .rows li.is-dragging {
    opacity: 0.45;
  }

  .rows li.is-over {
    box-shadow: 0 -2px 0 var(--a-ink);
  }

  .rows__grip {
    padding: 4px;
    border: 0;
    background: none;
    color: var(--a-muted);
    font-size: 13px;
    line-height: 1;
    cursor: grab;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 16px;
  }


  .tools__status {
    font-size: 13px;
    color: var(--a-muted);
  }

  .rows a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px 4px;
    text-decoration: none;
  }

  .rows a:hover {
    background: #fafafa;
  }

  .rows__title {
    font-weight: 600;
  }

  .rows__sub {
    color: var(--a-muted);
    font-size: 13px;
  }

  .rows__time {
    margin-left: auto;
    color: var(--a-muted);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .rows__draft {
    padding: 2px 8px;
    border: 1px solid var(--a-line);
    border-radius: 999px;
    font-size: 11px;
    color: var(--a-muted);
  }
</style>
