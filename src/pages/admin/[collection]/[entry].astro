---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { collections, type Field } from "../../../lib/admin/schema";
import { readOne, readAll } from "../../../lib/admin/store";
import { groups } from "../../../config/site";

const key = Astro.params.collection!;
const id = Astro.params.entry!;
const def = collections[key];
if (!def) return Astro.redirect("/admin/");

const isNew = id === "new";
const entry = isNew ? null : await readOne(def, id);
if (!isNew && !entry) return Astro.redirect(`/admin/${key}/`);

/** 選択肢を実データから埋める。分類や開催日を手で打たせない */
const eventEntry = (await readAll(collections.top))[0];
const dayOptions = (
  Array.isArray(eventEntry?.data.schedule) ? eventEntry!.data.schedule : []
).map((d: any) => ({ value: String(d.id), label: `${d.label}（${d.note ?? ""}）` }));

const fields: Field[] = def.fields.map((f) => {
  if (f.type !== "select" && f.type !== "pills") return f;
  if (f.name === "group") {
    return {
      ...f,
      options: Object.entries(groups)
        // 宿泊はアクセス側の画面で扱う
        .filter(([k]) => k !== "stay")
        .map(([k, g]) => ({ value: k, label: g.jp })),
    };
  }
  if (f.name === "day") {
    return { ...f, options: [{ value: "", label: "（指定しない）" }, ...dayOptions] };
  }
  return f;
});

const data: Record<string, any> = { ...(isNew ? (def.defaults ?? {}) : {}), ...(entry?.data ?? {}) };
// 日付は Date のまま渡すと保存で形が変わるので、文字列にそろえる
if (data.date instanceof Date) data.date = data.date.toISOString().slice(0, 10);
// 選択肢は文字列で比べるため
if (data.tier != null) data.tier = String(data.tier);

const title = isNew
  ? `${def.labelOne}を追加`
  : // 開催回を分担する画面（トップページ・アバウト…）は、どれも開催回の名前になって
    // 区別がつかないので、画面の名前で出す
    def.singleton
    ? def.label
    : String(data[def.titleField] || def.labelOne);
const groupOptions = Object.entries(groups).map(([k, g]) => ({ value: k, label: g.jp }));
/** 分類ごとの欄の名前（ムービーなら「作品タイトル」、フードなら「店名」…） */
const groupLabels = Object.fromEntries(Object.entries(groups).map(([k, g]) => [k, g.labels ?? {}]));

/** この画面の中で直接編集する、別コレクションの項目（アクセス画面の宿泊など） */
const subFields = def.fields.filter((f) => f.type === "sub") as Extract<Field, { type: "sub" }>[];
const subRows: Record<string, any[]> = {};
/** その場で編集する欄のために、相手コレクションの項目定義と初期値も渡す */
const subDefs: Record<string, Field[]> = {};
const subDefaults: Record<string, Record<string, any>> = {};
for (const f of subFields) {
  const sub = collections[f.collection];
  if (!sub) continue;
  const rows = (await readAll(sub)).filter((e) => sub.filter?.(e.data) ?? true);
  rows.sort((a, b) => Number(a.data.order ?? 0) - Number(b.data.order ?? 0));
  subRows[f.name] = rows.map((e) => ({ id: e.id, data: e.data, body: e.body }));
  subDefs[f.collection] = sub.fields;
  subDefaults[f.collection] = sub.defaults ?? {};
}

/** スケジュール画面に薄く出す「コンテンツ側から自動で並ぶ行」。
    ここは読むだけ。直すのはコンテンツ画面 */
const autoRows =
  key === "schedule"
    ? (await readAll(collections.items))
        .filter((e) => e.data.time)
        .map((e) => {
          const g = groups[e.data.group as keyof typeof groups];
          const bracket = g?.scheduleFormat === "bracket" && e.data.subtitle;
          return {
            id: e.id,
            day: e.data.day ? String(e.data.day) : "",
            time: String(e.data.time),
            title: bracket ? `${e.data.subtitle}「${e.data.title}」` : String(e.data.title),
            group: g?.jp ?? "",
          };
        })
    : [];

/** 左下の「戻る」。別の画面の中で編集している項目（宿泊・協賛）は、その画面の名前で出す */
const backKey = def.backTo?.split("/")[2];
const backLabel = backKey && collections[backKey] ? `← ${collections[backKey].label}へ戻る` : "← 一覧へ戻る";

/** 右に出すプレビューの行き先。新規作成中はまだページが無いので出さない */
const previewPath = !isNew && def.preview ? def.preview(id, data) : null;
/** iframe の src に # を付けると、その位置を出そうとして親の画面まで動いてしまう。
    読み込んだあとに iframe の中だけを動かすので、ここでは分けて持つ */
const previewSrc = previewPath?.split("#")[0] ?? null;
/** 「別タブで開く」。非公開のページも中身を見られるよう、プレビューの印を付ける */
const previewTab = previewSrc
  ? `${previewSrc}${previewSrc.includes("?") ? "&" : "?"}preview${previewPath!.includes("#") ? "#" + previewPath!.split("#")[1] : ""}`
  : null;
const previewHash = previewPath?.split("#")[1] ?? "";
---

<AdminLayout title={title} current={key} wide={!!previewPath} pageSwitch={!!def.singleton}>
  <div class:list={["split", previewPath && "split--preview"]}>
    <div class="split__form">
      {/* 保存バーはこの枠の中だけに効く。下の別枠（宿泊など）とは切り離す */}
      <div class="formbox">
        <form id="form" class="panel">
    <div id="fields"></div>

    {
      def.hasBody && (
        <div class="field" id="bodyfield">
          <label class="field__label" for="body">
            {def.bodyLabel ?? "本文"}
          </label>
          <textarea id="body" rows="10" set:html={entry?.body ?? ""} />
        </div>
      )
    }
        </form>

        <div class="bar">
          {!def.singleton && (
            <a class="btn btn--ghost" href={def.backTo ?? `/admin/${key}/`}>
            {backLabel}
          </a>
        )}
          <span id="status" class="bar__status" />
        {
          !def.singleton && !isNew && (
            <button class="bar__delete" id="delete" type="button">
              削除
            </button>
          )
        }
          <button class="btn" id="save" type="button">保存する</button>
        </div>
      </div>

      <div id="extras" />
    </div>

    {
      previewPath && (
        <aside class="preview">
          <div class="preview__bar">
            <span>プレビュー</span>
            <span id="previewState" class="preview__state" />
            <button type="button" id="reload" class="preview__btn">
              更新
            </button>
            <a href={previewTab} target="_blank" rel="noopener" class="preview__btn">
              別タブで開く ↗
            </a>
          </div>
          <iframe id="preview" src={previewSrc} data-hash={previewHash} title="プレビュー" />
          <p class="preview__note">
            保存していない変更はプレビューに出ません。保存すると、サイトに反映されたところで（1〜2分）自動で更新されます
          </p>
        </aside>
      )
    }
  </div>
</AdminLayout>

<script
  define:vars={{
    collection: key,
    entryId: isNew ? null : id,
    backTo: def.backTo ?? `/admin/${key}/`,
    fields,
    data,
    groupOptions,
    groupLabels,
    dayOptions,
    autoRows,
    subRows,
    subDefs,
    subDefaults,
  }}
>
  const root = document.getElementById("fields");
  /** この画面の中で編集している、別コレクションの内容 */
  const subState = {};

  /** 画像のパスから名前を作る。/images/sponsors/the-north-face.png → the north face */
  const fileTitle = (path) =>
    decodeURIComponent(String(path ?? "").split("/").pop() ?? "")
      .replace(/\.[a-z0-9]+$/i, "")
      // 保存するときに先頭へ付ける時刻の数字は、名前には使わない
      .replace(/^\d{10,}-/, "")
      .replace(/[-_]+/g, " ")
      .trim();
  // 本文欄は Astro 側で出してあるものを使い回す。組み直しても失わないよう持っておく
  const bodyField = document.getElementById("bodyfield");
  const state = structuredClone(data);

  const el = (tag, attrs = {}, ...kids) => {
    const n = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) {
      if (k === "class") n.className = v;
      else if (k.startsWith("on")) n.addEventListener(k.slice(2), v);
      else if (v != null && v !== false) n.setAttribute(k, v === true ? "" : v);
    }
    kids.flat().forEach((c) => n.append(c?.nodeType ? c : document.createTextNode(c ?? "")));
    return n;
  };

  /** 後ろで定義するものを、先に定義した部品から呼ぶための受け口 */
  const hooks = { edited: () => {} };

  /** 送っている途中のアップロード。保存はこれが空になるまで待つ */
  const uploads = new Set();
  const UPLOADING = "画像をアップロードしています…";
  const uploadStatus = () => {
    const status = document.getElementById("status");
    if (uploads.size) {
      status.textContent = UPLOADING;
      status.dataset.tone = "";
      return;
    }
    if (status.textContent === UPLOADING) status.textContent = "";
    // 終わったら「保存していない変更があります」に戻す
    hooks.edited();
  };

  /** 画像ファイルを送って、置いた場所（パス）を返す。
      onBusy は送っている間だけ true で呼ばれる（表示を変えるため） */
  const uploadFile = (file, onDone, into = collection, media = "", onBusy = () => {}) => {
    const fd = new FormData();
    fd.append("collection", into);
    if (media) fd.append("media", media);
    fd.append("file", file);

    const job = (async () => {
      onBusy(true);
      try {
        const res = await fetch("/api/admin/upload", { method: "POST", body: fd });
        if (!res.ok) return alert("アップロードに失敗しました");
        const { url } = await res.json();
        onDone(url);
        hooks.edited();
      } finally {
        onBusy(false);
      }
    })();
    uploads.add(job);
    uploadStatus();
    job.finally(() => {
      uploads.delete(job);
      uploadStatus();
    });
  };

  /** ファイルを選ぶ画面を開いて、選んだ画像を送る */
  const pickImage = (onDone, into = collection, media = "", onBusy = () => {}) => {
    const input = el("input", { type: "file", accept: "image/*" });
    input.addEventListener("change", () => {
      const file = input.files?.[0];
      if (file) uploadFile(file, onDone, into, media, onBusy);
    });
    input.click();
  };

  // 画像の枠の外にファイルを落とすと、ブラウザがその画像を開いてしまい、書きかけが消える。
  // 枠の外では何もしないようにしておく
  for (const type of ["dragover", "drop"]) {
    window.addEventListener(type, (e) => {
      if (e.dataTransfer?.types?.includes("Files")) e.preventDefault();
    });
  }

  /**
   * 画像の欄。枠そのものを押すと選べる（ファイルを枠に落としてもよい）。
   * 空のときは点線の枠に「＋」、入っているときは画像を押すと差し替え。
   */
  const imageBox = (value, onChange, opts = {}) => {
    let current = value ?? "";

    if (opts.readOnly) {
      const thumb = el("div", { class: "img" });
      if (current) thumb.append(el("img", { src: current, alt: "" }));
      return el("div", { class: "imgfield imgfield--thumb" }, thumb);
    }

    const box = el("button", { type: "button", class: "img img--pick" });
    const clear = el("button", { type: "button", class: "btn btn--ghost btn--small" }, "外す");

    const draw = () => {
      box.replaceChildren();
      box.classList.toggle("is-empty", !current);
      box.setAttribute("aria-label", current ? "画像を変える" : "画像を追加する");
      if (current) {
        box.append(el("img", { src: current, alt: "" }), el("span", { class: "img__hint" }, "変更"));
      } else {
        box.append(
          el("span", { class: "img__plus", "aria-hidden": "true" }, "＋"),
          opts.compact ? "" : el("span", { class: "img__hint" }, "画像を追加")
        );
      }
      clear.hidden = !current;
    };

    const set = (url) => {
      current = url;
      onChange(url);
      draw();
    };
    const busy = (on) => {
      box.disabled = on;
      box.classList.toggle("is-busy", on);
      if (on) box.replaceChildren(el("span", { class: "img__hint" }, "アップロード中…"));
      else draw();
    };

    // 別コレクションの行（協賛のロゴなど）は、その置き場所の決まりでそろえる
    const into = opts.into ?? collection;
    box.addEventListener("click", () => pickImage(set, into, opts.media, busy));
    box.addEventListener("dragover", (e) => {
      if (!e.dataTransfer?.types?.includes("Files")) return;
      e.preventDefault();
      box.classList.add("is-over");
    });
    box.addEventListener("dragleave", () => box.classList.remove("is-over"));
    box.addEventListener("drop", (e) => {
      const file = e.dataTransfer?.files?.[0];
      if (!file) return;
      e.preventDefault();
      // 行の並べ替え（ドラッグ）のほうには渡さない
      e.stopPropagation();
      box.classList.remove("is-over");
      if (file.type.startsWith("image/")) uploadFile(file, set, into, opts.media, busy);
    });
    clear.addEventListener("click", () => set(""));
    draw();

    return el(
      "div",
      { class: `imgfield${opts.compact ? " imgfield--compact" : ""}${opts.logo ? " imgfield--thumb imgfield--logo" : ""}` },
      box,
      // 繰り返しの行には右端に ✕ があるので、外すボタンは出さない
      opts.clearable === false ? "" : el("div", { class: "imgfield__ctrl" }, clear)
    );
  };

  /** 並べ替え・追加・削除ができる箱。
      adders は [ラベル, 作る関数] の並び。1種類だけなら1つ渡す。
      並べ替えは左のつまみを掴んでドラッグする（キーボードは上下キー）。 */
  const repeater = (list, renderRow, adders, opts = {}) => {
    // 行ごとに掴めるかどうかを決められる。真偽値でも関数でもよい
    const canSort = (row) =>
      typeof opts.sortable === "function" ? opts.sortable(row) : opts.sortable !== false;
    const box = el("div", { class: "rep" });
    let dragFrom = null;

    const draw = () => {
      box.replaceChildren();

      const move = (from, to) => {
        if (from == null || to < 0 || to >= list.length || from === to) return;
        const [moved] = list.splice(from, 1);
        list.splice(to, 0, moved);
        opts.onSort?.(list, moved);
        opts.onChange?.(list);
        draw();
      };

      list.forEach((row, i) => {
        const sortable = canSort(row);
        const handle = el(
          "button",
          {
            type: "button",
            class: "rep__grip",
            title: "ドラッグで並べ替え",
            "aria-label": "並べ替え",
            onkeydown: (e) => {
              if (e.key === "ArrowUp") {
                e.preventDefault();
                move(i, i - 1);
              } else if (e.key === "ArrowDown") {
                e.preventDefault();
                move(i, i + 1);
              }
            },
          },
          "☰"
        );

        const item = el(
          "div",
          { class: "rep__row" },
          sortable ? handle : el("span", { class: "rep__grip rep__grip--none" }),
          el("div", { class: "rep__body" }, renderRow(row, i, draw)),
          opts.removable === false
            ? ""
            : el("button", {
            type: "button",
            class: "rep__del",
            title: "削除",
            "aria-label": "削除",
            onclick: async () => {
              const ask = opts.askText?.(list[i]) ?? "この行を削除しますか？";
              if (!(await window.adminConfirm(ask))) return;
              opts.onRemove?.(list[i]);
              list.splice(i, 1);
              opts.onChange?.(list);
              draw();
            },
          }, "✕")
        );

        // つまみを押したときだけ動かせるようにする。
        // 行ごと掴めるようにすると、入力欄の文字が選べなくなる
        if (sortable) {
          handle.addEventListener("pointerdown", () => (item.draggable = true));
          handle.addEventListener("pointerup", () => (item.draggable = false));

          item.addEventListener("dragstart", (e) => {
            dragFrom = i;
            item.classList.add("is-dragging");
            e.dataTransfer.effectAllowed = "move";
            e.dataTransfer.setData("text/plain", String(i));
          });
          item.addEventListener("dragend", () => {
            item.draggable = false;
            item.classList.remove("is-dragging");
            dragFrom = null;
            box.querySelectorAll(".is-over").forEach((n) => n.classList.remove("is-over"));
          });
        }

        // 掴めない行も、置き場所にはなる
        item.addEventListener("dragover", (e) => {
          if (dragFrom == null || dragFrom === i) return;
          e.preventDefault();
          item.classList.add("is-over");
        });
        item.addEventListener("dragleave", () => item.classList.remove("is-over"));
        item.addEventListener("drop", (e) => {
          e.preventDefault();
          item.classList.remove("is-over");
          move(dragFrom, i);
        });

        box.append(item);
      });

      if (adders.length === 0) return;

      const buttons = adders.map(([label, make]) =>
        el("button", {
          type: "button",
          class: "btn btn--small",
          onclick: async () => {
            const row = await make();
            if (!row) return;
            // 見出しのように「上から差し込む」ものだけ先頭へ。ほかは末尾に足す
            if (opts.addsAt === "top") list.unshift(row);
            else list.push(row);
            opts.onChange?.(list);
            draw();
          },
        }, label)
      );

      // 項目名の右に出すよう頼まれていれば、そこへ入れる
      if (opts.addsInto) {
        opts.addsInto.replaceChildren(...buttons);
        return;
      }
      const adds = el("div", { class: "rep__adds" }, buttons);
      if (opts.addsAt === "top") box.prepend(adds);
      else box.append(adds);
    };

    draw();
    // 外に出した追加ボタンから呼ぶ
    box.addRow = (row) => {
      list.unshift(row);
      opts.onChange?.(list);
      draw();
    };
    return box;
  };

  const labelFor = (f) =>
    el("label", { class: "field__label", for: `f-${f.name}` }, f.label);

  /** 項目名の行。右端に「＋ 追加」を置く */
  const headWithAdd = (f) => {
    const slot = el("div", { class: "field__add" });
    return [el("div", { class: "field__head" }, labelFor(f), slot), slot];
  };

  /** 説明文。[文字](/行き先) と書いたところだけリンクになる */
  const helpFor = (f) => {
    if (!f.help) return "";
    const box = el("p", { class: "field__help" });
    let rest = f.help;
    const re = /\[([^\]]+)\]\(([^)]+)\)/;
    let m;
    while ((m = re.exec(rest))) {
      if (m.index > 0) box.append(rest.slice(0, m.index));
      box.append(el("a", { href: m[2] }, m[1]));
      rest = rest.slice(m.index + m[0].length);
    }
    if (rest) box.append(rest);
    return box;
  };

  /** 1つの項目を描く */
  const renderField = (f, target, get, set, mode = {}) => {
    if (f.type === "hidden") return;

    const wrap = el("div", { class: "field" });
    const value = get(f.name);

    if (f.type === "switch") {
      // ページ全体のスイッチと同じ見た目。入れた値は「隠す」かどうか
      const box = el("div", { class: "toggle" });
      const button = el(
        "button",
        { type: "button", class: "toggle__switch", role: "switch" },
        el("span", { class: "toggle__track", "aria-hidden": "true" }, el("span", { class: "toggle__thumb" })),
        el("span", { class: "toggle__state" })
      );
      let hidden = !!value;
      const draw = () => {
        box.classList.toggle("toggle--off", hidden);
        button.setAttribute("aria-checked", hidden ? "false" : "true");
        button.querySelector(".toggle__state").textContent = hidden ? f.onText : f.offText;
      };
      button.addEventListener("click", () => {
        hidden = !hidden;
        set(f.name, hidden);
        draw();
      });
      draw();
      box.append(button);
      wrap.append(labelFor(f), box, helpFor(f));
    } else if (f.type === "boolean") {
      wrap.append(
        el(
          "label",
          { class: "check" },
          el("input", {
            type: "checkbox",
            checked: !!value,
            onchange: (e) => set(f.name, e.target.checked),
          }),
          f.label
        ),
        helpFor(f)
      );
    } else if (f.type === "select") {
      const sel = el("select", {
        id: `f-${f.name}`,
        onchange: (e) => set(f.name, e.target.value),
      });
      f.options.forEach((o) =>
        sel.append(el("option", { value: o.value, selected: String(value ?? "") === o.value }, o.label))
      );
      wrap.append(labelFor(f), sel, helpFor(f));
    } else if (f.type === "pills") {
      // 押して選ぶ。選べるのは1つだけ
      const box = el("div", { class: "pills" });
      const draw = () => {
        box.replaceChildren();
        f.options.forEach((o) => {
          const on = String(get(f.name) ?? "") === o.value;
          box.append(
            el("button", {
              type: "button",
              class: `pill${on ? " is-on" : ""}`,
              "aria-pressed": on ? "true" : "false",
              onclick: () => {
                set(f.name, o.value);
                // 分類で出す欄が変わるので、全部組み直す
                if (f.name === "group") drawFields();
                else draw();
              },
            }, o.label)
          );
        });
      };
      draw();
      wrap.append(labelFor(f), box, helpFor(f));
    } else if (f.type === "body") {
      // Astro 側で出してある本文欄を、この位置へ移す
      if (bodyField) target.append(bodyField);
      return;
    } else if (f.type === "textarea") {
      wrap.append(
        labelFor(f),
        el("textarea", {
          id: `f-${f.name}`,
          rows: 4,
          oninput: (e) => set(f.name, e.target.value),
        }, value ?? ""),
        helpFor(f)
      );
    } else if (f.type === "lines") {
      wrap.append(
        labelFor(f),
        el("textarea", {
          id: `f-${f.name}`,
          rows: 5,
          placeholder: f.placeholder,
          oninput: (e) =>
            set(
              f.name,
              e.target.value.split("\n").map((s) => s.trim()).filter(Boolean)
            ),
        }, (Array.isArray(value) ? value : []).join("\n")),
        helpFor(f)
      );
    } else if (f.type === "image") {
      wrap.append(labelFor(f), imageBox(value, (v) => set(f.name, v), mode), helpFor(f));
    } else if (f.type === "images") {
      const list = Array.isArray(value) ? [...value] : [];
      set(f.name, list);
      const [head, slot] = headWithAdd(f);
      wrap.append(
        head,
        repeater(
          list,
          (row, i) => imageBox(row, (v) => (list[i] = v), { clearable: false, media: f.media }),
          // 空の行を足してから選ばせるより、選んだ画像をそのまま足すほうが一手少ない
          [["＋ 画像を追加", () => new Promise((done) => pickImage(done, collection, f.media))]],
          { addsInto: slot }
        ),
        helpFor(f)
      );
    } else if (f.type === "rows") {
      const list = Array.isArray(value) ? value.map((r) => ({ ...r })) : [];
      set(f.name, list);
      const [head, slot] = headWithAdd(f);
      // 列の名前。入力すると欄の中の薄い字（券種・料金…）が消えて、どの列か分からなくなるため
      const grid = `grid-template-columns:${f.columns.map((c) => c.width ?? "1fr").join(" ")}`;
      const colhead = el(
        "div",
        { class: "rep__colhead" },
        el("span"),
        el("div", { class: "cols", style: grid }, f.columns.map((c) => el("span", {}, c.label))),
        el("span")
      );
      wrap.append(
        head,
        colhead,
        repeater(
          list,
          (row) =>
            el(
              "div",
              { class: "cols", style: `grid-template-columns:${f.columns.map((c) => c.width ?? "1fr").join(" ")}` },
              f.columns.map((c) =>
                el("input", {
                  type: "text",
                  value: row[c.name] ?? "",
                  placeholder: c.label,
                  oninput: (e) => (row[c.name] = e.target.value),
                })
              )
            ),
          [["＋ 行を追加", () => Object.fromEntries(f.columns.map((c) => [c.name, ""]))]],
          { addsInto: slot }
        ),
        helpFor(f)
      );
    } else if (f.type === "group") {
      const obj = value && typeof value === "object" ? { ...value } : {};
      set(f.name, obj);
      const inner = el("div", { class: "group" });
      f.fields.forEach((sub) =>
        renderField(sub, inner, (n) => obj[n], (n, v) => (obj[n] = v))
      );
      wrap.append(labelFor(f), inner, helpFor(f));
    } else if (f.type === "days") {
      const days = Array.isArray(value) ? structuredClone(value) : [];
      set(f.name, days);
      wrap.append(labelFor(f), daysEditor(days), helpFor(f));
    } else if (f.type === "sub" && f.inline) {
      // 項目が少ないものは、この画面の中で中身まで編集する。
      // 出す欄は相手コレクションの定義をそのまま使う
      const rows = structuredClone(subRows[f.name] ?? []);
      subState[f.name] = { rows, removed: [], collection: f.collection };
      const [head, slot] = headWithAdd(f);

      const blank = () => ({ id: null, data: { ...(subDefaults[f.collection] ?? {}) }, body: "" });
      // 画像1枚が主役の欄は、追加ボタンでそのまま画像を選ばせる
      const picture = (subDefs[f.collection] ?? []).find((sf) => sf.type === "image");
      const addRow =
        f.layout === "line" && picture
          ? () =>
              new Promise((done) =>
                pickImage((url) => {
                  const row = blank();
                  row.data[picture.name] = url;
                  if (!row.data.name) row.data.name = fileTitle(url);
                  done(row);
                }, f.collection)
              )
          : blank;

      wrap.append(
        head,
        repeater(
          rows,
          (row) => {
            const line = f.layout === "line";
            const box = el("div", { class: `subedit${line ? " subedit--line" : ""}` });
            (subDefs[f.collection] ?? [])
              .filter((sf) => sf.type !== "hidden" && sf.type !== "body")
              .forEach((sf) =>
                renderField(
                  sf,
                  box,
                  (n) => row.data[n],
                  (n, v) => {
                    row.data[n] = v;
                    // 名前を打たせない代わりに、画像のファイル名から埋める
                    if (n === "logo" && !row.data.name) row.data.name = fileTitle(v);
                  },
                  // ロゴは大きめの枠で、押すと差し替え（消すのは行の ✕）
                  line && sf.type === "image"
                    ? { logo: true, clearable: false, into: f.collection }
                    : line
                      ? { compact: true }
                      : {}
                )
              );
            return box;
          },
          [[f.addLabel ?? "＋ 追加", addRow]],
          {
            addsInto: slot,
            onRemove: (row) => {
              if (row.id) subState[f.name].removed.push(row.id);
            },
          }
        ),
        helpFor(f)
      );
    } else if (f.type === "sub") {
      // 名前だけ並べて、押したら個別ページで編集する
      const rows = subRows[f.name] ?? [];
      const [head, slot] = headWithAdd(f);
      slot.append(
        el(
          "a",
          { class: "btn btn--small", href: `/admin/${f.collection}/new` },
          f.addLabel ?? "＋ 追加"
        )
      );

      // コンテンツ一覧と同じ形：左のつまみで並べ替え、名前で個別ページ、右の ✕ で削除
      const list = el("ul", { class: "rows" });
      let from = null;

      /** 保存や削除のあと、サイトに出るまでを知らせる */
      const report = (commit, done) => {
        if (!commit) return say(done, "ok");
        say(`${done}。サイトに反映しています…`, "ok");
        preview.pending();
        window.adminWaitLive(commit, {
          live: () => sayLive(`${done}。サイトに反映されました`),
          slow: () => {
            if (!isDirty()) say(`${done}。サイトへの反映に時間がかかっています`);
          },
        });
      };

      const push = (row) => {
        const title = row.data.title || row.id;
        const li = el(
          "li",
          { "data-id": row.id },
          el("button", { type: "button", class: "rows__grip", title: "ドラッグで並べ替え", "aria-label": "並べ替え" }, "☰"),
          el(
            "a",
            { href: `/admin/${f.collection}/${row.id}` },
            el("span", { class: "rows__title" }, title),
            row.data.subtitle ? el("span", { class: "rows__sub" }, row.data.subtitle) : "",
            row.data.draft ? el("span", { class: "rows__draft" }, "下書き") : ""
          ),
          el(
            "button",
            {
              type: "button",
              class: "rows__del",
              title: "削除",
              "aria-label": "削除",
              onclick: async () => {
                if (!(await window.adminConfirm(`「${title}」を削除します。元に戻せません。`))) return;
                const res = await fetch("/api/admin/delete", {
                  method: "POST",
                  headers: { "content-type": "application/json" },
                  body: JSON.stringify({ collection: f.collection, id: row.id }),
                }).catch(() => null);
                if (!res?.ok) return say("削除できませんでした。もう一度お試しください", "error");
                li.remove();
                showEmpty();
                report((await res.json()).commit, "削除しました");
              },
            },
            "✕"
          )
        );

        const grip = li.querySelector(".rows__grip");
        grip.addEventListener("pointerdown", () => (li.draggable = true));
        grip.addEventListener("pointerup", () => (li.draggable = false));
        li.addEventListener("dragstart", () => {
          from = li;
          li.classList.add("is-dragging");
        });
        li.addEventListener("dragend", () => {
          li.draggable = false;
          li.classList.remove("is-dragging");
          from = null;
          list.querySelectorAll(".is-over").forEach((n) => n.classList.remove("is-over"));
        });
        li.addEventListener("dragover", (e) => {
          if (!from || from === li) return;
          e.preventDefault();
          li.classList.add("is-over");
        });
        li.addEventListener("dragleave", () => li.classList.remove("is-over"));
        li.addEventListener("drop", async (e) => {
          e.preventDefault();
          li.classList.remove("is-over");
          if (!from || from === li) return;
          const order = [...list.children];
          li.insertAdjacentElement(
            order.indexOf(from) < order.indexOf(li) ? "afterend" : "beforebegin",
            from
          );
          say("並び順を保存しています…");
          const res = await fetch("/api/admin/order", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              collection: f.collection,
              ids: [...list.children].map((n) => n.dataset.id),
            }),
          }).catch(() => null);
          if (!res?.ok) return say("並び順を保存できませんでした。もう一度お試しください", "error");
          report((await res.json()).commit, "並び順を保存しました");
        });

        list.append(li);
      };

      rows.forEach(push);
      // 1件も無いときは、枠が壊れて見えないよう一言出す
      const empty = el("p", { class: "rows__empty" }, `まだありません。「${f.addLabel ?? "＋ 追加"}」から足せます`);
      const showEmpty = () => (empty.hidden = list.children.length > 0);
      showEmpty();
      wrap.append(head, list, empty, helpFor(f));
    } else if (f.type === "schedule") {
      // 開催日の追加・削除はしない。中身だけ編集する
      const days = Array.isArray(value) ? structuredClone(value) : [];
      set(f.name, days);
      wrap.append(scheduleEditor(days), helpFor(f));
    } else {
      wrap.append(
        labelFor(f),
        el("input", {
          id: `f-${f.name}`,
          type: "text",
          value: value ?? "",
          placeholder: f.placeholder,
          oninput: (e) => set(f.name, e.target.value),
        }),
        helpFor(f)
      );
    }

    target.append(wrap);
  };

  /** 開催日そのもの。ここに足した数だけ DAY が増える。
      中身（プログラム）はスケジュール画面で編集するので、ここでは触らない。 */
  /** 開催日。日付と時間帯だけ直せる。
      日そのものの増減は、紐づいたコンテンツを置き去りにするので画面からは触らせない
      （開催回のファイルを作り直すときに直接書く） */
  const daysEditor = (days) =>
    repeater(
      days,
      (day, i) => {
        day.label = `DAY ${i + 1}`;
        day.parts = Array.isArray(day.parts) ? day.parts : [];
        day.extras = Array.isArray(day.extras) ? day.extras : [];

        const field = (label, name, placeholder) =>
          el(
            "label",
            { class: "day__line" },
            el("span", {}, label),
            el("input", {
              type: "text",
              value: day[name] ?? "",
              placeholder,
              oninput: (e) => (day[name] = e.target.value),
            })
          );

        return el(
          "div",
          { class: "dayrow" },
          el("span", { class: "dayrow__no" }, day.label),
          field("日付", "note", "2026.10.17 sat."),
          field("時間帯", "time", "12:00〜LATE")
        );
      },
      [],
      { sortable: false, removable: false }
    );

  /* ---- スケジュール ----
     コンテンツ画面で登録した項目は、時刻順に自動で並ぶ（薄い行）。
     ここで決めるのは2つだけ。
       見出し   … 第1部 ／ トーク & ライブ など。入れた時刻の位置に挟まる
       自由記述 … ゲートオープンなど、コンテンツに載せない行
     どちらも時刻順にそろうので、順番を手で触るところはない。 */

  /** 09:00 のかたちにそろえる。比べるためだけに使う */
  const timeKey = (v) => {
    const m = String(v ?? "").match(/(\d{1,2})\s*[:：]\s*(\d{2})/);
    return m ? `${m[1].padStart(2, "0")}:${m[2]}` : "";
  };

  /** 見出しには時刻が無い。すぐ下の行の時刻が、その見出しの入る位置になる */
  const headingTime = (rows, i) => {
    for (let j = i + 1; j < rows.length; j += 1) {
      const t = timeKey(rows[j].time);
      if (rows[j].kind !== "heading" && t) return t;
    }
    return "";
  };

  /** 時刻の早い順に並べ直す。見出しは掴んで動かすものなので、
      すぐ下の行にぶら下がったまま一緒に動く */
  const sortRows = (rows) => {
    const keys = rows.map((row, i) =>
      row.kind === "heading" ? headingTime(rows, i) : timeKey(row.time)
    );
    // 時刻の無い行は、下の行と同じ扱いにして位置を保つ
    for (let i = keys.length - 1; i >= 0; i -= 1) {
      if (!keys[i]) keys[i] = keys[i + 1] ?? "zz";
    }
    const keyed = rows.map((row, i) => ({ row, key: keys[i], i }));
    keyed.sort((a, b) => a.key.localeCompare(b.key) || a.i - b.i);
    rows.splice(0, rows.length, ...keyed.map((k) => k.row));
  };

  const buildRows = (day) => {
    const rows = [
      ...(day.parts ?? []).map((p) => ({
        kind: "heading",
        text: p.label ?? "",
        // 位置を決めるためだけの値。並べ終わったら time は空にする
        time: p.startsAt ?? "",
        at: p.startsAt ?? "",
      })),
      // 開場の行。コンテンツには載せないので、ここに固定で置いてある
      {
        kind: "gate",
        time: day.extras?.[0]?.time ?? "12:00",
        title: day.extras?.[0]?.title || "ゲートオープン",
        note: day.extras?.[0]?.note ?? "",
      },
      // コンテンツ画面のぶん。読むだけ
      ...autoRows
        .filter((a) => !a.day || a.day === day.id)
        .map((a) => ({ kind: "auto", id: a.id, time: a.time, title: a.title, group: a.group })),
    ];
    // 最初だけは、保存してある startsAt を手がかりに位置を決める。
    // 見出しは同時刻の行より前に置く（そこから始まる、という意味なので）
    const keyed = rows.map((row, i) => ({
      row,
      key: timeKey(row.time) || "zz",
      head: row.kind === "heading" ? 0 : 1,
      i,
    }));
    keyed.sort((a, b) => a.key.localeCompare(b.key) || a.head - b.head || a.i - b.i);
    rows.splice(0, rows.length, ...keyed.map((k) => k.row));

    // 以降、見出しの位置は並び順そのものが持つ
    rows.forEach((row) => {
      if (row.kind === "heading") row.time = "";
    });
    return rows;
  };

  const applyRows = (day, rows) => {
    day.parts = rows
      .map((row, i) =>
        row.kind === "heading"
          ? {
              label: row.text ?? "",
              // 下にまだ何も無い見出しは位置が決まらないので、前の値をそのまま残す
              startsAt: headingTime(rows, i) || row.at || "",
            }
          : null
      )
      .filter(Boolean)
      // 一番下に置かれた見出しは、下に並ぶものが無いので置き場所が決まらない
      .map((p) => (p.startsAt ? p : { label: p.label }));
    day.extras = rows
      .filter((r) => r.kind === "gate")
      .map((r) => {
        const out = { time: r.time ?? "", title: r.title ?? "" };
        if (r.note) out.note = r.note;
        return out;
      });
  };

  /** リストの1行。薄い行と開場の行は読むだけで、直せるのは見出しの文字と開場の時刻 */
  const renderScheduleRow = (row, rows, sync, redraw) => {
    // コンテンツの行は読むだけ。押すとそのコンテンツの編集画面へ
    if (row.kind === "auto") {
      return el(
        "div",
        { class: "srow srow--auto" },
        el("span", { class: "srow__time" }, row.time),
        el(
          "span",
          { class: "srow__body" },
          el("a", { href: `/admin/items/${row.id}`, title: "このコンテンツを編集する" }, row.title),
          el("span", { class: "srow__tag" }, row.group)
        )
      );
    }

    // 見出しは時刻を持たない。置き場所は ☰ で決める
    if (row.kind === "heading") {
      return el(
        "div",
        { class: "srow srow--heading" },
        el("input", {
          type: "text",
          class: "srow__wide",
          value: row.text ?? "",
          placeholder: "第1部 ／ トーク & ライブ",
          oninput: (e) => {
            row.text = e.target.value;
            sync();
          },
        })
      );
    }

    // 開場の行。変えられるのは時刻だけ
    return el(
      "div",
      { class: "srow srow--gate" },
      el("input", {
        type: "text",
        class: "srow__time",
        value: row.time ?? "",
        placeholder: "12:00",
        oninput: (e) => {
          row.time = e.target.value;
          sync();
        },
        onchange: () => {
          sortRows(rows);
          sync();
          redraw();
        },
      }),
      el("span", { class: "srow__body" }, row.title)
    );
  };

  const scheduleEditor = (days) => {
    const box = el("div", { class: "sched" });

    box.append(
      el(
        "p",
        { class: "sched__note" },
        el("a", { href: "/admin/items/" }, "コンテンツ"),
        " で登録した項目が、時刻順に自動で並びます。ここでは見出しを足したり直したりできます。"
      )
    );

    if (days.length === 0) {
      box.append(
        el(
          "p",
          { class: "sched__empty" },
          "開催日がまだありません。開催回のファイルに日を足してください。"
        )
      );
      return box;
    }

    days.forEach((day) => {
      const rows = buildRows(day);
      const sync = () => applyRows(day, rows);
      sync();

      const rep = repeater(
        rows,
        (row, _i, redraw) => renderScheduleRow(row, rows, sync, redraw),
        [],
        {
          // 掴んで動かせるのは見出しだけ。ほかは時刻の順に決まる
          sortable: (row) => row.kind === "heading",
          onChange: sync,
          onSort: (_list, moved) => {
            // 動かした見出しは、前の位置を忘れて今の並びに従う
            if (moved) moved.at = "";
            sync();
          },
        }
      );

      box.append(
        el(
          "section",
          { class: "day" },
          el(
            "div",
            { class: "day__head" },
            el(
              "h3",
              { class: "day__title" },
              day.label || day.id,
              el("span", { class: "day__date" }, day.note ?? "")
            ),
            el(
              "button",
              {
                type: "button",
                class: "btn btn--small day__add",
                onclick: () => rep.addRow({ kind: "heading", text: "", time: "" }),
              },
              "＋ 見出しを追加"
            )
          ),
          rep
        )
      );
    });

    return box;
  };

  /** 入力欄を組み直す。分類によって出す欄が変わる */
  const extras = document.getElementById("extras");
  const drawFields = () => {
    root.replaceChildren();
    extras.replaceChildren();
    fields
      .filter((f) => !f.hideFor?.includes(String(state.group ?? "")))
      // 欄の名前は分類によって変える。分類を選び直すと、ここから描き直される
      .map((f) => ({ ...f, label: groupLabels[state.group]?.[f.name] ?? f.label }))
      .forEach((f) => {
        // 別コレクションを扱う欄は、フォームとは別のフレームに出す
        const target =
          f.type === "sub" && !f.inline
            ? extras.appendChild(el("div", { class: "panel" }))
            : root;
        renderField(f, target, (n) => state[n], (n, v) => (state[n] = v));
      });
  };
  drawFields();

  // ---- プレビュー ----
  // 本番は保存するとサイトが作り直され、終わるまで1〜2分は前の内容が出る。
  // その間は「反映待ち」と出し、終わったら読み直す
  const frame = document.getElementById("preview");
  const previewState = document.getElementById("previewState");
  const preview = {
    pending() {
      if (!previewState) return;
      previewState.textContent = "反映待ち…";
      previewState.dataset.state = "pending";
    },
    fresh() {
      if (!frame) return;
      // 開発サーバーは書き換えを読み込むのに1秒ほどかかる
      setTimeout(() => frame.contentWindow?.location.reload(), 1500);
      if (!previewState) return;
      previewState.textContent = "最新";
      previewState.dataset.state = "fresh";
      setTimeout(() => {
        if (previewState.dataset.state === "fresh") previewState.textContent = "";
      }, 4000);
    },
  };
  if (frame) {
    // 中の該当箇所まで、iframe の中だけを動かす。親の画面は動かさない
    frame.addEventListener("load", () => {
      const id = frame.dataset.hash;
      if (!id) return;
      const win = frame.contentWindow;
      const target = win?.document.getElementById(id);
      if (target) win.scrollTo(0, target.getBoundingClientRect().top + win.scrollY - 16);
    });
    document.getElementById("reload")?.addEventListener("click", () => {
      frame.contentWindow?.location.reload();
    });
  }

  const status = document.getElementById("status");
  const bar = document.querySelector(".bar");
  const say = (text, tone = "") => {
    status.textContent = text;
    status.dataset.tone = tone;
  };

  // ---- 保存する中身 ----
  /** この画面が受け持つ項目。開催回の1ファイルを複数の画面で分担しているので、
      自分の項目だけを送る（開いたときの古い値で、ほかの画面の変更を戻さないように） */
  const owned = fields.filter(
    (f) => f.type !== "sub" && f.type !== "body" && (f.type !== "hidden" || !entryId)
  );
  /** 開催日は、トップページが日付を、スケジュール画面が見出しを受け持つ。
      それぞれ自分の分だけを送り、サーバー側で日ごとに重ねる */
  const project = (f, v) => {
    if (f.type === "days" && Array.isArray(v))
      return v.map((d) => ({ id: d.id, label: d.label, note: d.note ?? "", time: d.time ?? "" }));
    if (f.type === "schedule" && Array.isArray(v))
      return v.map((d) => ({ id: d.id, parts: d.parts ?? [], extras: d.extras ?? [] }));
    return v;
  };

  const payload = () => ({
    collection,
    id: entryId,
    data: Object.fromEntries(owned.map((f) => [f.name, project(f, state[f.name])])),
    body: document.getElementById("body")?.value ?? "",
    // この画面の中で編集した別コレクション（協賛など）。並びは画面の順番のまま
    subs: Object.values(subState).flatMap((sub) =>
      sub.rows.map((row, i) => ({
        collection: sub.collection,
        id: row.id,
        data: { ...row.data, order: (i + 1) * 10 },
        body: row.body ?? "",
      }))
    ),
    deletes: Object.values(subState).flatMap((sub) =>
      sub.removed.map((id) => ({ collection: sub.collection, id }))
    ),
  });

  // ---- 保存していない変更 ----
  // 開いたとき（と保存したとき）の中身を覚えておき、今の中身と比べる
  let saved = "";
  const snapshot = () => (saved = JSON.stringify(payload()));
  const isDirty = () => JSON.stringify(payload()) !== saved;
  /** 自動では保存しない（保存するとすぐ公開サイトに出るため）。代わりに、
      保存していない変更があることを目立たせ、そのまま離れようとしたら止める */
  /** 保存の最中か。その間とアップロード中は、進み具合の文を上書きしない */
  let busy = false;
  const checkDirty = () => {
    const dirty = isDirty();
    bar.classList.toggle("is-dirty", dirty);
    if (busy || uploads.size) return;
    if (dirty) say("保存していない変更があります", "warn");
    else if (status.dataset.tone === "warn") say("");
  };
  /** 反映が終わったときの文。その間に書き足していたら「保存していない変更」を優先する */
  const sayLive = (done) => {
    preview.fresh();
    if (isDirty()) return say(`${done.replace(/。$/, "")}。ただし、保存していない変更があります`, "warn");
    say(done, "ok");
  };
  hooks.edited = checkDirty;
  // 描画待ち（requestAnimationFrame）にすると、タブが裏にある間は動かないのでタイマーにする
  let checking = 0;
  const queueCheck = () => {
    clearTimeout(checking);
    checking = setTimeout(checkDirty, 30);
  };
  for (const type of ["input", "change", "click", "drop", "keyup"]) {
    document.addEventListener(type, queueCheck);
  }

  window.addEventListener("beforeunload", (e) => {
    if (!isDirty()) return;
    e.preventDefault();
    e.returnValue = "";
  });
  // 管理画面の中のリンク（メニュー・一覧へ戻る）は、ブラウザの確認より分かりやすい文で止める
  document.addEventListener(
    "click",
    async (e) => {
      const a = e.target.closest?.("a[href]");
      if (!a || a.target === "_blank" || e.metaKey || e.ctrlKey || !isDirty()) return;
      if (a.closest(".preview")) return;
      e.preventDefault();
      const go = await window.adminConfirm(
        "保存していない変更があります。保存せずに移動しますか？",
        "保存せずに移動"
      );
      if (!go) return;
      saved = JSON.stringify(payload()); // beforeunload で二重に聞かないように
      location.href = a.href;
    },
    true
  );

  // ⌘S / Ctrl+S で保存
  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "s") {
      e.preventDefault();
      saveButton.click();
    }
  });

  // ---- 保存 ----
  const saveButton = document.getElementById("save");
  saveButton.addEventListener("click", async () => {
    // 待っている間に二度押しされて、二重に保存しないように
    saveButton.disabled = true;
    busy = true;
    try {
      await save();
    } finally {
      saveButton.disabled = false;
      busy = false;
      // 保存の最中に書き足していたら、ここで「保存していない変更があります」を出す
      if (isDirty()) checkDirty();
    }
  });

  const save = async () => {
    // 画像を送っている途中で保存すると、古い画像のまま保存されてしまう。届くまで待つ
    if (uploads.size) {
      say("画像のアップロードが終わるのを待っています…");
      await Promise.allSettled([...uploads]);
    }
    say("保存しています…");
    const sent = payload();
    // 送った時点の行と削除。保存の最中に足したり消したりしたものと区別するため
    const sentRows = Object.values(subState).flatMap((sub) => sub.rows.map((row) => ({ sub, row })));
    const sentRemoved = new Set(sent.deletes.map((d) => d.id));
    const res = await fetch("/api/admin/save", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(sent),
    }).catch(() => null);
    if (!res?.ok) {
      checkDirty();
      return say(`保存できませんでした：${res ? await res.text() : "通信できませんでした"}`, "error");
    }
    const { slug, subSlugs, commit } = await res.json();

    // 新しく作った行に、付いた名前を覚えさせる（次の保存で二重に作らないように）。
    // 送ったときの行そのものに付ける（その後に並びが変わっていても取り違えないように）
    sentRows.forEach(({ sub, row }, i) => {
      if (!row.id) row.id = subSlugs[i];
      sent.subs[i].id = row.id;
      // 保存の最中に画面から消した新しい行は、作られてしまったので次の保存で消す
      if (!sub.rows.includes(row) && !sub.removed.includes(row.id)) sub.removed.push(row.id);
    });
    // 送った削除だけを片づける。保存の最中に消したものは次の保存で送る
    for (const sub of Object.values(subState)) {
      sub.removed = sub.removed.filter((id) => !sentRemoved.has(id));
    }
    // 「保存済み」とみなすのは送った中身だけ。保存の最中に書き足した分は未保存のまま
    saved = JSON.stringify({ ...sent, deletes: [] });
    bar.classList.toggle("is-dirty", isDirty());

    if (!entryId) return location.replace(`/admin/${collection}/${slug}`);
    if (!commit) return say("保存しました（変更はありませんでした）", "ok");

    say("保存しました。サイトに反映しています…（1〜2分）", "ok");
    preview.pending();
    window.adminWaitLive(commit, {
      live: () => sayLive("保存しました。サイトに反映されました"),
      slow: () => {
        if (!isDirty()) say("保存はできています。サイトへの反映に時間がかかっています");
      },
    });
  };

  snapshot();

  document.getElementById("delete")?.addEventListener("click", async () => {
    if (!(await window.adminConfirm("この項目を削除します。元に戻せません。"))) return;
    const res = await fetch("/api/admin/delete", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ collection, id: entryId }),
    });
    if (!res.ok) return say(`削除できませんでした：${await res.text()}`, "error");
    location.replace(backTo);
  });
</script>
