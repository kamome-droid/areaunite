---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { collections, type Field } from "../../../lib/admin/schema";
import { readOne, readAll } from "../../../lib/admin/store";
import { groups } from "../../../config/site";

const key = Astro.params.collection!;
const id = Astro.params.entry!;
const def = collections[key];
if (!def) return Astro.redirect("/admin/");

const isNew = id === "new";
const entry = isNew ? null : await readOne(def, id);
if (!isNew && !entry) return Astro.redirect(`/admin/${key}/`);

/** 選択肢を実データから埋める。分類や開催日を手で打たせない */
const eventEntry = (await readAll(collections.top))[0];
const dayOptions = (
  Array.isArray(eventEntry?.data.schedule) ? eventEntry!.data.schedule : []
).map((d: any) => ({ value: String(d.id), label: `${d.label}（${d.note ?? ""}）` }));

const fields: Field[] = def.fields.map((f) => {
  if (f.type !== "select") return f;
  if (f.name === "group") {
    return {
      ...f,
      options: Object.entries(groups).map(([k, g]) => ({ value: k, label: g.jp })),
    };
  }
  if (f.name === "day") {
    return { ...f, options: [{ value: "", label: "（指定しない）" }, ...dayOptions] };
  }
  return f;
});

/** 日付は input[type=date] が読める形に直す */
const data: Record<string, any> = { ...(entry?.data ?? {}) };
if (data.date instanceof Date) data.date = data.date.toISOString().slice(0, 10);
if (data.tier != null) data.tier = String(data.tier);

const title = isNew
  ? `${def.labelOne}を追加`
  : String(data[def.titleField] || def.labelOne);
const groupOptions = Object.entries(groups).map(([k, g]) => ({ value: k, label: g.jp }));

/** 右に出すプレビューの行き先。新規作成中はまだページが無いので出さない */
const previewPath = !isNew && def.preview ? def.preview(id, data) : null;
---

<AdminLayout title={title} current={key} intro={def.intro} wide={!!previewPath}>
  <div class:list={["split", previewPath && "split--preview"]}>
    <div class="split__form">
      <form id="form" class="panel">
    <div id="fields"></div>

    {
      def.hasBody && (
        <div class="field">
          <label class="field__label" for="body">
            {def.bodyLabel ?? "本文"}
          </label>
          <textarea id="body" rows="10" set:html={entry?.body ?? ""} />
          <p class="field__help">
            空行で段落が分かれます。**文字**で太字になります。
          </p>
        </div>
      )
    }
      </form>

      <div class="bar">
        <button class="btn" id="save" type="button">保存する</button>
        <span id="status" class="bar__status"></span>
        {
          !def.singleton && !isNew && (
            <button class="btn btn--danger" id="delete" type="button">
              削除
            </button>
          )
        }
        {!def.singleton && <a class="btn btn--ghost" href={`/admin/${key}/`}>一覧へ戻る</a>}
      </div>
    </div>

    {
      previewPath && (
        <aside class="preview">
          <div class="preview__bar">
            <span>プレビュー</span>
            <button type="button" id="reload" class="preview__btn">
              更新
            </button>
            <a href={previewPath} target="_blank" rel="noopener" class="preview__btn">
              別タブで開く ↗
            </a>
          </div>
          <iframe id="preview" src={previewPath} title="プレビュー" />
          <p class="preview__note">保存すると自動で更新されます</p>
        </aside>
      )
    }
  </div>
</AdminLayout>

<script
  define:vars={{
    collection: key,
    entryId: isNew ? null : id,
    fields,
    data,
    groupOptions,
    dayOptions,
  }}
>
  const root = document.getElementById("fields");
  const state = structuredClone(data);

  const el = (tag, attrs = {}, ...kids) => {
    const n = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) {
      if (k === "class") n.className = v;
      else if (k.startsWith("on")) n.addEventListener(k.slice(2), v);
      else if (v != null && v !== false) n.setAttribute(k, v === true ? "" : v);
    }
    kids.flat().forEach((c) => n.append(c?.nodeType ? c : document.createTextNode(c ?? "")));
    return n;
  };

  /** 画像を選んでアップロードし、パスを返す */
  const pickImage = async (onDone) => {
    const input = el("input", { type: "file", accept: "image/*" });
    input.addEventListener("change", async () => {
      const file = input.files?.[0];
      if (!file) return;
      const fd = new FormData();
      fd.append("collection", collection);
      fd.append("file", file);
      const res = await fetch("/api/admin/upload", { method: "POST", body: fd });
      if (!res.ok) return alert("アップロードに失敗しました");
      const { url } = await res.json();
      onDone(url);
    });
    input.click();
  };

  const imageBox = (value, onChange) => {
    const preview = el("div", { class: "img" });
    const path = el("input", {
      type: "text",
      value: value ?? "",
      placeholder: "/images/...",
      oninput: (e) => {
        onChange(e.target.value);
        draw();
      },
    });
    const draw = () => {
      preview.replaceChildren();
      const v = path.value.trim();
      if (v) preview.append(el("img", { src: v, alt: "" }));
    };
    draw();
    return el(
      "div",
      { class: "imgfield" },
      preview,
      el(
        "div",
        { class: "imgfield__ctrl" },
        path,
        el("button", {
          type: "button",
          class: "btn btn--ghost",
          onclick: () =>
            pickImage((url) => {
              path.value = url;
              onChange(url);
              draw();
            }),
        }, "画像を選ぶ"),
        el("button", {
          type: "button",
          class: "btn btn--ghost",
          onclick: () => {
            path.value = "";
            onChange("");
            draw();
          },
        }, "外す")
      )
    );
  };

  /** 並べ替え・追加・削除ができる箱。
      adders は [ラベル, 作る関数] の並び。1種類だけなら1つ渡す */
  const repeater = (list, renderRow, adders) => {
    const box = el("div", { class: "rep" });
    const draw = () => {
      box.replaceChildren();
      list.forEach((row, i) => {
        const move = (to) => {
          if (to < 0 || to >= list.length) return;
          [list[i], list[to]] = [list[to], list[i]];
          draw();
        };
        box.append(
          el(
            "div",
            { class: "rep__row" },
            el("div", { class: "rep__body" }, renderRow(row, i, draw)),
            el(
              "div",
              { class: "rep__tools" },
              el("button", { type: "button", title: "上へ", onclick: () => move(i - 1) }, "↑"),
              el("button", { type: "button", title: "下へ", onclick: () => move(i + 1) }, "↓"),
              el("button", {
                type: "button",
                title: "削除",
                onclick: () => {
                  if (!confirm("この行を削除しますか？")) return;
                  list.splice(i, 1);
                  draw();
                },
              }, "✕")
            )
          )
        );
      });
      box.append(
        el(
          "div",
          { class: "rep__adds" },
          adders.map(([label, make]) =>
            el("button", {
              type: "button",
              class: "btn btn--ghost",
              onclick: () => {
                list.push(make());
                draw();
              },
            }, label)
          )
        )
      );
    };
    draw();
    return box;
  };

  const labelFor = (f) =>
    el("label", { class: "field__label", for: `f-${f.name}` }, f.label);

  const helpFor = (f) => (f.help ? el("p", { class: "field__help" }, f.help) : "");

  /** 1つの項目を描く */
  const renderField = (f, target, get, set) => {
    if (f.type === "hidden") return;

    const wrap = el("div", { class: "field" });
    const value = get(f.name);

    if (f.type === "boolean") {
      wrap.append(
        el(
          "label",
          { class: "check" },
          el("input", {
            type: "checkbox",
            checked: !!value,
            onchange: (e) => set(f.name, e.target.checked),
          }),
          f.label
        ),
        helpFor(f)
      );
    } else if (f.type === "select") {
      const sel = el("select", {
        id: `f-${f.name}`,
        onchange: (e) => set(f.name, e.target.value),
      });
      f.options.forEach((o) =>
        sel.append(el("option", { value: o.value, selected: String(value ?? "") === o.value }, o.label))
      );
      wrap.append(labelFor(f), sel, helpFor(f));
    } else if (f.type === "textarea" || f.type === "markdown") {
      wrap.append(
        labelFor(f),
        el("textarea", {
          id: `f-${f.name}`,
          rows: 4,
          oninput: (e) => set(f.name, e.target.value),
        }, value ?? ""),
        helpFor(f)
      );
    } else if (f.type === "lines") {
      wrap.append(
        labelFor(f),
        el("textarea", {
          id: `f-${f.name}`,
          rows: 5,
          placeholder: f.placeholder,
          oninput: (e) =>
            set(
              f.name,
              e.target.value.split("\n").map((s) => s.trim()).filter(Boolean)
            ),
        }, (Array.isArray(value) ? value : []).join("\n")),
        helpFor(f)
      );
    } else if (f.type === "image") {
      wrap.append(labelFor(f), imageBox(value, (v) => set(f.name, v)), helpFor(f));
    } else if (f.type === "images") {
      const list = Array.isArray(value) ? [...value] : [];
      set(f.name, list);
      wrap.append(
        labelFor(f),
        repeater(
          list,
          (row, i) => imageBox(row, (v) => (list[i] = v)),
          [["＋ 画像を追加", () => ""]]
        ),
        helpFor(f)
      );
    } else if (f.type === "rows") {
      const list = Array.isArray(value) ? value.map((r) => ({ ...r })) : [];
      set(f.name, list);
      wrap.append(
        labelFor(f),
        repeater(
          list,
          (row) =>
            el(
              "div",
              { class: "cols", style: `grid-template-columns:${f.columns.map((c) => c.width ?? "1fr").join(" ")}` },
              f.columns.map((c) =>
                el("input", {
                  type: "text",
                  value: row[c.name] ?? "",
                  placeholder: c.label,
                  oninput: (e) => (row[c.name] = e.target.value),
                })
              )
            ),
          [["＋ 行を追加", () => Object.fromEntries(f.columns.map((c) => [c.name, ""]))]]
        ),
        helpFor(f)
      );
    } else if (f.type === "group") {
      const obj = value && typeof value === "object" ? { ...value } : {};
      set(f.name, obj);
      const inner = el("div", { class: "group" });
      f.fields.forEach((sub) =>
        renderField(sub, inner, (n) => obj[n], (n, v) => (obj[n] = v))
      );
      wrap.append(labelFor(f), inner, helpFor(f));
    } else if (f.type === "schedule") {
      // 開催日の追加・削除はしない。中身だけ編集する
      const days = Array.isArray(value) ? structuredClone(value) : [];
      set(f.name, days);
      wrap.append(scheduleEditor(days), helpFor(f));
    } else {
      wrap.append(
        labelFor(f),
        el("input", {
          id: `f-${f.name}`,
          type: f.type === "datetime" ? "date" : f.type === "number" ? "number" : "text",
          value: value ?? "",
          placeholder: f.placeholder,
          oninput: (e) => set(f.name, e.target.value),
        }),
        helpFor(f)
      );
    }

    target.append(wrap);
  };

  /* ---- スケジュール ----
     「部」の入れ子をそのまま出すと深くなって読みにくいので、
     1日ぶんを1本のリストに開いて見せる。行の種類は3つ。
       見出し … 第1部 ／ トーク & ライブ など
       項目   … 時刻・内容・補足を直接書く
       差し込み … コンテンツで登録した分類を丸ごと入れる
     保存するときに、元の「部」の形へ組み直す。 */

  const flatten = (program) => {
    const rows = [];
    (program ?? []).forEach((block) => {
      if (block.part) rows.push({ kind: "heading", text: block.part });
      const inc = Array.isArray(block.include)
        ? block.include
        : block.include
          ? [block.include]
          : [];
      inc.forEach((group) => rows.push({ kind: "include", group }));
      (block.items ?? []).forEach((it) =>
        rows.push({ kind: "item", time: it.time ?? "", title: it.title ?? "", note: it.note ?? "" })
      );
    });
    return rows;
  };

  const unflatten = (rows) => {
    const program = [];
    let block = null;
    const ensure = () => {
      if (!block) {
        block = { items: [] };
        program.push(block);
      }
      return block;
    };
    rows.forEach((row) => {
      if (row.kind === "heading") {
        block = { part: row.text ?? "", items: [] };
        program.push(block);
      } else if (row.kind === "include") {
        const b = ensure();
        const inc = Array.isArray(b.include) ? b.include : b.include ? [b.include] : [];
        if (row.group) inc.push(row.group);
        b.include = inc.length ? inc : undefined;
      } else {
        ensure().items.push({ time: row.time ?? "", title: row.title ?? "", note: row.note ?? "" });
      }
    });
    return program;
  };

  const KINDS = [
    { value: "item", label: "項目" },
    { value: "heading", label: "見出し" },
    { value: "include", label: "差し込み" },
  ];

  const scheduleEditor = (days) => {
    const box = el("div", { class: "sched" });

    days.forEach((day) => {
      const rows = flatten(day.program);
      const sync = () => (day.program = unflatten(rows));
      sync();

      const line = (label, name, placeholder) =>
        el(
          "label",
          { class: "day__line" },
          el("span", {}, label),
          el("input", {
            type: "text",
            value: day[name] ?? "",
            placeholder,
            oninput: (e) => (day[name] = e.target.value),
          })
        );

      box.append(
        el(
          "section",
          { class: "day" },
          el("h3", { class: "day__title" }, day.label || day.id),
          el("div", { class: "day__head" }, line("日付", "note", "2026.10.17 sat."), line("時間帯", "time", "12:00〜LATE")),
          repeater(
            rows,
            (row) => {
              const kind = el("select", { class: "srow__kind" });
              KINDS.forEach((k) =>
                kind.append(el("option", { value: k.value, selected: row.kind === k.value }, k.label))
              );

              const body = el("div", { class: "srow__body" });

              const drawBody = () => {
                body.replaceChildren();
                if (row.kind === "heading") {
                  body.append(
                    el("input", {
                      type: "text",
                      class: "srow__wide",
                      value: row.text ?? "",
                      placeholder: "第1部 ／ トーク & ライブ",
                      oninput: (e) => {
                        row.text = e.target.value;
                        sync();
                      },
                    })
                  );
                } else if (row.kind === "include") {
                  const sel = el("select", {
                    class: "srow__wide",
                    onchange: (e) => {
                      row.group = e.target.value;
                      sync();
                    },
                  });
                  groupOptions.forEach((o) =>
                    sel.append(el("option", { value: o.value, selected: row.group === o.value }, `${o.label} をここに差し込む`))
                  );
                  if (!row.group) {
                    row.group = groupOptions[0]?.value;
                    sync();
                  }
                  body.append(sel);
                } else {
                  const field = (name, placeholder, cls) =>
                    el("input", {
                      type: "text",
                      class: cls,
                      value: row[name] ?? "",
                      placeholder,
                      oninput: (e) => {
                        row[name] = e.target.value;
                        sync();
                      },
                    });
                  body.append(
                    field("time", "12:00", "srow__time"),
                    field("title", "内容", "srow__title"),
                    field("note", "補足（任意）", "srow__note")
                  );
                }
              };

              kind.addEventListener("change", (e) => {
                row.kind = e.target.value;
                drawBody();
                sync();
              });
              drawBody();

              return el("div", { class: `srow srow--${row.kind}` }, kind, body);
            },
            [
              ["＋ 項目", () => ({ kind: "item", time: "", title: "", note: "" })],
              ["＋ 見出し", () => ({ kind: "heading", text: "" })],
              ["＋ 差し込み", () => ({ kind: "include", group: groupOptions[0]?.value })],
            ]
          )
        )
      );
    });

    return box;
  };

  fields.forEach((f) =>
    renderField(f, root, (n) => state[n], (n, v) => (state[n] = v))
  );

  // ---- 保存 ----
  /** プレビューを読み直す。開発サーバーが作り直すのを少し待つ */
  const frame = document.getElementById("preview");
  const reloadPreview = () => {
    if (!frame) return;
    setTimeout(() => {
      frame.src = frame.src.split("#")[0] + (frame.dataset.hash ?? "");
    }, 700);
  };
  if (frame) {
    frame.dataset.hash = new URL(frame.src, location.href).hash;
    document.getElementById("reload")?.addEventListener("click", () => {
      frame.contentWindow?.location.reload();
    });
  }

  const status = document.getElementById("status");
  const say = (text, tone = "") => {
    status.textContent = text;
    status.dataset.tone = tone;
  };

  document.getElementById("save").addEventListener("click", async () => {
    say("保存しています…");
    const body = document.getElementById("body")?.value ?? "";
    const res = await fetch("/api/admin/save", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ collection, id: entryId, data: state, body }),
    });
    if (!res.ok) return say(`保存できませんでした：${await res.text()}`, "error");
    const { slug } = await res.json();
    if (!entryId) return location.replace(`/admin/${collection}/${slug}`);
    say("保存しました", "ok");
    reloadPreview();
  });

  document.getElementById("delete")?.addEventListener("click", async () => {
    if (!confirm("この項目を削除します。元に戻せません。")) return;
    const res = await fetch("/api/admin/delete", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ collection, id: entryId }),
    });
    if (!res.ok) return say(`削除できませんでした：${await res.text()}`, "error");
    location.replace(`/admin/${collection}/`);
  });
</script>

<style is:global>
  /* 編集と結果を並べて見せる。何を触ると何が変わるかが分かる */
  .split--preview {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 480px);
    gap: 20px;
    align-items: start;
  }

  .preview {
    position: sticky;
    top: 20px;
    background: var(--a-panel);
    border: 1px solid var(--a-line);
    border-radius: var(--a-radius);
    overflow: hidden;
  }

  .preview__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--a-line);
    font-size: 12px;
    color: var(--a-muted);
  }

  .preview__btn {
    padding: 0;
    border: 0;
    background: none;
    color: var(--a-muted);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .preview__btn:hover {
    color: var(--a-ink);
  }

  .preview__bar a {
    margin-left: auto;
  }

  .preview iframe {
    display: block;
    width: 100%;
    height: min(72vh, 760px);
    border: 0;
    background: #0a0a0c;
  }

  .preview__note {
    margin: 0;
    padding: 8px 12px;
    border-top: 1px solid var(--a-line);
    font-size: 11.5px;
    color: var(--a-muted);
  }

  @media (max-width: 1080px) {
    .split--preview {
      grid-template-columns: 1fr;
    }

    .preview {
      position: static;
    }
  }

  .field + .field {
    margin-top: 20px;
  }

  .field__label {
    display: block;
    margin-bottom: 6px;
    font-size: 13px;
    font-weight: 700;
  }

  .field__help {
    margin: 6px 0 0;
    color: var(--a-muted);
    font-size: 12.5px;
  }

  .field input[type="text"],
  .field input[type="date"],
  .field input[type="number"],
  .field select,
  .field textarea,
  .cols input,
  .imgfield input,
  .day__line input {
    width: 100%;
    padding: 9px 11px;
    border: 1px solid var(--a-line);
    border-radius: 6px;
    background: #fff;
    color: inherit;
    font: inherit;
    font-size: 14px;
  }

  .field textarea {
    resize: vertical;
    line-height: 1.7;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }

  .check input {
    width: 16px;
    height: 16px;
  }

  /* ---- 画像 ---- */
  .imgfield {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }

  .img {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    background: #efeff1;
    border: 1px solid var(--a-line);
    border-radius: 6px;
    overflow: hidden;
  }

  .img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .imgfield__ctrl {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .imgfield__ctrl input {
    flex: 1 1 100%;
  }

  /* ---- 繰り返し ---- */
  .rep__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    align-items: start;
    padding: 10px 0;
    border-top: 1px solid var(--a-line);
  }

  .rep__tools {
    display: flex;
    gap: 4px;
  }

  .rep__tools button {
    width: 30px;
    height: 30px;
    border: 1px solid var(--a-line);
    border-radius: 6px;
    background: #fff;
    color: var(--a-muted);
    cursor: pointer;
  }

  .rep__tools button:hover {
    border-color: var(--a-ink);
    color: var(--a-ink);
  }

  .rep__add {
    margin-top: 10px;
  }

  .cols {
    display: grid;
    gap: 8px;
  }

  /* ---- スケジュール ---- */
  .day + .day {
    margin-top: 24px;
  }

