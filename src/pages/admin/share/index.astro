---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { ogSets } from "../../../lib/og/templates";

/**
 * SNS画像の入口。まとまりごとにカードを並べる。
 * 1枚ずつ落とすのは、それぞれのページで。
 */
const sets = await ogSets();
const total = sets.reduce((n, s) => n + s.sheets.length, 0);
---

<AdminLayout title="SNS画像ダウンロード" current="share">
  <div class="tools">
    <a class="btn" href="/api/og/zip?set=all" download>すべてまとめて保存</a>
    <span class="note">全{total}枚／Instagram用（1080×1350）。内容を直せば画像も変わります</span>
  </div>

  <div class="sets">
    {
      sets.map((s) => (
        <div class="set">
          <a class="set__open" href={`/admin/share/${s.key}/`}>
            <img
              src={`${s.sheets[0]?.src}${s.sheets[0]?.src.includes("?") ? "&" : "?"}w=360`}
              alt=""
              loading="lazy"
              width="1080"
              height="1350"
            />
          </a>
          <div class="set__foot">
            <a class="set__text" href={`/admin/share/${s.key}/`}>
              <span class="set__label">{s.label}</span>
              <span class="set__note">
                {s.note}
                {s.sheets.length > 1 && `／${s.sheets.length}枚`}
              </span>
            </a>
            <a class="btn btn--small" href={`/api/og/zip?set=${s.key}`} download>
              保存
            </a>
          </div>
        </div>
      ))
    }
  </div>
</AdminLayout>

<style>
  .tools {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 22px;
  }

  .note {
    font-size: 12px;
    color: var(--a-muted);
  }

  .sets {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr));
    gap: 18px;
  }

  .set {
    display: flex;
    flex-direction: column;
    background: var(--a-panel);
    border: 1px solid var(--a-line);
    border-radius: var(--a-radius);
    overflow: hidden;
  }

  .set:hover {
    border-color: var(--a-ink);
  }

  .set img {
    display: block;
    width: 100%;
    height: auto;
    background: #111;
  }

  .set__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 14px;
    border-top: 1px solid var(--a-line);
  }

  .set__text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .set__label,
  .set__note {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .set__label {
    font-size: 14px;
    font-weight: 700;
  }

  .set__note {
    font-size: 12px;
    color: var(--a-muted);
  }
</style>
