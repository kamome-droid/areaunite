---
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import { collections, menu, tools } from "../../lib/admin/schema";
import { readAll } from "../../lib/admin/store";
import { pageOfScreen } from "../../lib/visibility";

/** 各画面の件数を出して、いまサイトに何が載っているか一目で分かるようにする */
const items = await readAll(collections.items);
const event = (await readAll(collections.top))[0];

const rows = items.filter((i) => collections.items.filter?.(i.data) ?? true);
const published = rows.filter((i) => !i.data.draft).length;
const drafts = rows.length - published;
const days = Array.isArray(event?.data.schedule) ? event!.data.schedule.length : 0;
const stays = items.filter((i) => collections.stay.filter?.(i.data)).length;
const tickets = Array.isArray(event?.data.tickets) ? event!.data.tickets.length : 0;
const hidden: string[] = event?.data.hiddenPages ?? [];

/** カードに添える一言。その画面に今なにが入っているか */
const notes: Record<string, string> = {
  top: event?.data.edition ?? "",
  about: event?.data.aboutLead ? "紹介文あり" : "紹介文が空です",
  schedule: `${days}日ぶん`,
  items: `${published}件を公開中${drafts ? `／下書き ${drafts}件` : ""}`,
  ticket: tickets ? `${tickets}区分` : "料金が空です",
  access: `宿泊 ${stays}件`,
};
---

<AdminLayout title="編集する場所">
  <div class="cards">
    {
      menu.map((key) => {
        const def = collections[key];
        const note = notes[key] ?? "";
        const page = pageOfScreen[key];
        return (
          <a class="card" href={`/admin/${key}/`}>
            <span class="card__label">
              {def.label}
              {page && hidden.includes(page) && <span class="side__chip">非公開</span>}
            </span>
            {note && <span class="card__note">{note}</span>}
            <span class="card__arrow" aria-hidden="true">
              →
            </span>
          </a>
        );
      })
    }
    {
      tools.map((t) => (
        <a class="card" href={t.href}>
          <span class="card__label">{t.label}</span>
          <span class="card__note">Instagram用（1080×1350）を作る</span>
          <span class="card__arrow" aria-hidden="true">
            →
          </span>
        </a>
      ))
    }
  </div>
</AdminLayout>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr));
    gap: 12px;
  }

  .card {
    position: relative;
    display: block;
    padding: 20px 44px 20px 20px;
    background: var(--a-panel);
    border: 1px solid var(--a-line);
    border-radius: var(--a-radius);
    text-decoration: none;
  }

  .card:hover {
    border-color: var(--a-ink);
  }

  .card__label {
    display: block;
    font-size: 17px;
    font-weight: 700;
  }

  .card__note {
    display: block;
    margin-top: 4px;
    color: var(--a-muted);
    font-size: 13px;
  }

  .card__arrow {
    position: absolute;
    right: 18px;
    top: 50%;
    translate: 0 -50%;
    color: var(--a-muted);
  }

</style>
