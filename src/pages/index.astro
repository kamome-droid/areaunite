---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import GroupNav from "../components/GroupNav.astro";
import ItemLayout from "../components/ItemLayout.astro";
import Row from "../components/Row.astro";
import Timetable from "../components/Timetable.astro";
import PriceTable from "../components/PriceTable.astro";
import NameList from "../components/NameList.astro";
import SponsorGrid from "../components/SponsorGrid.astro";
import { site, parents, groups, groupsOf } from "../config/site";
import { getCurrentEvent, getFeaturedItems, getSponsors } from "../lib/content";

const event = await getCurrentEvent();
const ev = event?.data;
const About = event ? (await render(event)).Content : null;

const movies = await getFeaturedItems("movies", 6);
const movieBodies = await Promise.all(movies.map((m) => render(m)));
const sponsors = await getSponsors();

const contentsNav = groupsOf("contents").map(([key, g]) => ({
  href: `${parents.contents.href}#${key}`,
  label: g.label,
  jp: g.jp,
}));
---

<BaseLayout description={site.description}>
  <Hero
    image={ev?.hero}
    style={ev?.heroStyle}
    eyebrow={site.tagline}
    title={ev?.edition ?? site.name}
    catch={ev?.catch}
    date={ev?.dateLabel}
    venue={ev?.venue}
    ctaLabel="チケット"
    ctaHref="/ticket/"
    subCtaLabel="上映作品"
    subCtaHref={`${parents.contents.href}#movies`}
  />

  {
    ev?.afterMessage && (
      <p class="thanks">
        <span class="wrap">{ev.afterMessage}</span>
      </p>
    )
  }

  {
    About && (
      <Section id="about" label="About" jp={site.name} narrow>
        <div class="prose about">
          <About />
        </div>
      </Section>
    )
  }

  {
    ev && (ev.schedule.length > 0 || ev.dateLabel) && (
      <Section
        id="schedule"
        label="Schedule"
        jp="タイムテーブル"
        surface
        moreHref="/schedule/"
        moreLabel="タイムテーブルを見る"
      >
        <div class="sched">
          <dl class="sched__meta">
            <div>
              <dt class="en">Date</dt>
              <dd class="num">{ev.dateLabel}</dd>
            </div>
            {ev.venue && (
              <div>
                <dt class="en">Venue</dt>
                <dd>{ev.venue}</dd>
              </div>
            )}
          </dl>

          <div class="sched__parts">
            {ev.schedule.map((part) => (
              <div class="part">
                <p class="en part__label">
                  {part.label}
                  {part.note && <span class="part__note">{part.note}</span>}
                </p>
                {part.items.length > 0 ? (
                  <Timetable items={part.items} />
                ) : (
                  <p class="part__empty muted">準備中です。</p>
                )}
              </div>
            ))}
          </div>
        </div>
      </Section>
    )
  }

  <Section
    id="contents"
    label={parents.contents.label}
    jp={parents.contents.jp}
    lead="当日の内容をまとめています。"
    moreHref={parents.contents.href}
    moreLabel="すべて見る"
  >
    <GroupNav items={contentsNav} />
  </Section>

  {
    movies.length > 0 && (
      <Section
        id="movies"
        label={groups.movies.label}
        jp={groups.movies.jp}
        moreHref={`${parents.contents.href}#movies`}
        moreLabel="上映作品をすべて見る"
      >
        <ItemLayout layout="list">
          {movies.map((m, i) => {
            const Body = movieBodies[i].Content;
            return (
              <Row
                title={m.data.title}
                subtitle={m.data.subtitle}
                time={m.data.time}
                image={m.data.image}
                link={m.data.link}
                linkLabel={m.data.linkLabel}
              >
                <Body />
              </Row>
            );
          })}
        </ItemLayout>
      </Section>
    )
  }

  {
    ev && ev.guests.length > 0 && (
      <Section id="guests" label="Guests" jp={ev.guestsLabel}>
        <NameList names={ev.guests} />
      </Section>
    )
  }

  {
    ev && ev.tickets.length > 0 && (
      <Section
        id="ticket"
        label="Ticket"
        jp="チケット"
        surface
        moreHref="/ticket/"
        moreLabel="注意事項を見る"
        narrow
      >
        <PriceTable rows={ev.tickets} />
        {ev.ticketUrl && (
          <p class="ticket__cta">
            <a class="btn" href={ev.ticketUrl} target="_blank" rel="noopener noreferrer">
              {ev.ticketUrlLabel ?? "チケットを購入する"}
            </a>
          </p>
        )}
      </Section>
    )
  }

  {
    ev && (ev.venue || ev.address) && (
      <Section id="access" label="Access" jp="会場・アクセス" moreHref="/access/" moreLabel="詳しく見る" narrow>
        <dl class="info">
          {ev.venue && (
            <div>
              <dt class="en">Venue</dt>
              <dd>{ev.venue}</dd>
            </div>
          )}
          {ev.address && (
            <div>
              <dt class="en">Address</dt>
              <dd>
                {ev.address}
                {ev.mapUrl && (
                  <a class="info__map en" href={ev.mapUrl} target="_blank" rel="noopener noreferrer">
                    Google Map<span aria-hidden="true"> ↗</span>
                  </a>
                )}
              </dd>
            </div>
          )}
        </dl>
      </Section>
    )
  }

  {
    (sponsors.length > 0 || (ev && ev.supporters.length > 0)) && (
      <Section id="sponsors" label="Sponsors" jp="協賛・後援" surface>
        {sponsors.length > 0 && <SponsorGrid sponsors={sponsors.map((s) => s.data)} />}
        {ev && ev.supporters.length > 0 && (
          <div class="supporters">
            <p class="en supporters__label">{ev.supportersLabel}</p>
            <p class="supporters__list muted">{ev.supporters.join("　/　")}</p>
          </div>
        )}
      </Section>
    )
  }

  <Section id="contact" label="Contact" jp="お問い合わせ" narrow>
    <p class="muted">
      出店・協賛・取材などのご相談は、フォームまたは Instagram のDMからご連絡ください。
    </p>
    <p class="contact__cta">
      <a class="btn" href="/contact/">お問い合わせフォーム</a>
      {
        site.sns.instagram && (
          <a class="btn btn--ghost" href={site.sns.instagram} target="_blank" rel="noopener noreferrer">
            Instagram
          </a>
        )
      }
    </p>
  </Section>
</BaseLayout>

<style>
  .thanks {
    background: color-mix(in srgb, var(--brand) 12%, var(--bg));
    border-block: 1px solid color-mix(in srgb, var(--brand) 45%, transparent);
    color: var(--brand);
    font-weight: 500;
    text-align: center;
    padding-block: 14px;
    letter-spacing: 0.04em;
  }

  .about {
    font-size: clamp(1rem, 1.8vw, 1.08rem);
  }

  .sched {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }

  .sched__meta > div + div {
    margin-top: 24px;
  }

  .sched__meta dt,
  .info dt {
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    color: var(--text-muted);
    line-height: 1;
  }

  .sched__meta dd {
    margin: 10px 0 0;
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.3;
  }

  .info > div + div {
    margin-top: 22px;
  }

  .info dd {
    margin: 8px 0 0;
    font-size: 1.05rem;
  }

  .info__map {
    display: inline-block;
    margin-left: 14px;
    color: var(--brand);
    font-size: 0.9rem;
  }

  .ticket__cta,
  .contact__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .supporters {
    margin-top: clamp(36px, 5vw, 56px);
    padding-top: 26px;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .supporters__label {
    font-size: 0.95rem;
    letter-spacing: 0.2em;
    color: var(--brand);
  }

  .supporters__list {
    margin-top: 10px;
    font-size: 0.92rem;
  }

  .sched__parts > .part + .part {
    margin-top: clamp(30px, 4vw, 44px);
  }

  .part__label {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 12px;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }

  .part__note {
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    color: var(--brand);
  }

  .part__empty {
    padding-block: 14px;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }

  @media (max-width: 760px) {
    .sched {
      grid-template-columns: 1fr;
    }
  }
</style>
