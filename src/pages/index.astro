---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import GroupNav from "../components/GroupNav.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import PhotoStrip from "../components/PhotoStrip.astro";
import DateText from "../components/DateText.astro";
import CardGrid from "../components/CardGrid.astro";
import NameList from "../components/NameList.astro";
import SponsorGrid from "../components/SponsorGrid.astro";
import { site, parents, groups, groupsOf } from "../config/site";
import { showsComingSoon } from "../lib/visibility";
import { getSiteInfo } from "../lib/content";
import { dateRangeLabel, getCurrentEvent, getDayRange, getFeaturedItems, getSponsors, getEventDays, displayDate } from "../lib/content";

const event = await getCurrentEvent();
const info = await getSiteInfo();
const ev = event?.data;
/** 準備中のページ。トップからはその中身も出さず、リンクも張らない */
const soon = {
  about: showsComingSoon(ev, "about", Astro),
  schedule: showsComingSoon(ev, "schedule", Astro),
  contents: showsComingSoon(ev, "contents", Astro),
};
/** 開催日から組み立てた「2026.10.17 sat. - 10.18 sun.」 */
const dateLabel = dateRangeLabel(ev?.schedule);
/** 日付と「何時から何時まで」。時間帯はスケジュールから組み立てる */
const days = ev
  ? await Promise.all(
      ev.schedule.map(async (day) => ({
        date: day.note || day.label,
        // 時間帯はスケジュールから組み立てるので、スケジュールが準備中なら出さない
        range: soon.schedule ? "" : await getDayRange(day),
      }))
    )
  : [];

const eventDays = await getEventDays();
const movieRows = (await getFeaturedItems("movies", 4)).map((entry) => ({
  entry,
  date: displayDate(entry.data, eventDays),
}));
const sponsors = await getSponsors();

const contentsNav = groupsOf("contents").map(([key, g]) => ({
  href: `${parents.contents.href}#${key}`,
  label: g.label,
  jp: g.jp,
}));
---

<BaseLayout>
  <Hero
    image={ev?.hero}
    style={ev?.heroStyle}
    eyebrow={info.tagline}
    title={ev?.edition ?? site.name}
    catch={ev?.catch}
    date={dateLabel}
    venue={ev?.venue}
    cta={ev?.heroCta}
  />

  {
    ev && ((!soon.about && ev.aboutLead) || ev.photos.length > 0) && (
      <Section
        id="about"
        label="About"
        jp="イベントについて"
        narrow
        surface
        moreHref={soon.about ? undefined : "/about/"}
        moreLabel="もっと見る"
      >
        {!soon.about && ev.aboutLead && <p class="about">{ev.aboutLead}</p>}
        <Fragment slot="after">
          {!soon.about && ev.prVideo && (
            <div class="about__video">
              <VideoEmbed url={ev.prVideo} title={`${site.name} PR movie`} />
            </div>
          )}
          {ev.photos.length > 0 && (
            <div class="about__photos">
              <PhotoStrip photos={ev.photos} label={`${site.name} の写真`} />
            </div>
          )}
        </Fragment>
      </Section>
    )
  }

  {
    ev && (
      <Section
        id="schedule"
        label="Schedule"
        jp="スケジュール"
        moreHref={soon.schedule ? undefined : "/schedule/"}
        moreLabel="詳細を見る"
      >
        <div class="sched">
          <div class="sched__row">
            {
                days.length > 0 ? (
                  /* 日付と時刻を2列に組んで、日ごとの行を縦に揃える */
                  <div class="days">
                    {days.map((d) => (
                      <>
                        <DateText class="num days__date" value={d.date} />
                        {d.range ? (
                          <span class="num days__time">{d.range}</span>
                        ) : (
                          <span class="days__pending muted">準備中</span>
                        )}
                      </>
                    ))}
                  </div>
                ) : (
                  <DateText class="num days__date" value={dateLabel} />
                )
            }
          </div>
        </div>
      </Section>
    )
  }

  {
    !soon.contents && (
      <Section
        id="contents"
        label={parents.contents.label}
        jp={parents.contents.jp}
        surface
        moreHref={parents.contents.href}
        moreLabel="すべて見る"
      >
        <GroupNav items={contentsNav} />
      </Section>
    )
  }

  {
    !soon.contents && movieRows.length > 0 && (
      <Section
        id="movies"
        label="Pick Up Movie"
        jp="注目ムービー"
        moreHref={`${parents.contents.href}#movies`}
        moreLabel="もっと見る"
      >
        <CardGrid group="movies" def={groups.movies} rows={movieRows} />
      </Section>
    )
  }

  {
    ev && ev.guests.length > 0 && (
      <Section id="guests" label="Guests" jp="来場ライダー" surface>
        <NameList names={ev.guests} />
      </Section>
    )
  }

  {
    (sponsors.length > 0 || ev?.sponsorsHidden || (ev && ev.supporters.length > 0)) && (
      <Section id="sponsors" label="Sponsors" jp="協賛・後援">
        {/* ロゴがまだ出せないあいだは、枠だけ見せて COMING SOON と出す */}
        {ev?.sponsorsHidden ? (
          <p class="en sponsors__soon">Coming Soon</p>
        ) : (
          sponsors.length > 0 && <SponsorGrid sponsors={sponsors.map((s) => s.data)} />
        )}
        {ev && ev.supporters.length > 0 && (
          <div class="supporters">
            <p class="en supporters__label">後援</p>
            <p class="supporters__list muted">{ev.supporters.join("　/　")}</p>
          </div>
        )}
      </Section>
    )
  }

</BaseLayout>

<style>

  .about {
    font-size: clamp(1rem, 1.8vw, 1.08rem);
  }

  .about__video {
    margin-top: clamp(28px, 4vw, 40px);
  }

  .about__photos {
    margin-top: clamp(16px, 2.5vw, 24px);
  }

  /* SCHEDULE：日付・会場・各日の時間帯だけを並べる要約。
     上の罫線は見出しが持っているので、ここでは引かない */
  .sched__row {
    padding-block: 18px;
    border-bottom: 1px solid var(--border);
    font-size: clamp(1.2rem, 2.8vw, 1.6rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.35;
  }

  .days {
    display: grid;
    grid-template-columns: max-content max-content;
    align-items: baseline;
    gap: 10px 30px;
  }

  .days__time {
    color: var(--brand);
  }

  .days__pending {
    font-size: 0.9rem;
    font-weight: 400;
  }

  /* 狭い画面では1行に収まらないので、時刻を日付の下に落とす */
  @media (max-width: 480px) {
    .days {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .days__time,
    .days__pending {
      margin-bottom: 8px;
    }
  }

  .sponsors__soon {
    text-align: center;
    font-size: clamp(1.4rem, 4vw, 2rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--brand);
  }

  .supporters {
    margin-top: clamp(36px, 5vw, 56px);
    padding-top: 26px;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .supporters__label {
    font-size: 0.95rem;
    letter-spacing: 0.2em;
    color: var(--brand);
  }

  .supporters__list {
    margin-top: 10px;
    font-size: 0.92rem;
  }

  @media (max-width: 560px) {
    .days {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .days__time,
    .days__pending {
      margin-bottom: 8px;
    }
  }
</style>
