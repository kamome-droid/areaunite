---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import GroupNav from "../components/GroupNav.astro";
import DateText from "../components/DateText.astro";
import ItemLayout from "../components/ItemLayout.astro";
import Row from "../components/Row.astro";
import NameList from "../components/NameList.astro";
import SponsorGrid from "../components/SponsorGrid.astro";
import { site, parents, groupsOf } from "../config/site";
import { getCurrentEvent, getDayRange, getFeaturedItems, getSponsors } from "../lib/content";

const event = await getCurrentEvent();
const ev = event?.data;
/** トップは冒頭だけ見せる。本文まるごとは /about/ に置く */
const aboutLead = event
  ? event.body.split(/\n\s*\n/)[0].replace(/\*\*/g, "").trim()
  : "";

/** 日付と「何時から何時まで」。時間帯はスケジュールから組み立てる */
const days = ev
  ? await Promise.all(
      ev.schedule.map(async (day) => ({
        date: day.note || day.label,
        range: await getDayRange(day),
      }))
    )
  : [];

const movies = await getFeaturedItems("movies", 4);
const movieBodies = await Promise.all(movies.map((m) => render(m)));
const sponsors = await getSponsors();

const contentsNav = groupsOf("contents").map(([key, g]) => ({
  href: `${parents.contents.href}#${key}`,
  label: g.label,
  jp: g.jp,
}));
---

<BaseLayout description={site.description}>
  <Hero
    image={ev?.hero}
    style={ev?.heroStyle}
    eyebrow={site.tagline}
    title={ev?.edition ?? site.name}
    catch={ev?.catch}
    date={ev?.dateLabel}
    venue={ev?.venue}
  />

  {
    ev?.afterMessage && (
      <p class="thanks">
        <span class="wrap">{ev.afterMessage}</span>
      </p>
    )
  }

  {
    aboutLead && (
      <Section
        id="about"
        label="About"
        jp="イベントについて"
        narrow
        surface
        moreHref="/about/"
        moreLabel="もっと見る"
      >
        <p class="about">{aboutLead}</p>
      </Section>
    )
  }

  {
    ev && (
      <Section
        id="schedule"
        label="Schedule"
        jp="スケジュール"
        moreHref="/schedule/"
        moreLabel="詳細を見る"
      >
        <dl class="sched">
          <div class="sched__row">
            <dt class="en">Date</dt>
            <dd>
              {
                days.length > 0 ? (
                  /* 日付と時刻を2列に組んで、日ごとの行を縦に揃える */
                  <div class="days">
                    {days.map((d) => (
                      <>
                        <DateText class="num days__date" value={d.date} />
                        {d.range ? (
                          <span class="num days__time">{d.range}</span>
                        ) : (
                          <span class="days__pending muted">準備中</span>
                        )}
                      </>
                    ))}
                  </div>
                ) : (
                  <DateText class="num days__date" value={ev.dateLabel} />
                )
              }
            </dd>
          </div>
        </dl>
      </Section>
    )
  }

  <Section
    id="contents"
    label={parents.contents.label}
    jp={parents.contents.jp}
    surface
    moreHref={parents.contents.href}
    moreLabel="すべて見る"
  >
    <GroupNav items={contentsNav} />
  </Section>

  {
    movies.length > 0 && (
      <Section
        id="movies"
        label="Pick Up Movie"
        jp="注目ムービー"
        moreHref={`${parents.contents.href}#movies`}
        moreLabel="もっと見る"
      >
        <ItemLayout layout="list">
          {movies.map((m, i) => {
            const Body = movieBodies[i].Content;
            return (
              <Row
                title={m.data.title}
                subtitle={m.data.subtitle}
                time={m.data.time}
                image={m.data.image}
                link={m.data.link}
                linkLabel={m.data.linkLabel}
              >
                <Body />
              </Row>
            );
          })}
        </ItemLayout>
      </Section>
    )
  }

  {
    ev && ev.guests.length > 0 && (
      <Section id="guests" label="Guests" jp={ev.guestsLabel} surface>
        <NameList names={ev.guests} />
      </Section>
    )
  }

  {
    (sponsors.length > 0 || (ev && ev.supporters.length > 0)) && (
      <Section id="sponsors" label="Sponsors" jp="協賛・後援">
        {sponsors.length > 0 && <SponsorGrid sponsors={sponsors.map((s) => s.data)} />}
        {ev && ev.supporters.length > 0 && (
          <div class="supporters">
            <p class="en supporters__label">{ev.supportersLabel}</p>
            <p class="supporters__list muted">{ev.supporters.join("　/　")}</p>
          </div>
        )}
      </Section>
    )
  }

</BaseLayout>

<style>
  .thanks {
    background: color-mix(in srgb, var(--brand) 12%, var(--bg));
    border-block: 1px solid color-mix(in srgb, var(--brand) 45%, transparent);
    color: var(--brand);
    font-weight: 500;
    text-align: center;
    padding-block: 14px;
    letter-spacing: 0.04em;
  }

  .about {
    font-size: clamp(1rem, 1.8vw, 1.08rem);
  }

  /* SCHEDULE：日付・会場・各日の時間帯だけを並べる要約 */
  .sched {
    border-top: 1px solid var(--border);
  }

  .sched__row {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    align-items: baseline;
    gap: 8px 28px;
    padding-block: 18px;
    border-bottom: 1px solid var(--border);
  }

  .sched__row dt {
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .sched__row dd {
    margin: 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: clamp(1.2rem, 2.8vw, 1.6rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.35;
  }

  .days {
    display: grid;
    grid-template-columns: max-content max-content;
    align-items: baseline;
    gap: 10px 30px;
  }

  .days__time {
    color: var(--brand);
  }

  .days__pending {
    font-size: 0.9rem;
    font-weight: 400;
  }

  /* 狭い画面では1行に収まらないので、時刻を日付の下に落とす */
  @media (max-width: 480px) {
    .days {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .days__time,
    .days__pending {
      margin-bottom: 8px;
    }
  }

  .supporters {
    margin-top: clamp(36px, 5vw, 56px);
    padding-top: 26px;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .supporters__label {
    font-size: 0.95rem;
    letter-spacing: 0.2em;
    color: var(--brand);
  }

  .supporters__list {
    margin-top: 10px;
    font-size: 0.92rem;
  }

  @media (max-width: 560px) {
    .sched__row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
