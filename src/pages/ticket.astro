---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ShareImage from "../components/ShareImage.astro";
import PriceTable from "../components/PriceTable.astro";
import NoteList from "../components/NoteList.astro";
import { dateRangeLabel, getCurrentEvent } from "../lib/content";

const event = await getCurrentEvent();
const ev = event?.data;
---

<BaseLayout title="Ticket｜チケット" description="チケットの料金と注意事項。">
  <PageHero
    label="Ticket"
    jp="チケット"
    lead={ev ? `${ev.edition}／${dateRangeLabel(ev.schedule)}` : undefined}
  >
    <ShareImage
      srcs={["/api/og/ticket.png", "/api/og/ticketnotes.png"]}
      name="areaunite-ticket"
      title="チケット"
    />
  </PageHero>

  <section class="page">
    <div class="wrap">
      <div class="measure">
            {ev && ev.tickets.length > 0 && <PriceTable rows={ev.tickets} />}

            {
              ev?.ticketUrl && (
                <p class="cta">
                  <a class="btn" href={ev.ticketUrl} target="_blank" rel="noopener noreferrer">
                    購入する
                  </a>
                </p>
              )
            }

            {
              ev && ev.ticketNotes.length > 0 && (
                <div class="notes-wrap">
                  <NoteList title="Notes" items={ev.ticketNotes} />
                </div>
              )
            }

            {ev?.ticketMessage && <p class="support muted">{ev.ticketMessage}</p>}
      </div>
    </div>
  </section>
</BaseLayout>

<style>

  .page {
    /* 下はフッターとの間。セクションの下余白と同じだけ空ける */
    padding-block: clamp(40px, 6vw, 72px) var(--section-gap);
  }
  .cta {
    margin-top: 30px;
  }
  .notes-wrap {
    margin-top: clamp(40px, 6vw, 64px);
  }
  .support {
    margin-top: 32px;
    font-size: 0.92rem;
  }
</style>
