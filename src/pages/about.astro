---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../config/site";
import { getCurrentEvent } from "../lib/content";

const event = await getCurrentEvent();
const About = event ? (await render(event)).Content : null;
---

<BaseLayout title="About｜イベントについて" description={site.description}>
  <PageHero label="About" jp="イベントについて" />

  <section class="page">
    <div class="wrap wrap--narrow">
      <p class="en tagline">{site.tagline}</p>
      {About && (
        <div class="prose body">
          <About />
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(40px, 6vw, 72px) 0;
  }

  .tagline {
    font-size: clamp(1.2rem, 3vw, 1.7rem);
    letter-spacing: 0.14em;
    color: var(--brand);
    line-height: 1.5;
  }

  .body {
    margin-top: clamp(28px, 4vw, 40px);
    font-size: clamp(1rem, 1.8vw, 1.08rem);
  }
</style>
