---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../config/site";
import VideoEmbed from "../components/VideoEmbed.astro";
import HiddenNote from "../components/HiddenNote.astro";
import { getCurrentEvent, getSiteInfo } from "../lib/content";
import { showsComingSoon } from "../lib/visibility";

const event = await getCurrentEvent();
const ev = event?.data;
const info = await getSiteInfo();
// 準備中なら COMING SOON に差し替える（URLはそのまま）
if (showsComingSoon(ev, "about", Astro)) return Astro.rewrite("/soon/about");
const About = event ? (await render(event)).Content : null;
---

<BaseLayout title="About｜イベントについて">
  <PageHero label="About" jp="イベントについて" />
  <HiddenNote page="about" />

  <section class="page">
    <div class="wrap">
      <div class="measure">
        <p class="tagline">{info.tagline}</p>
        <div class="prose body">
          {ev?.aboutLead && <p>{ev.aboutLead}</p>}
          {About && <About />}
        </div>
        {
          ev?.prVideo && (
            <div class="video">
              <VideoEmbed url={ev.prVideo} title={`${site.name} PR movie`} />
            </div>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    /* 下はフッターとの間。セクションの下余白と同じだけ空ける */
    padding-block: clamp(40px, 6vw, 72px) var(--section-gap);
  }

  .tagline {
    white-space: pre-line;
    font-family: var(--font-tagline);
    font-weight: 700;
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    letter-spacing: 0.01em;
    color: var(--brand);
    line-height: 1.5;
  }

  .video {
    margin-top: clamp(24px, 4vw, 36px);
  }

  .body {
    margin-top: clamp(28px, 4vw, 40px);
    font-size: clamp(1rem, 1.8vw, 1.08rem);
  }
</style>
