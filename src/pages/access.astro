---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ShareImage from "../components/ShareImage.astro";
import Section from "../components/Section.astro";
import NoteList from "../components/NoteList.astro";
import GroupSection from "../components/GroupSection.astro";
import { parents, groupsOf } from "../config/site";
import { getCurrentEvent, mapLinks } from "../lib/content";
import HiddenNote from "../components/HiddenNote.astro";
import { showsComingSoon } from "../lib/visibility";

const event = await getCurrentEvent();
const ev = event?.data;
// 準備中なら COMING SOON に差し替える（URLはそのまま）
if (showsComingSoon(ev, "access", Astro)) return Astro.rewrite("/soon/access");
const list = groupsOf("access");
const map = mapLinks(ev);

---

<BaseLayout
  title={`${parents.access.label}｜${parents.access.jp}`}
  description="会場の場所と駐車場、周辺の宿泊施設のご案内。"
>
  <PageHero label={parents.access.label} jp={parents.access.jp} />
  <HiddenNote page="access" />

  <Section id="map" label="Venue" jp="会場・アクセス" narrow>
    <ShareImage
      slot="head"
      srcs={["/api/og/access.png", "/api/og/stay.png"]}
      name="areaunite-access"
      title="会場・アクセス"
    />
    {ev?.venue && <p class="venue">{ev.venue}</p>}

    {
      ev?.address && (
        <dl class="info">
          <div>
            <dt class="en">Address</dt>
            <dd>{ev.address}</dd>
          </div>
        </dl>
      )
    }

    {
      map?.embed && (
        <div class="map">
          <iframe
            src={map.embed}
            title={`${ev?.venue ?? "会場"}の地図`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          />
        </div>
      )
    }

    {
      ev && ev.accessNotes.length > 0 && (
        <div class="notes-wrap">
          <NoteList title="Information" items={ev.accessNotes} />
        </div>
      )
    }
  </Section>

  {list.map(([key, g]) => <GroupSection id={key} def={g} surface />)}
</BaseLayout>

<style>

  .info > div + div {
    margin-top: 26px;
  }
  .info dt {
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    color: var(--text-muted);
    line-height: 1;
  }
  .info dd {
    margin: 10px 0 0;
    font-size: 1.05rem;
  }
  .venue {
    font-size: clamp(1.6rem, 4.4vw, 2.3rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.3;
  }

  .info {
    margin-top: 26px;
  }
  .map {
    margin-top: clamp(24px, 4vw, 36px);
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
  }

  .map iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 600px) {
    .map {
      aspect-ratio: 4 / 3;
    }
  }

  .notes-wrap {
    margin-top: clamp(40px, 6vw, 64px);
  }
</style>
