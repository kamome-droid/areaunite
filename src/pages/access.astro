---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SubNav from "../components/SubNav.astro";
import Section from "../components/Section.astro";
import NoteList from "../components/NoteList.astro";
import GroupSection from "../components/GroupSection.astro";
import { parents, groupsOf } from "../config/site";
import { getCurrentEvent } from "../lib/content";

const event = await getCurrentEvent();
const ev = event?.data;
const list = groupsOf("access");

const tabs = [
  { href: "#map", label: "会場・アクセス" },
  ...list.map(([key, g]) => ({ href: `#${key}`, label: g.jp })),
];
---

<BaseLayout
  title={`${parents.access.label}｜${parents.access.jp}`}
  description="会場の場所と駐車場、周辺の宿泊施設のご案内。"
>
  <PageHero label={parents.access.label} jp={parents.access.jp} />

  {/* 2つだけだと帯にポツンと浮いて弱いので、3つ以上のときだけ目次を出す。
      少ない項目はそのまま下へ読み進めればよい（ナビの子メニューからは飛べる） */}
  {tabs.length > 2 && <SubNav items={tabs} />}

  <Section id="map" label="Venue" jp="会場・アクセス" narrow>
    {ev?.venue && <p class="venue">{ev.venue}</p>}

    {
      ev?.address && (
        <dl class="info">
          <div>
            <dt class="en">Address</dt>
            <dd>{ev.address}</dd>
          </div>
        </dl>
      )
    }

    {
      ev?.mapUrl && (
        <p class="cta">
          <a class="btn btn--ghost" href={ev.mapUrl} target="_blank" rel="noopener noreferrer">
            Google Map で開く
          </a>
        </p>
      )
    }

    {
      ev && ev.accessNotes.length > 0 && (
        <div class="notes-wrap">
          <NoteList title="Information" items={ev.accessNotes} />
        </div>
      )
    }
  </Section>

  {list.map(([key, g]) => <GroupSection id={key} def={g} surface />)}
</BaseLayout>

<style>
  .info > div + div {
    margin-top: 26px;
  }
  .info dt {
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    color: var(--text-muted);
    line-height: 1;
  }
  .info dd {
    margin: 10px 0 0;
    font-size: 1.05rem;
  }
  .venue {
    font-size: clamp(1.6rem, 4.4vw, 2.3rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.3;
  }

  .info {
    margin-top: 26px;
  }
  .cta {
    margin-top: 30px;
  }
  .notes-wrap {
    margin-top: clamp(40px, 6vw, 64px);
  }
</style>
