---
/**
 * 汎用セクション。英字見出し＋日本語副題＋リード文＋中身。
 * 見出しの形をこの1か所に閉じ込めることで全ページのリズムを揃える。
 */
interface Props {
  id?: string;
  label: string;
  jp?: string;
  lead?: string;
  /** 右上に置く「一覧を見る」などのリンク */
  moreHref?: string;
  moreLabel?: string;
  /** 面の色を一段上げる */
  surface?: boolean;
  /** 中身の行長を抑える。左端は他のセクションと揃ったまま */
  narrow?: boolean;
}

const {
  id,
  label,
  jp,
  lead,
  moreHref,
  moreLabel = "View all",
  surface = false,
  narrow = false,
} = Astro.props;
---

<section class:list={["sec", surface && "sec--surface"]} id={id}>
  <div class="wrap">
    <div class="sec__head">
      <div>
        <h2 class="en sec__label">{label}</h2>
        {jp && <p class="sec__jp">{jp}</p>}
      </div>
    </div>
    {lead && <p class="sec__lead muted">{lead}</p>}
    <div class:list={["sec__body", narrow && "measure"]}>
      <slot />
    </div>
    {
      moreHref && (
        <p class="sec__more-wrap">
          <a class="sec__more" href={moreHref}>
            {moreLabel}
            <span class="sec__arrow" aria-hidden="true">
              →
            </span>
          </a>
        </p>
      )
    }

    {/* 続きへの導線より下に置きたいもの（動画など） */}
    <slot name="after" />
  </div>
</section>

<style>
  .sec {
    padding-block: var(--section-gap);
  }

  .sec--surface {
    background: var(--surface);
    border-block: 1px solid var(--border);
  }

  .sec__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }

  .sec__label {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .sec__jp {
    margin-top: 8px;
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    color: var(--brand);
    line-height: 1;
  }

  /* 矢印が右を指すので、視線の行き先である右端に置く。
     左揃えの本文とも競合しない */
  .sec__more-wrap {
    margin-top: clamp(20px, 3vw, 30px);
    text-align: right;
  }

  /* 線は引かず、矢印を丸で囲って目立たせる */
  .sec__more {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 1.02rem;
    line-height: 1;
    color: var(--text);
    transition: color 0.2s ease;
  }

  .sec__more:hover {
    color: var(--brand);
  }

  .sec__arrow {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--brand);
    border-radius: 50%;
    color: var(--brand);
    font-size: 1.25rem;
    line-height: 1;
    transition: background 0.2s ease, color 0.2s ease, translate 0.2s ease;
  }

  .sec__more:hover .sec__arrow {
    background: var(--brand);
    color: var(--brand-ink);
    translate: 4px 0;
  }

  .sec__lead {
    margin-top: 22px;
    max-width: 34em;
  }

  .sec__body {
    margin-top: clamp(28px, 4vw, 44px);
  }
</style>
