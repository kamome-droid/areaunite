---
/**
 * 汎用セクション。英字見出し＋日本語副題＋リード文＋中身。
 * 見出しの形をこの1か所に閉じ込めることで全ページのリズムを揃える。
 */
interface Props {
  id?: string;
  label: string;
  jp?: string;
  lead?: string;
  /** 右上に置く「一覧を見る」などのリンク */
  moreHref?: string;
  moreLabel?: string;
  /** 面の色を一段上げる */
  surface?: boolean;
  narrow?: boolean;
}

const {
  id,
  label,
  jp,
  lead,
  moreHref,
  moreLabel = "View all",
  surface = false,
  narrow = false,
} = Astro.props;
---

<section class:list={["sec", surface && "sec--surface"]} id={id}>
  <div class:list={["wrap", narrow && "wrap--narrow"]}>
    <div class="sec__head">
      <div>
        <h2 class="en sec__label">{label}</h2>
        {jp && <p class="sec__jp">{jp}</p>}
      </div>
    </div>
    {lead && <p class="sec__lead muted">{lead}</p>}
    <div class="sec__body">
      <slot />
    </div>
    {
      moreHref && (
        <p class="sec__more-wrap">
          <a class="sec__more" href={moreHref}>
            {moreLabel}
            <span class="sec__arrow" aria-hidden="true">
              →
            </span>
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .sec {
    padding-block: var(--section-gap);
  }

  .sec--surface {
    background: var(--surface);
    border-block: 1px solid var(--border);
  }

  .sec__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }

  .sec__label {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .sec__jp {
    margin-top: 8px;
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    color: var(--brand);
    line-height: 1;
  }

  .sec__more-wrap {
    margin-top: clamp(24px, 3.5vw, 36px);
  }

  .sec__more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 1.4em;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 0.95rem;
    line-height: 1;
    color: var(--text);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .sec__more:hover {
    border-color: var(--brand);
    color: var(--brand);
  }

  .sec__arrow {
    color: var(--brand);
    transition: translate 0.2s ease;
  }

  .sec__more:hover .sec__arrow {
    translate: 4px 0;
  }

  .sec__lead {
    margin-top: 22px;
    max-width: 34em;
  }

  .sec__body {
    margin-top: clamp(28px, 4vw, 44px);
  }
</style>
