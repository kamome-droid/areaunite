---
/** 来場ライダーなど、名前だけを並べる欄。
    押せる要素と紛らわしくならないよう、囲みは付けずに区切りで羅列する。 */
interface Props {
  names: string[];
}
const { names } = Astro.props;
---

<p class="names">
  {
    names.map((n, i) => (
      <>
        {i > 0 && (
          <span class="names__sep" aria-hidden="true">
            /
          </span>
        )}
        <span class="names__name">{n}</span>
      </>
    ))
  }
</p>

<style>
  .names {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 2.1;
  }

  .names__name {
    /* 名前の途中で行が変わらないよう、折り返しは区切りの位置だけにする */
    white-space: nowrap;
  }

  .names__sep {
    margin-inline: 0.5em;
    color: var(--brand);
    /* 名前より控えめに。区切りだと分かればよい */
    opacity: 0.55;
  }
</style>
