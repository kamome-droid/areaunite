---
/** 来場ライダーなど、名前だけを大量に並べる欄。 */
interface Props {
  names: string[];
}
const { names } = Astro.props;
---

<ul class="names">
  {names.map((n) => <li class="en">{n}</li>)}
</ul>

<style>
  .names {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .names li {
    padding: 8px 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: none;
  }
</style>
