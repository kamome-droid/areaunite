---
/** カードの並べ方だけを担当する入れ物。grid = 格子、list = 1列の横並び行。 */
interface Props {
  layout?: "grid" | "list";
  /** grid のときのカード最小幅 */
  min?: string;
}
const { layout = "grid", min = "270px" } = Astro.props;
---

<div
  class:list={["items", `items--${layout}`]}
  style={`--card-min:${min}`}
>
  <slot />
</div>

<style>
  .items--grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--card-min), 1fr));
    gap: clamp(16px, 2.2vw, 26px);
  }

  .items--list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
</style>
