---
/** カードの並べ方だけを担当する入れ物。grid = 格子、list = 1列の横並び行。 */
interface Props {
  layout?: "grid" | "list";
  /** grid のときのカード最小幅 */
  min?: string;
}
const { layout = "grid", min } = Astro.props;
---

<div
  class:list={["items", `items--${layout}`]}
  style={`--card-min:${min ?? "270px"}`}
>
  <slot />
</div>

<style>
  .items--grid {
    display: grid;
    /* min() を挟まないと、画面幅がカード最小幅を下回ったときに横へはみ出す */
    grid-template-columns: repeat(
      auto-fill,
      minmax(min(var(--card-min), 100%), 1fr)
    );
    gap: clamp(16px, 2.2vw, 26px);
  }

  .items--list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
</style>
