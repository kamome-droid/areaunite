---
/**
 * 写真を横一列に並べ、ゆっくり自動で流す。
 * 指やマウスでそのまま横にスクロールもできる（触っているあいだは止まる）。
 * 画像は管理画面で 4:3 にそろえて保存されるので、ここでは高さだけ決める。
 */
interface Props {
  photos: string[];
  label?: string;
}
const { photos, label = "写真" } = Astro.props;
/** 途切れずに流すため、同じ並びを2周ぶん出す（2周目は読み上げから外す） */
const loop = photos.length > 1 ? [...photos, ...photos] : photos;
---

{
  photos.length > 0 && (
    <div class="strip" role="group" aria-label={label} tabindex="0" data-strip data-count={photos.length}>
      {loop.map((src, i) => (
        <figure class="strip__item" aria-hidden={i >= photos.length ? "true" : undefined}>
          <img src={src} alt="" loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  )
}

<style>
  .strip {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    /* 端まで写真を出すため、ページの余白ぶん外に広げてから内側で戻す */
    margin-inline: calc(var(--page-pad) * -1);
    padding-inline: var(--page-pad);
    padding-bottom: 12px;
    /* 自動で流れるので、スクロールバーは出さない */
    scrollbar-width: none;
  }

  .strip::-webkit-scrollbar {
    display: none;
  }

  .strip__item {
    flex: 0 0 auto;
    width: clamp(230px, 40vw, 380px);
    aspect-ratio: 4 / 3;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .strip__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .strip:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 4px;
  }
</style>

<script>
  /** 写真をゆっくり左へ流す。触っているあいだは止め、離すと再開する。
      同じ並びを2周ぶん出してあるので、半分まで来たら先頭へ戻して途切れさせない。 */
  const SPEED = 0.35; // 1フレームあたりの移動量（px）

  document.querySelectorAll<HTMLElement>("[data-strip]").forEach((strip) => {
    if (Number(strip.dataset.count) < 2) return;
    // 動きを減らす設定の人には流さない
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let paused = false;
    let resume = 0;
    const hold = (ms: number) => {
      paused = true;
      clearTimeout(resume);
      resume = window.setTimeout(() => (paused = false), ms);
    };

    strip.addEventListener("pointerenter", () => (paused = true));
    strip.addEventListener("pointerleave", () => (paused = false));
    strip.addEventListener("focusin", () => (paused = true));
    strip.addEventListener("focusout", () => (paused = false));
    // 指やホイールで動かしたあとは、少し置いてから再開する
    for (const type of ["pointerdown", "wheel", "touchstart"]) {
      strip.addEventListener(type, () => hold(2500), { passive: true });
    }

    const step = () => {
      if (!paused && document.visibilityState === "visible") {
        const half = strip.scrollWidth / 2;
        if (strip.scrollLeft >= half) strip.scrollLeft -= half;
        strip.scrollLeft += SPEED;
      }
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  });
</script>
