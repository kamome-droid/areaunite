---
import Timetable from "./Timetable.astro";
import type { ProgramBlock } from "../lib/content";

/**
 * 開催日ごとのプログラム。
 *
 * 日はすべて縦に並べ、切り替えは行わない。上のバーは「いまどの日を
 * 読んでいるか」を示す目次で、押すとその日へスクロールする。
 * スクロール量に応じて勝手に表示が入れ替わると、自分で動かしていない
 * のに画面が動くことになり落ち着かないため、その仕組みは持たせていない。
 */
interface Props {
  days: {
    day: { id: string; label: string; jp: string; note?: string };
    blocks: ProgramBlock[];
  }[];
}
const { days } = Astro.props;
---

<nav class="dayindex" aria-label="開催日">
  <div class="wrap dayindex__inner">
    {
      days.map(({ day }) => (
        <a class="dayindex__item" href={`#${day.id}`} data-day={day.id}>
          <span class="en dayindex__label">{day.label}</span>
          {day.note && <span class="num dayindex__date">{day.note}</span>}
        </a>
      ))
    }
  </div>
</nav>

{
  days.map(({ day, blocks }, i) => (
    <section
      class:list={["daypanel", i % 2 === 0 ? "daypanel--a" : "daypanel--b"]}
      id={day.id}
      data-day={day.id}
      aria-labelledby={`head-${day.id}`}
    >
      <div class="wrap">
        <header class="daypanel__head">
          <h2 class="en daypanel__label" id={`head-${day.id}`}>
            {day.label}
          </h2>
          {day.note && <p class="num daypanel__date">{day.note}</p>}
        </header>

        {blocks.length > 0 ? (
          <Timetable blocks={blocks} />
        ) : (
          <p class="daypanel__empty muted">準備中です。決まりしだい公開します。</p>
        )}
      </div>
    </section>
  ))
}

<script>
  const bar = document.querySelector<HTMLElement>(".dayindex");
  const items = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".dayindex__item")
  );
  const panels = Array.from(
    document.querySelectorAll<HTMLElement>(".daypanel")
  );

  if (bar && items.length > 0) {
    const header = document.querySelector<HTMLElement>(".hd");

    /** ヘッダーと目次バーが重なっている高さ。アンカーの着地位置に使う */
    const stickyHeight = () =>
      (header?.offsetHeight ?? 0) + bar.offsetHeight;

    const syncOffset = () =>
      document.documentElement.style.setProperty(
        "--day-offset",
        `${stickyHeight()}px`
      );

    /** いま読んでいる日を目次に反映する */
    const markCurrent = () => {
      const line = stickyHeight() + 8;
      let current = panels[0];
      for (const panel of panels) {
        if (panel.getBoundingClientRect().top - line <= 0) current = panel;
      }
      items.forEach((item) => {
        if (item.dataset.day === current?.dataset.day) {
          item.setAttribute("aria-current", "location");
        } else {
          item.removeAttribute("aria-current");
        }
      });
    };

    let ticking = false;
    const request = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        markCurrent();
      });
    };

    syncOffset();
    markCurrent();
    window.addEventListener("scroll", request, { passive: true });
    window.addEventListener("resize", () => {
      syncOffset();
      request();
    });
  }
</script>

<style>
  /* ---- 目次バー ---- */
  .dayindex {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .dayindex__inner {
    display: flex;
    gap: clamp(18px, 3vw, 40px);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .dayindex__inner::-webkit-scrollbar {
    display: none;
  }

  .dayindex__item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding-block: 14px;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    white-space: nowrap;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .dayindex__item:hover {
    color: var(--text);
  }

  .dayindex__item[aria-current] {
    color: var(--text);
    border-bottom-color: var(--brand);
  }

  .dayindex__label {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .dayindex__date {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  .dayindex__item[aria-current] .dayindex__date {
    color: var(--brand);
  }

  /* ---- 各日 ---- */
  .daypanel {
    padding-block: clamp(44px, 7vw, 80px);
    /* アンカーで飛んだとき、見出しがバーの下に隠れないようにする */
    scroll-margin-top: var(--day-offset, 140px);
  }

  .daypanel--a {
    background: var(--surface);
  }

  .daypanel--b {
    background: var(--surface-2);
  }

  .daypanel__head {
    margin-bottom: clamp(26px, 4vw, 40px);
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }

  .daypanel__label {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .daypanel__date {
    margin-top: 10px;
    font-size: 0.9rem;
    letter-spacing: 0.16em;
    color: var(--brand);
    line-height: 1;
  }

  .daypanel__empty {
    padding-block: 40px;
    text-align: center;
  }
</style>
