---
import Timetable from "./Timetable.astro";
import PageIndex from "./PageIndex.astro";
import type { ProgramBlock } from "../lib/content";

/**
 * 開催日ごとのプログラム。
 *
 * 日はすべて縦に並べ、切り替えは行わない。上のバーは「いまどの日を
 * 読んでいるか」を示す目次で、押すとその日へスクロールする。
 * スクロール量に応じて勝手に表示が入れ替わると、自分で動かしていない
 * のに画面が動くことになり落ち着かないため、その仕組みは持たせていない。
 */
interface Props {
  days: {
    day: { id: string; label: string; jp: string; note?: string };
    blocks: ProgramBlock[];
  }[];
}
const { days } = Astro.props;
---

<PageIndex
  ariaLabel="開催日"
  items={days.map(({ day }) => ({
    href: `#${day.id}`,
    label: day.label,
    sub: day.note,
  }))}
/>

{
  days.map(({ day, blocks }, i) => (
    <section
      class:list={["daypanel", i % 2 === 0 ? "daypanel--a" : "daypanel--b"]}
      id={day.id}
      data-day={day.id}
      aria-labelledby={`head-${day.id}`}
    >
      <div class="wrap">
        <header class="daypanel__head">
          <h2 class="en daypanel__label" id={`head-${day.id}`}>
            {day.label}
          </h2>
          {day.note && <p class="num daypanel__date">{day.note}</p>}
        </header>

        {blocks.length > 0 ? (
          <Timetable blocks={blocks} />
        ) : (
          <p class="daypanel__empty muted">準備中です。決まりしだい公開します。</p>
        )}
      </div>
    </section>
  ))
}



<style>
  .daypanel {
    padding-block: clamp(44px, 7vw, 80px);
  }

  .daypanel--a {
    background: var(--surface);
  }

  .daypanel--b {
    background: var(--surface-2);
  }

  .daypanel__head {
    margin-bottom: clamp(26px, 4vw, 40px);
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }

  .daypanel__label {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .daypanel__date {
    margin-top: 10px;
    font-size: 0.9rem;
    letter-spacing: 0.16em;
    color: var(--brand);
    line-height: 1;
  }

  .daypanel__empty {
    padding-block: 40px;
    text-align: center;
  }
</style>
