---
import Timetable from "./Timetable.astro";
import type { ProgramBlock } from "../lib/content";

/**
 * 開催日の切り替えタブ。選んだ日のプログラムだけを出す。
 * 2日以上あるイベントで、来場者が「自分が行く日」だけを見られるようにする。
 * JSが動かない環境では全日が縦に並ぶ（内容は欠けない）。
 */
interface Props {
  days: {
    day: { id: string; label: string; jp: string; note?: string };
    blocks: ProgramBlock[];
  }[];
}
const { days } = Astro.props;
---

<div class="daytabs">
  <div class="wrap">
    <div class="daytabs__list" role="tablist" aria-label="開催日">
      {
        days.map(({ day }, i) => (
          <button
            type="button"
            class:list={["daytab", i % 2 === 0 ? "daytab--a" : "daytab--b"]}
            role="tab"
            id={`tab-${day.id}`}
            aria-controls={`panel-${day.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            data-day={day.id}
          >
            <span class="en daytab__label">{day.label}</span>
            {day.note && <span class="num daytab__date">{day.note}</span>}
          </button>
        ))
      }
    </div>
  </div>
</div>

{
  days.map(({ day, blocks }, i) => {
    const prev = days[i - 1]?.day;
    const next = days[i + 1]?.day;
    return (
      <section
        class:list={["daypanel", i % 2 === 0 ? "daypanel--a" : "daypanel--b"]}
        id={`panel-${day.id}`}
        role="tabpanel"
        aria-labelledby={`tab-${day.id}`}
        data-day={day.id}
      >
        <div class="wrap">
          <h2 class="visually-hidden">
            {day.label} {day.note}
          </h2>

          {/* 端に置いた検知用の目印。見た目は持たない */}
          {prev && <div class="daysentinel" data-sentinel="prev" aria-hidden="true" />}

          {blocks.length > 0 ? (
            <Timetable blocks={blocks} />
          ) : (
            <p class="daypanel__empty muted">準備中です。決まりしだい公開します。</p>
          )}

          {next && <div class="daysentinel" data-sentinel="next" aria-hidden="true" />}
        </div>
      </section>
    );
  })
}

<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".daytab")
  );
  const panels = Array.from(
    document.querySelectorAll<HTMLElement>(".daypanel")
  );

  if (tabs.length > 0) {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    const select = (id: string) => {
      tabs.forEach((t) =>
        t.setAttribute("aria-selected", String(t.dataset.day === id))
      );
      panels.forEach((p) => {
        p.hidden = p.dataset.day !== id;
      });
    };

    /** ヘッダーとタブが重なっている高さ。切り替え後はこの真下に頭出しする */
    const stickyHeight = () =>
      (document.querySelector<HTMLElement>(".hd")?.offsetHeight ?? 0) +
      (document.querySelector<HTMLElement>(".daytabs")?.offsetHeight ?? 0);

    /** 目印が「一度画面から出てから戻ってきた」ときだけ反応させるための状態。
        切り替え直後に反対側へ弾き返されるのを防ぐ */
    const armed = new WeakMap<Element, boolean>();
    const disarmAll = () =>
      document
        .querySelectorAll("[data-sentinel]")
        .forEach((el) => armed.set(el, false));

    /** 直前に切り替えた時刻。勢い余った小さな逆スクロールで戻されるのを防ぐ */
    let lastSwitchAt = 0;

    const goTo = (id: string, smooth = false) => {
      select(id);
      disarmAll();

      const panel = panels.find((p) => p.dataset.day === id);
      if (panel) {
        window.scrollTo({
          top: Math.max(0, panel.offsetTop - stickyHeight()),
          behavior: smooth && !reduceMotion ? "smooth" : "instant",
        });
        // 頭出しした直後でも「上へ戻る」だけは効かせたいので、
        // 上端の目印だけは構えた状態にしておく
        const back = panel.querySelector('[data-sentinel="prev"]');
        if (back) armed.set(back, true);
      }
      history.replaceState(null, "", `#${id}`);
      // 自分で動かしたぶんを向きの判定に混ぜない
      lastY = window.scrollY;
      lastSwitchAt = performance.now();
    };

    // ---- タブ ----
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => goTo(tab.dataset.day!, true));
    });

    document
      .querySelector(".daytabs__list")
      ?.addEventListener("keydown", (e) => {
        const key = (e as KeyboardEvent).key;
        if (key !== "ArrowLeft" && key !== "ArrowRight") return;
        const current = tabs.findIndex(
          (t) => t.getAttribute("aria-selected") === "true"
        );
        const next =
          (current + (key === "ArrowRight" ? 1 : -1) + tabs.length) %
          tabs.length;
        goTo(tabs[next].dataset.day!, true);
        tabs[next].focus();
      });

    // ---- スクロールでの切り替え ----
    // 端に置いた目印に到達したかを毎フレーム位置で見る。
    // 交差監視だと、一気にスクロールしたときに通過を取りこぼす。
    let lastY = window.scrollY;
    let direction: "up" | "down" = "down";
    let ticking = false;

    const liveSentinels = () =>
      Array.from(
        document.querySelectorAll<HTMLElement>(
          ".daypanel:not([hidden]) [data-sentinel]"
        )
      );

    const check = () => {
      ticking = false;

      for (const el of liveSentinels()) {
        const kind = el.dataset.sentinel;
        const rect = el.getBoundingClientRect();
        // next は下端の目印。画面に入った瞬間だと最後の数行を読む前に
        // 送られてしまうので、画面の3/4まで上がってきたら到達とみなす。
        // prev は上端の目印で、画面上端に戻ってきたら到達。
        const reached =
          kind === "next"
            ? rect.top <= window.innerHeight * 0.75
            : rect.bottom >= 0;

        // 届いていないあいだに構えておく（＝一度離れないと再発火しない）
        if (!reached) {
          armed.set(el, true);
          continue;
        }
        if (!armed.get(el)) continue;
        // 切り替えた直後の跳ね返りを避ける
        if (performance.now() - lastSwitchAt < 500) continue;

        // 読み進めている向きと一致するときだけ切り替える
        if (kind === "next" && direction !== "down") continue;
        if (kind === "prev" && direction !== "up") continue;

        const panel = el.closest<HTMLElement>(".daypanel");
        const index = panels.indexOf(panel!);
        const target = panels[kind === "next" ? index + 1 : index - 1];
        if (!target) continue;

        goTo(target.dataset.day!);
        return;
      }
    };

    window.addEventListener(
      "scroll",
      () => {
        const y = window.scrollY;
        if (y > lastY) direction = "down";
        else if (y < lastY) direction = "up";
        lastY = y;

        if (!ticking) {
          ticking = true;
          requestAnimationFrame(check);
        }
      },
      { passive: true }
    );

    window.addEventListener("resize", () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(check);
      }
    });

    // ---- 初期表示 ----
    const fromHash = () => {
      const id = location.hash.slice(1);
      return tabs.some((t) => t.dataset.day === id) ? id : null;
    };

    const initial = fromHash();
    select(initial ?? tabs[0].dataset.day!);
    disarmAll();
    requestAnimationFrame(check);

    window.addEventListener("hashchange", () => {
      const id = fromHash();
      if (id) goTo(id);
    });
  }
</script>

<style>
  .daytabs {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    background: var(--bg);
  }

  .daytabs__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(150px, 250px);
    justify-content: start;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .daytabs__list::-webkit-scrollbar {
    display: none;
  }

  .daytab {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 15px 20px 16px;
    margin: 0;
    border: 0;
    /* 選択中の印。未選択のときも高さを確保して位置をずらさない */
    border-top: 3px solid transparent;
    border-radius: 8px 8px 0 0;
    background: transparent;
    color: var(--text-muted);
    text-align: left;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .daytab__label {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1;
  }

  .daytab__date {
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  .daytab:hover {
    color: var(--text);
    background: color-mix(in srgb, var(--text) 5%, transparent);
  }

  /* 選択中のタブは、その日のパネルと同じ面で塗って地続きに見せる。
     どの日を見ているかが、タブと本文の両方から分かる。 */
  .daytab[aria-selected="true"] {
    color: var(--text);
    border-top-color: var(--brand);
  }

  .daytab--a[aria-selected="true"] {
    background: var(--surface);
  }

  .daytab--b[aria-selected="true"] {
    background: var(--surface-2);
  }

  .daytab[aria-selected="true"] .daytab__date {
    color: var(--brand);
  }

  .daypanel {
    padding-block: clamp(40px, 6vw, 72px);
  }

  /* 日ごとに面を変える。切り替わったことが本文の地の色でも分かる */
  .daypanel--a {
    background: var(--surface);
  }

  .daypanel--b {
    background: var(--surface-2);
  }

  /* 切り替わった瞬間を捉えられるよう、ひと呼吸だけ動かす */
  @media (prefers-reduced-motion: no-preference) {
    .daypanel:not([hidden]) {
      animation: dayin 0.3s ease both;
    }
  }

  @keyframes dayin {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .daypanel__empty {
    padding-block: 40px;
    text-align: center;
  }

  /* 切り替えの検知点。高さを持たせないので表示には影響しない */
  .daysentinel {
    height: 0;
  }
</style>
