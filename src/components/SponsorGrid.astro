---
/** スポンサーロゴ。tier で大きさを変える。 */
interface Props {
  sponsors: {
    name: string;
    logo?: string;
    url?: string;
    tier: number;
  }[];
}
const { sponsors } = Astro.props;
---

{/* ロゴのimgはテンプレートの中に直接書く。
    frontmatter で組み立てた要素には、このファイルのCSSが当たらないため */}
<ul class="sp">
  {
    sponsors.map((s) => (
      <li class:list={["sp__item", `sp__item--t${s.tier ?? 2}`]}>
        {s.url ? (
          <a href={s.url} target="_blank" rel="noopener noreferrer" title={s.name}>
            {s.logo ? (
              <img src={s.logo} alt={s.name} loading="lazy" decoding="async" />
            ) : (
              <span class="en sp__name">{s.name}</span>
            )}
          </a>
        ) : s.logo ? (
          <img src={s.logo} alt={s.name} loading="lazy" decoding="async" />
        ) : (
          <span class="en sp__name">{s.name}</span>
        )}
      </li>
    ))
  }
</ul>

<style>
  .sp {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(14px, 2.4vw, 28px);
  }

  .sp__item {
    /* 高さが決まった箱の中で中央に置く。grid だと高さの100%が効かず、
       大きいロゴが枠からはみ出す */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    /* ロゴは白地のものも、黒い文字のものも来る。白い面に元の色のまま置けば、
       どんなロゴでも読める（黒い面に置くと、黒いロゴが消える） */
    background: #fff;
  }

  .sp__item a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .sp__item img {
    /* どんな形のロゴ（横長・正方形・縦長）でも、切らずに枠の内側に収める */
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: opacity 0.2s ease;
  }

  .sp__item a:hover img {
    opacity: 0.75;
  }

  /* ロゴが無いときは名前を出す。白い面に載るので濃い文字にする */
  .sp__name {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #1b1b1e;
    text-align: center;
  }

  /* 枠は少し縦長ぎみにする。縦長のロゴが小さくなりすぎないように */
  .sp__item--t1 {
    width: 200px;
    height: 124px;
  }
  .sp__item--t2 {
    width: 156px;
    height: 100px;
  }
  .sp__item--t3 {
    width: 124px;
    height: 80px;
  }

  @media (max-width: 520px) {
    .sp__item--t1 {
      width: 152px;
      height: 96px;
    }
    .sp__item--t2 {
      width: 126px;
      height: 82px;
    }
    .sp__item--t3 {
      width: 104px;
      height: 68px;
    }
  }
</style>
