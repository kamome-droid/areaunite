---
import Section from "./Section.astro";
import CardGrid from "./CardGrid.astro";
import { getItemsView } from "../lib/content";
import type { Group } from "../config/site";

/** 分類ひとつ分のセクション。親ページはこれを並べるだけで組み上がる。 */
interface Props {
  id: string;
  def: Group;
  surface?: boolean;
}

const { id, def, surface = false } = Astro.props;
const rows = await getItemsView(id);
---

<Section id={id} label={def.label} jp={def.jp} lead={def.lead} surface={surface}>
  {
    rows.length === 0 ? (
      <p class="empty muted">準備中です。決まりしだい公開します。</p>
    ) : (
      <CardGrid group={id} def={def} rows={rows} />
    )
  }
</Section>

<style>
  .empty {
    padding-block: 40px;
    text-align: center;
  }
</style>
