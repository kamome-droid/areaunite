---
/**
 * ページ内の目次バー。
 * ヘッダーの下に貼り付き、押すとその見出しへ移動し、
 * スクロール位置に応じていま読んでいるところを示す。
 *
 * 開催日の切り替え（スケジュール）にも、分類の目次（コンテンツ）にも使う。
 * 囲み（ピル・カード）は持たせない。押せる要素として過剰に見えるため。
 */
interface Props {
  items: { href: string; label: string; sub?: string }[];
  ariaLabel?: string;
}
const { items, ariaLabel = "ページ内メニュー" } = Astro.props;
---

<nav class="pageindex" aria-label={ariaLabel}>
  <div class="wrap pageindex__inner">
    {
      items.map((item) => (
        <a
          class="pageindex__item"
          href={item.href}
          data-target={item.href.replace("#", "")}
        >
          <span class="pageindex__label">{item.label}</span>
          {item.sub && <span class="num pageindex__sub">{item.sub}</span>}
        </a>
      ))
    }
  </div>
</nav>

<script>
  const bar = document.querySelector<HTMLElement>(".pageindex");
  const items = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".pageindex__item")
  );

  if (bar && items.length > 0) {
    const header = document.querySelector<HTMLElement>(".hd");
    const targets = items
      .map((item) => document.getElementById(item.dataset.target ?? ""))
      .filter((el): el is HTMLElement => Boolean(el));

    /** ヘッダーと目次バーが重なっている高さ */
    const stickyHeight = () => (header?.offsetHeight ?? 0) + bar.offsetHeight;

    /** アンカーで飛んだとき、見出しがバーの下に隠れないようにする */
    const syncScrollPadding = () => {
      document.documentElement.style.scrollPaddingTop = `${stickyHeight() + 8}px`;
    };

    /** いま読んでいるところを目次に反映する */
    const markCurrent = () => {
      const line = stickyHeight() + 12;
      let current = targets[0];
      for (const target of targets) {
        if (target.getBoundingClientRect().top - line <= 0) current = target;
      }
      items.forEach((item) => {
        if (item.dataset.target === current?.id) {
          item.setAttribute("aria-current", "location");
        } else {
          item.removeAttribute("aria-current");
        }
      });
    };

    let ticking = false;
    const request = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        markCurrent();
      });
    };

    syncScrollPadding();
    markCurrent();
    window.addEventListener("scroll", request, { passive: true });
    window.addEventListener("resize", () => {
      syncScrollPadding();
      request();
    });
  }
</script>

<style>
  .pageindex {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .pageindex__inner {
    display: flex;
    gap: clamp(18px, 3vw, 40px);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .pageindex__inner::-webkit-scrollbar {
    display: none;
  }

  .pageindex__item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding-block: 14px;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    white-space: nowrap;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .pageindex__item:hover {
    color: var(--text);
  }

  .pageindex__item[aria-current] {
    color: var(--text);
    border-bottom-color: var(--brand);
  }

  .pageindex__label {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.4;
  }

  .pageindex__sub {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    line-height: 1.4;
  }

  .pageindex__item[aria-current] .pageindex__sub {
    color: var(--brand);
  }
</style>
