---
/** 下層ページの見出し。トップのKVより静かに、けれど同じ骨格で。 */
interface Props {
  label: string;
  jp?: string;
  lead?: string;
  image?: string;
}
const { label, jp, lead, image } = Astro.props;
---

<section class:list={["phero", image && "phero--image"]}>
  {
    image && (
      <div class="phero__media">
        <img src={image} alt="" fetchpriority="high" decoding="async" />
      </div>
    )
  }
  <div class="wrap phero__inner">
    <h1 class="en phero__label">{label}</h1>
    {jp && <p class="phero__jp">{jp}</p>}
    {lead && <p class="phero__lead muted">{lead}</p>}
  </div>
</section>

<style>
  .phero {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
    padding-top: calc(var(--header-h) + clamp(48px, 8vw, 96px));
    padding-bottom: clamp(32px, 5vw, 56px);
    border-bottom: 1px solid var(--border);
    isolation: isolate;
    overflow: hidden;
  }

  .phero--image {
    min-height: min(46svh, 420px);
    display: flex;
    align-items: flex-end;
    border-bottom-color: transparent;
  }

  .phero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .phero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .phero--image::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 70%, transparent) 55%,
      color-mix(in srgb, var(--bg) 50%, transparent) 100%
    );
  }

  .phero__label {
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 0.95;
  }

  .phero__jp {
    margin-top: 10px;
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    color: var(--brand);
    line-height: 1;
  }

  .phero__lead {
    margin-top: 22px;
    max-width: 34em;
  }
</style>
