---
import { site, nav } from "../config/site";

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href.startsWith("/#") ? false : path === href || path === href.slice(0, -1);
---

<header class="hd">
  <div class="hd__bar">
    <a class="hd__logo" href="/">
      {
        site.logo ? (
          <img src={site.logo} alt={site.name} width="200" height="38" />
        ) : (
          <span class="en">{site.name}</span>
        )
      }
    </a>

    <nav class="hd__nav" aria-label="メインメニュー">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="en"
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hd__right">
      {
        site.headerCta && (
          <a class="btn hd__cta" href={site.headerCta.href}>
            {site.headerCta.label}
          </a>
        )
      }
      <button
        class="hd__burger"
        type="button"
        aria-label="メニューを開く"
        aria-expanded="false"
        aria-controls="drawer"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- モバイル用ドロワー -->
  <div class="drawer" id="drawer" hidden>
    <ul class="drawer__list">
      {
        nav.map((item) => (
          <li>
            <a href={item.href}>
              <span class="en">{item.label}</span>
              {item.jp && <span class="drawer__jp">{item.jp}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".hd");
  const burger = header?.querySelector<HTMLButtonElement>(".hd__burger");
  const drawer = header?.querySelector<HTMLElement>(".drawer");

  const setOpen = (open: boolean) => {
    if (!burger || !drawer) return;
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
    drawer.hidden = !open;
    document.body.style.overflow = open ? "hidden" : "";
  };

  burger?.addEventListener("click", () => {
    setOpen(burger.getAttribute("aria-expanded") !== "true");
  });

  drawer?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  // 少しでもスクロールしたら背景を敷いて可読性を確保する
  const onScroll = () =>
    header?.classList.toggle("is-scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 50;
    background: transparent;
    transition: background 0.25s ease, border-color 0.25s ease;
    border-bottom: 1px solid transparent;
  }

  .hd.is-scrolled {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom-color: var(--border);
  }

  .hd__bar {
    display: flex;
    align-items: center;
    gap: 20px;
    height: var(--header-h);
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--page-pad);
  }

  .hd__logo {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
  }

  .hd__logo img {
    height: 30px;
    width: auto;
  }

  .hd__logo .en {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .hd__nav {
    flex: 1 1 auto;
    min-width: 0;
  }

  .hd__nav ul {
    display: flex;
    justify-content: flex-end;
    flex-wrap: nowrap;
    gap: clamp(12px, 1.7vw, 26px);
  }

  .hd__nav a {
    display: block;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    color: var(--text);
    padding-block: 6px;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .hd__nav a:hover,
  .hd__nav a[aria-current="page"] {
    color: var(--brand);
    border-bottom-color: var(--brand);
  }

  .hd__right {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hd__cta {
    min-height: 38px;
    font-size: 0.92rem;
    padding-inline: 1.2em;
  }

  .hd__burger {
    display: none;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: transparent;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .hd__burger span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--text);
  }

  .hd__burger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .hd__burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .hd__burger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }
  .hd__burger span {
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .drawer {
    position: fixed;
    inset: var(--header-h) 0 0;
    background: var(--bg);
    overflow-y: auto;
    padding: 8px var(--page-pad) 48px;
  }

  .drawer__list li + li {
    border-top: 1px solid var(--border);
  }

  .drawer__list a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 18px 2px;
  }

  .drawer__list .en {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
  }

  .drawer__jp {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  /* ナビが1行に収まらなくなる幅でドロワーへ切り替える */
  @media (max-width: 1100px) {
    .hd__nav {
      display: none;
    }
    .hd__burger {
      display: flex;
    }
  }

  @media (max-width: 520px) {
    .hd__cta {
      display: none;
    }
  }
</style>
