---
import { site } from "../config/site";
import { getNav } from "../lib/nav";
import SnsIcons from "./SnsIcons.astro";

const allNav = await getNav();
const path = Astro.url.pathname;

/** 右のCTAボタンと同じ行き先は、デスクトップの並びからだけ外す（同じものを2回出さない）。
    モバイルはCTAボタンが隠れるので、ドロワーには全項目を残す。 */
const barNav = allNav.filter((item) => item.href !== site.headerCta?.href);

/** 親ページ（/contents/ など）は、その配下にいるあいだ点灯させる */
const isCurrent = (href: string) => {
  if (href.startsWith("/#")) return false;
  const h = href.endsWith("/") ? href : `${href}/`;
  return path === h || path === h.slice(0, -1);
};
---

<header class="hd">
  <div class="hd__bar">
    <a class="hd__logo" href="/">
      {
        site.logo ? (
          <img
            src={site.logo}
            alt={site.name}
            width={site.logoSize.w}
            height={site.logoSize.h}
          />
        ) : (
          <span class="en">{site.name}</span>
        )
      }
    </a>

    <nav class="hd__nav" aria-label="メインメニュー">
      <ul>
        {
          barNav.map((item) => (
            <li class:list={["hd__item", item.children.length > 0 && "has-children"]}>
              <a
                href={item.href}
                class="en hd__link"
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>

              {item.children.length > 0 && (
                <div class="hd__sub">
                  <ul class="hd__sub__inner">
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href}>{c.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hd__right">
      <SnsIcons class="hd__sns" size={24} />
      {
        site.headerCta && (
          <a class="btn hd__cta" href={site.headerCta.href}>
            {site.headerCta.label}
          </a>
        )
      }
      <button
        class="hd__burger"
        type="button"
        aria-label="メニューを開く"
        aria-expanded="false"
        aria-controls="drawer"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- モバイル用ドロワー -->
  <div class="drawer" id="drawer" hidden>
    <ul class="drawer__list">
      {
        allNav.map((item) => (
          <li>
            <a class="drawer__parent" href={item.href}>
              <span class="en">{item.label}</span>
              <span class="drawer__jp">{item.jp}</span>
            </a>
            {item.children.length > 0 && (
              <ul class="drawer__children">
                {item.children.map((c) => (
                  <li>
                    <a href={c.href}>{c.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".hd");
  const burger = header?.querySelector<HTMLButtonElement>(".hd__burger");
  const drawer = header?.querySelector<HTMLElement>(".drawer");

  const setOpen = (open: boolean) => {
    if (!burger || !drawer) return;
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
    drawer.hidden = !open;
    document.body.style.overflow = open ? "hidden" : "";

    // お知らせの帯があるとヘッダーが下がるので、その下から開く。
    // 決め打ちだと閉じるボタンにかぶって、メニューから戻れなくなる
    if (open && header) {
      drawer.style.top = `${Math.max(0, Math.round(header.getBoundingClientRect().bottom))}px`;
    } else {
      drawer.style.top = "";
    }
  };

  burger?.addEventListener("click", () => {
    setOpen(burger.getAttribute("aria-expanded") !== "true");
  });

  drawer?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  // 開いたまま画面の大きさが変わっても、ヘッダーの下に付いてくる
  addEventListener("resize", () => {
    if (burger?.getAttribute("aria-expanded") === "true") setOpen(true);
  });

  // 少しでもスクロールしたら背景を敷いて可読性を確保する
  const onScroll = () =>
    header?.classList.toggle("is-scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  /* 子メニューの帯は画面幅いっぱいだが、中身は押した項目の真下から始めたい。
     位置は文字幅で変わるので、実測してCSS変数で渡す。 */
  const bar = header?.querySelector<HTMLElement>(".hd__bar");

  const placeSubMenus = () => {
    if (!header || !bar) return;
    const pad = parseFloat(getComputedStyle(bar).paddingLeft) || 20;
    const headerLeft = header.getBoundingClientRect().left;

    header
      .querySelectorAll<HTMLElement>(".hd__item.has-children")
      .forEach((item) => {
        const link = item.querySelector<HTMLElement>(".hd__link");
        const inner = item.querySelector<HTMLElement>(".hd__sub__inner");
        if (!link || !inner) return;

        // いったん左端に戻してから、中身の実寸を測る
        item.style.setProperty("--sub-x", "0px");
        const width = inner.getBoundingClientRect().width;

        // 押した項目の中心と、中身の中心を合わせる
        const linkRect = link.getBoundingClientRect();
        const center = linkRect.left - headerLeft + linkRect.width / 2;
        const wanted = center - width / 2;

        // 画面からはみ出すときは、収まる位置まで寄せる
        const limit = Math.max(pad, window.innerWidth - width - pad);
        item.style.setProperty(
          "--sub-x",
          `${Math.round(Math.max(pad, Math.min(wanted, limit)))}px`
        );
      });
  };

  placeSubMenus();
  window.addEventListener("resize", placeSubMenus);
  // 書体が入れ替わると文字幅が変わるので測り直す
  document.fonts?.ready.then(placeSubMenus);
</script>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 50;
    background: transparent;
    transition: background 0.25s ease, border-color 0.25s ease;
    border-bottom: 1px solid transparent;
  }

  .hd.is-scrolled {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom-color: var(--border);
  }

  .hd__bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--header-h);
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--page-pad);
  }

  .hd__logo {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
  }

  .hd__logo img {
    /* 実寸ではなく高さで揃える。差し替えても収まりが変わらない */
    height: 34px;
    width: auto;
  }

  @media (max-width: 400px) {
    .hd__logo img {
      height: 28px;
    }
  }

  .hd__logo .en {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .hd__nav {
    flex: 1 1 auto;
    min-width: 0;
  }

  .hd__nav > ul {
    display: flex;
    justify-content: flex-end;
    gap: clamp(18px, 2.4vw, 38px);
  }

  .hd__item {
    /* 子メニューを画面幅の帯として出すため、基準はヘッダー側に持たせる */
    position: static;
  }

  .hd__link {
    position: relative;
    display: block;
    font-size: 1.02rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    color: var(--text);
    /* 下に伸びる余白がそのまま子メニューへの通り道になる。
       下線は余白の底ではなく文字のすぐ下に引きたいので、罫線ではなく
       擬似要素で位置を決める */
    padding: 22px 0;
    transition: color 0.2s ease;
  }

  .hd__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    height: 2px;
    background: transparent;
    transition: background 0.2s ease;
  }

  /* 帯にマウスが移っているあいだも、親は点いたままにする */
  .hd__item:hover .hd__link,
  .hd__link[aria-current="page"] {
    color: var(--brand);
  }

  .hd__item:hover .hd__link::after,
  .hd__link[aria-current="page"]::after {
    background: var(--brand);
  }

  /* ---- 子メニュー ----
     カードで浮かせず、ヘッダーの続きとして画面幅の帯を降ろす。
     ページの左右マージンに揃うので、ナビと本文の目線が動かない。 */
  .hd__sub {
    position: absolute;
    top: var(--header-h);
    left: 0;
    right: 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    opacity: 0;
    visibility: hidden;
    translate: 0 -6px;
    transition: opacity 0.18s ease, translate 0.18s ease, visibility 0.18s;
  }

  .hd__item:hover .hd__sub,
  .hd__item:focus-within .hd__sub {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
  }

  .hd__sub__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px clamp(18px, 2.6vw, 40px);
    /* 押した項目の中心に合わせて置く。位置はスクリプトから受け取る */
    width: max-content;
    max-width: calc(100% - clamp(20px, 4vw, 48px) * 2);
    margin-left: var(--sub-x, 0px);
    padding-block: 16px;
    transition: margin-left 0.18s ease;
  }

  .hd__sub a {
    display: block;
    padding-block: 4px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
    border-bottom: 1px solid transparent;
    transition: color 0.16s ease, border-color 0.16s ease;
  }

  .hd__sub a:hover {
    color: var(--brand);
    border-bottom-color: var(--brand);
  }

  .hd__right {
    flex: 0 0 auto;
    /* ナビが隠れるスマホ幅でも、右端に寄せたままにする */
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hd__sns {
    margin-right: -6px;
  }

  .hd__cta {
    min-height: 38px;
    font-size: 0.92rem;
    padding-inline: 1.2em;
  }

  .hd__burger {
    display: none;
    /* 枠は持たないが、指で押せる大きさは確保しておく */
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .hd__burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .hd__burger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hd__burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .hd__burger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ---- モバイル ---- */
  .drawer {
    position: fixed;
    inset: var(--header-h) 0 0;
    background: var(--bg);
    overflow-y: auto;
    padding: 8px var(--page-pad) 48px;
  }

  .drawer__list > li + li {
    border-top: 1px solid var(--border);
  }

  .drawer__parent {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 18px 2px 10px;
  }

  .drawer__parent .en {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
  }

  .drawer__jp {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  /* 子項目は、親からぶら下がる一覧として縦に並べる */
  .drawer__children {
    margin: 0 0 16px;
    padding-left: 16px;
    border-left: 1px solid var(--border);
  }

  .drawer__children a {
    display: block;
    padding: 9px 0;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--text-muted);
    transition: color 0.16s ease;
  }

  .drawer__children a:hover {
    color: var(--brand);
  }

  @media (max-width: 900px) {
    .hd__nav {
      display: none;
    }
    .hd__burger {
      display: flex;
    }
  }

  @media (max-width: 520px) {
    .hd__cta {
      display: none;
    }
  }
</style>
