---
import { site } from "../config/site";
import { getNav } from "../lib/nav";
import SnsIcons from "./SnsIcons.astro";

const nav = await getNav();
const year = new Date().getFullYear();
---

<footer class="ft">
  <div class="wrap ft__inner">
    <div class="ft__brand">
      <a href="/" class="ft__logo">
        {
          site.logo ? (
            <img src={site.logo} alt={site.name} width="220" height="42" />
          ) : (
            <span class="en">{site.name}</span>
          )
        }
      </a>
      <p class="en ft__tagline">{site.tagline}</p>
      <SnsIcons class="ft__sns" size={22} />
    </div>

    <nav class="ft__nav" aria-label="フッターメニュー">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a class="ft__parent" href={item.href}>
                <span class="en">{item.label}</span>
                <span class="ft__jp">{item.jp}</span>
              </a>
              {item.children.length > 0 && (
                <ul class="ft__children">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="wrap ft__copy">
    <small class="en">© {year} {site.copyright}</small>
    <!-- ナビには置かない、けれど行き止まりにもしないページはここに出す -->
    <ul class="ft__extra">
      <li><a href="/contact/">お問い合わせ</a></li>
    </ul>
  </div>
</footer>

<style>
  .ft {
    margin-top: var(--section-gap);
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .ft__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 72px);
    padding-block: clamp(48px, 7vw, 80px) 40px;
  }

  .ft__logo img {
    height: 34px;
    width: auto;
  }

  .ft__logo .en {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .ft__tagline {
    margin-top: 14px;
    color: var(--brand);
    font-size: 1rem;
    letter-spacing: 0.12em;
  }

  .ft__sns {
    margin-top: 20px;
    margin-left: -8px;
  }

  .ft__nav > ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 28px 24px;
    align-items: start;
  }

  .ft__parent {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .ft__parent .en {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    transition: color 0.2s ease;
  }

  .ft__parent:hover .en {
    color: var(--brand);
  }

  .ft__jp {
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .ft__children {
    margin-top: 10px;
  }

  .ft__children a {
    display: block;
    padding-block: 4px;
    font-size: 0.85rem;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .ft__children a:hover {
    color: var(--brand);
  }

  .ft__copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 20px 28px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }

  .ft__extra {
    display: flex;
    gap: 20px;
  }

  .ft__extra a {
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    transition: color 0.2s ease;
  }

  .ft__extra a:hover {
    color: var(--brand);
  }

  @media (max-width: 760px) {
    .ft__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
