---
import { getSiteInfo } from "../lib/content";
import { site } from "../config/site";
import { getNav } from "../lib/nav";
import SnsIcons from "./SnsIcons.astro";

const allNav = await getNav();

/** ヘッダーと同じ並びにする。ヘッダーではチケットがCTAボタンとして
    いちばん右にあるので、フッターでも最後に置く */
const ctaHref = site.headerCta?.href;
const nav = [
  ...allNav.filter((item) => item.href !== ctaHref),
  ...allNav.filter((item) => item.href === ctaHref),
];

const year = new Date().getFullYear();
const info = await getSiteInfo();
---

<footer class="ft">
  <div class="wrap ft__inner">
    <div class="ft__brand">
      <a href="/" class="ft__logo">
        {
          site.logo ? (
            <img
            src={site.logo}
            alt={site.name}
            width={site.logoSize.w}
            height={site.logoSize.h}
          />
          ) : (
            <span class="en">{site.name}</span>
          )
        }
      </a>
      <p class="ft__tagline">{info.tagline}</p>
      <SnsIcons class="ft__sns" size={22} />
    </div>

    <nav class="ft__nav" aria-label="フッターメニュー">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a class="ft__parent" href={item.href}>
                <span class="en">{item.label}</span>
              </a>
              {item.children.length > 0 && (
                <ul class="ft__children">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="wrap ft__copy">
    <small class="en">© {year} {site.copyright}</small>
  </div>
</footer>

<style>
  .ft {
    /* 直前のセクションが下に余白を持っているので、ここでは足さない
       （足すと地の色の帯が挟まって見える） */
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .ft__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 2fr);
    gap: clamp(32px, 6vw, 72px);
    padding-block: clamp(48px, 7vw, 80px) 40px;
  }

  .ft__logo img {
    height: 42px;
    width: auto;
  }

  .ft__logo .en {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .ft__tagline {
    font-family: var(--font-tagline);
    font-weight: 700;
    margin-top: 14px;
    color: var(--brand);
    font-size: 1.4rem;
    letter-spacing: 0.01em;
  }

  .ft__sns {
    margin-top: 20px;
    margin-left: -8px;
  }

  /* 段組みで流し込む。格子にすると、子の多い項目に行の高さが引っ張られて
     ほかの項目のあいだが間延びする */
  .ft__nav > ul {
    columns: 3 150px;
    column-gap: clamp(20px, 3vw, 36px);
  }

  .ft__nav > ul > li {
    break-inside: avoid;
    margin-bottom: 18px;
  }

  .ft__parent {
    display: block;
  }

  .ft__parent .en {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    transition: color 0.2s ease;
  }

  .ft__parent:hover .en {
    color: var(--brand);
  }

  .ft__children {
    margin-top: 8px;
  }

  .ft__children a {
    display: block;
    padding-block: 4px;
    font-size: 0.85rem;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .ft__children a:hover {
    color: var(--brand);
  }

  .ft__copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 20px 28px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }

  @media (max-width: 760px) {
    .ft__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
