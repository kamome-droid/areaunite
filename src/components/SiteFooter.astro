---
import { site, nav } from "../config/site";
const year = new Date().getFullYear();
const snsEntries = Object.entries(site.sns).filter(([, v]) => v);
---

<footer class="ft">
  <div class="wrap ft__inner">
    <div class="ft__brand">
      <a href="/" class="ft__logo">
        {
          site.logo ? (
            <img src={site.logo} alt={site.name} width="220" height="42" />
          ) : (
            <span class="en">{site.name}</span>
          )
        }
      </a>
      <p class="en ft__tagline">{site.tagline}</p>
      {
        snsEntries.length > 0 && (
          <ul class="ft__sns">
            {snsEntries.map(([key, url]) => (
              <li>
                <a href={url} target="_blank" rel="noopener noreferrer" class="en">
                  {key}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <nav class="ft__nav" aria-label="フッターメニュー">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>
                <span class="en">{item.label}</span>
                {item.jp && <span class="ft__jp">{item.jp}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="wrap ft__copy">
    <small class="en">© {year} {site.copyright}</small>
  </div>
</footer>

<style>
  .ft {
    margin-top: var(--section-gap);
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .ft__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 72px);
    padding-block: clamp(48px, 7vw, 80px) 40px;
  }

  .ft__logo img {
    height: 34px;
    width: auto;
  }

  .ft__logo .en {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .ft__tagline {
    margin-top: 14px;
    color: var(--brand);
    font-size: 1rem;
    letter-spacing: 0.12em;
  }

  .ft__sns {
    display: flex;
    gap: 10px;
    margin-top: 22px;
  }

  .ft__sns a {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding-inline: 1em;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    font-size: 0.85rem;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .ft__sns a:hover {
    border-color: var(--brand);
    color: var(--brand);
  }

  .ft__nav ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 2px 24px;
  }

  .ft__nav a {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding-block: 8px;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .ft__nav a:hover {
    color: var(--brand);
  }

  .ft__nav .en {
    font-size: 1rem;
    color: var(--text);
  }

  .ft__nav a:hover .en {
    color: var(--brand);
  }

  .ft__jp {
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .ft__copy {
    padding-block: 20px 28px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }

  @media (max-width: 760px) {
    .ft__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
