---
/**
 * 一時的なお知らせの帯。アンケートの依頼、チケット発売、台風の告知など、
 * 「今だけ全ページで伝えたいこと」に使う。文言が空なら何も出ない。
 * ヘッダーの上に置き、スクロールすると流れて消える。
 */
interface Props {
  text?: string;
  label?: string;
  href?: string;
}
const { text, label, href } = Astro.props;
const linked = Boolean(href && label);
---

{
  text && (
    <div class="notice">
      <div class="wrap notice__inner">
        <p class="notice__text">{text}</p>
        {linked && (
          <a class="notice__link" href={href}>
            {label}
          </a>
        )}
      </div>
    </div>
  )
}

<style>
  .notice {
    background: var(--brand);
    color: var(--brand-ink);
  }

  .notice__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 16px;
    padding-block: 10px;
    text-align: center;
  }

  .notice__text {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .notice__link {
    flex: none;
    padding-bottom: 1px;
    border-bottom: 1px solid currentColor;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .notice__link:hover {
    opacity: 0.7;
  }
</style>
