---
import ImagePlaceholder from "./ImagePlaceholder.astro";

/** 一覧に並ぶカード1枚。画像・サブタイトル・タイトル・本文・リンク。 */
interface Props {
  /** スケジュールなど他の場所から名指しで飛んでくるためのID */
  id?: string;
  /** 個別ページのパス。あるとカード全体がその項目へのリンクになる */
  detailHref?: string | null;
  title: string;
  subtitle?: string;
  /** 上映日など */
  date?: string;
  time?: string;
  /** 上映時間 */
  runtime?: string;
  image?: string;
  link?: string;
  linkLabel?: string;
  ratio?: string;
}

const {
  id,
  detailHref,
  title,
  subtitle,
  date,
  time,
  runtime,
  image,
  link,
  linkLabel = "詳しく見る",
  ratio = "4 / 3",
} = Astro.props;

const external = Boolean(link && /^https?:\/\//.test(link));
---

<article class="card" id={id}>
  <div class="card__media" style={`aspect-ratio:${ratio}`}>
    {
      image ? (
        <img src={image} alt="" loading="lazy" decoding="async" />
      ) : (
        <ImagePlaceholder />
      )
    }
  </div>

  <div class="card__body">
    {subtitle && <p class="card__sub">{subtitle}</p>}
    <h3 class="card__title">
      {
        detailHref ? (
          <a href={detailHref} data-modal>
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    <div class="card__text prose">
      <slot />
    </div>
    {
      (date || time || runtime) && (
        <p class="card__when num">
          {date && <span>{date}</span>}
          {time && <span class="card__time">{time}</span>}
          {runtime && (
            <span class="card__runtime">
              <span class="en card__runtime-label">Runtime</span> {runtime}
            </span>
          )}
        </p>
      )
    }

    {
      link && (
        <a
          class="en card__link"
          href={link}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener noreferrer" : undefined}
        >
          {linkLabel}
          <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</article>



<style>
  .card {
    /* 全面リンクの基準。指定がないと当たり判定がカードの外へ広がる */
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    border-color: var(--border-strong);
  }

  .card:has(.card__title a):hover {
    border-color: var(--brand);
  }

  .card__media {
    position: relative;
    background: var(--surface-2);
    overflow: hidden;
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card:hover .card__media img {
    transform: scale(1.03);
  }

  /* 上映日時。本文のあとに置き、下端で揃える */
  .card__when {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: auto;
    padding-top: 18px;
    color: var(--brand);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.4;
  }

  .card__time {
    font-size: 1.25rem;
  }

  /* 数字が並ぶので、上映時間だけはラベルを添えて取り違えないようにする */
  .card__runtime {
    color: var(--text-muted);
    font-weight: 400;
  }

  .card__runtime-label {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
  }

  .card__body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    padding: 20px 20px 22px;
  }

  .card__sub {
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: var(--brand);
    line-height: 1.6;
  }

  .card__title {
    margin-top: 4px;
    font-size: 1.12rem;
    font-weight: 700;
    line-height: 1.55;
  }

  /* 一覧では紹介文の頭だけ見せる。続きは個別ページで読ませる */
  .card__text {
    margin-top: 10px;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.85;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  /* 一覧から名指しで戻ってきたとき、どれを見ていたのか分かるようにする */
  .card:target {
    border-color: var(--brand);
  }

  /* タイトルのリンクをカード全面に広げる */
  .card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card__title a:hover {
    color: var(--brand);
  }

  .card__text:empty {
    display: none;
  }

  .card__link {
    margin-top: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    color: var(--brand);
  }

  .card__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
