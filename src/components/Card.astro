---
/** 一覧に並ぶカード1枚。画像・サブタイトル・タイトル・本文・リンク。 */
interface Props {
  /** スケジュールなど他の場所から名指しで飛んでくるためのID */
  id?: string;
  title: string;
  subtitle?: string;
  /** 上映日など */
  date?: string;
  time?: string;
  image?: string;
  link?: string;
  linkLabel?: string;
  ratio?: string;
}

const {
  id,
  title,
  subtitle,
  date,
  time,
  image,
  link,
  linkLabel = "詳しく見る",
  ratio = "4 / 3",
} = Astro.props;

const external = Boolean(link && /^https?:\/\//.test(link));
---

<article class="card" id={id}>
  <div class="card__media" style={`aspect-ratio:${ratio}`}>
    {
      image ? (
        <img src={image} alt="" loading="lazy" decoding="async" />
      ) : (
        <span class="card__ph en" aria-hidden="true">
          {title.slice(0, 1)}
        </span>
      )
    }
  </div>

  <div class="card__body">
    {subtitle && <p class="card__sub">{subtitle}</p>}
    <h3 class="card__title">{title}</h3>
    <div class="card__text prose">
      <slot />
    </div>

    {/* 収まりきらないときだけスクリプトが出す */}
    <button class="card__toggle" type="button" aria-expanded="false" hidden>
      続きを読む
    </button>
    {
      (date || time) && (
        <p class="card__when num">
          {date && <span>{date}</span>}
          {time && <span class="card__time">{time}</span>}
        </p>
      )
    }

    {
      link && (
        <a
          class="en card__link"
          href={link}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener noreferrer" : undefined}
        >
          {linkLabel}
          <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</article>

<script>
  const OPEN_LABEL = "閉じる";
  const CLOSED_LABEL = "続きを読む";

  const setOpen = (card: HTMLElement, open: boolean) => {
    const toggle = card.querySelector<HTMLButtonElement>(".card__toggle");
    card.classList.toggle("is-open", open);
    if (!toggle) return;
    toggle.hidden = false;
    toggle.textContent = open ? OPEN_LABEL : CLOSED_LABEL;
    toggle.setAttribute("aria-expanded", String(open));
  };

  const setup = () => {
    document.querySelectorAll<HTMLElement>(".card").forEach((card) => {
      const text = card.querySelector<HTMLElement>(".card__text");
      const toggle = card.querySelector<HTMLButtonElement>(".card__toggle");
      if (!text || !toggle || toggle.dataset.ready) return;

      // 収まりきっている紹介文にはボタンを出さない
      if (text.scrollHeight - text.clientHeight <= 4) return;

      toggle.dataset.ready = "1";
      toggle.hidden = false;
      toggle.addEventListener("click", () =>
        setOpen(card, !card.classList.contains("is-open"))
      );
    });
  };

  /** スケジュールなどから名指しで飛んできたカードは開いた状態で見せる */
  const openFromHash = () => {
    const id = location.hash.slice(1);
    if (!id) return;
    const card = document.getElementById(id);
    if (card?.classList.contains("card")) setOpen(card, true);
  };

  setup();
  openFromHash();
  // 書体が入れ替わると行数が変わるので測り直す
  document.fonts?.ready.then(setup);
  window.addEventListener("hashchange", openFromHash);
</script>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    border-color: var(--border-strong);
  }

  .card__media {
    position: relative;
    background: var(--surface-2);
    overflow: hidden;
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card:hover .card__media img {
    transform: scale(1.03);
  }

  .card__ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 3rem;
    font-weight: 600;
    color: var(--border-strong);
  }

  /* 上映日時。本文のあとに置き、下端で揃える */
  .card__when {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: auto;
    padding-top: 18px;
    color: var(--brand);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.4;
  }

  .card__time {
    font-size: 1.25rem;
  }

  .card__body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    padding: 20px 20px 22px;
  }

  .card__sub {
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: var(--brand);
    line-height: 1.6;
  }

  .card__title {
    margin-top: 4px;
    font-size: 1.12rem;
    font-weight: 700;
    line-height: 1.55;
  }

  /* 紹介文は既定で数行だけ見せる。長さがまちまちでも並びが崩れない */
  .card__text {
    margin-top: 10px;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.85;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    overflow: hidden;
  }

  .card.is-open .card__text {
    display: block;
    overflow: visible;
  }

  .card__toggle {
    align-self: flex-start;
    margin-top: 10px;
    padding: 4px 0;
    border: 0;
    border-bottom: 1px solid var(--border-strong);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.88rem;
    cursor: pointer;
    transition: color 0.16s ease, border-color 0.16s ease;
  }

  .card__toggle:hover {
    color: var(--brand);
    border-bottom-color: var(--brand);
  }

  /* 名指しで飛んできたカードは、どれを開いたのか分かるようにする */
  .card:target {
    border-color: var(--brand);
  }

  .card__text:empty {
    display: none;
  }

  .card__link {
    margin-top: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    color: var(--brand);
  }

  .card__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
