---
import ImagePlaceholder from "./ImagePlaceholder.astro";
import ItemMeta from "./ItemMeta.astro";

/** 一覧に並ぶカード1枚。画像・サブタイトル・タイトル・本文・リンク。 */
interface Props {
  /** スケジュールなど他の場所から名指しで飛んでくるためのID */
  id?: string;
  /** 個別ページのパス。あるとカード全体がその項目へのリンクになる */
  detailHref?: string | null;
  title: string;
  subtitle?: string;
  /** 上映日など */
  date?: string;
  time?: string;
  /** 上映時間 */
  runtime?: string;
  image?: string;
  link?: string;
  linkLabel?: string;
  ratio?: string;
}

const {
  id,
  detailHref,
  title,
  subtitle,
  date,
  time,
  runtime,
  image,
  link,
  linkLabel = "詳しく見る",
  ratio = "16 / 9",
} = Astro.props;

const external = Boolean(link && /^https?:\/\//.test(link));
---

<article class="card" id={id}>
  <div class="card__media" style={`aspect-ratio:${ratio}`}>
    {
      image ? (
        <img src={image} alt="" loading="lazy" decoding="async" />
      ) : (
        <ImagePlaceholder />
      )
    }
  </div>

  <div class="card__body">
    {subtitle && <p class="card__sub">{subtitle}</p>}
    <h3 class="card__title">
      {
        detailHref ? (
          <a href={detailHref} data-modal>
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    <div class="card__text prose">
      <slot />
    </div>
    <ItemMeta date={date} time={time} runtime={runtime} class="card__when" />

    {
      link && (
        <a
          class="en card__link"
          href={link}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener noreferrer" : undefined}
        >
          {linkLabel}
          <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</article>



<style>
  .card {
    /* 全面リンクの基準。指定がないと当たり判定がカードの外へ広がる */
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    border-color: var(--border-strong);
  }

  .card:has(.card__title a):hover {
    border-color: var(--brand);
  }

  .card__media {
    position: relative;
    background: var(--surface-2);
    overflow: hidden;
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card:hover .card__media img {
    transform: scale(1.03);
  }

  /* 上映日時。本文のあとに置き、下端で揃える */
  .card__when {
    margin-top: auto;
    padding-top: 18px;
  }

  .card__link {
    margin-top: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    color: var(--brand);
  }

  .card__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
