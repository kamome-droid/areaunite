---
/**
 * トップページのKV。見せ方を3通り持つ。
 *
 *  overlay … 画像を全面に敷き、上にイベント名・日付を重ねる。
 *            文字の入っていない写真向け。
 *  band    … KVを切らずに丸ごと見せ、情報は下に置く。
 *            KVにロゴが描き込まれているとき向け。
 *  split   … 左に情報、右にKV。KVを切らずに、情報と1画面にまとめる。
 *            ロゴ入りのKVで、かつヒーローを1かたまりに見せたいとき向け。
 *
 * どの見せ方でも「画像を差し替えるだけ」で成立するよう、KVへの加工は前提にしない。
 */
interface Props {
  image?: string;
  style?: "overlay" | "band" | "split";
  eyebrow?: string;
  title: string;
  catch?: string;
  date?: string;
  venue?: string;
  ctaLabel?: string;
  ctaHref?: string;
  subCtaLabel?: string;
  subCtaHref?: string;
}

const {
  image,
  style = "overlay",
  eyebrow,
  title,
  catch: catchCopy,
  date,
  venue,
  ctaLabel,
  ctaHref,
  subCtaLabel,
  subCtaHref,
} = Astro.props;

const overlay = style === "overlay";
---

<section class={`hero hero--${style}`}>
  {
    /* KVをぼかした光を背面に敷き、情報とKVを同じ空気でつなぐ */
    image && !overlay && (
      <div class="hero__glow" style={`background-image:url(${image})`} aria-hidden="true" />
    )
  }

  <div class="wrap hero__inner">
    <div class="hero__text">
      {
        overlay ? (
          <>
            {eyebrow && <p class="en hero__eyebrow">{eyebrow}</p>}
            <h1 class="en hero__title">{title}</h1>
          </>
        ) : (
          <>
            {/* KVがタイトルを兼ねるので、見出しは読み上げ用にだけ置く */}
            <h1 class="visually-hidden">{title}</h1>
            {eyebrow && <p class="en hero__eyebrow">{eyebrow}</p>}
          </>
        )
      }

      {catchCopy && <p class="hero__catch">{catchCopy}</p>}

      {
        (date || venue) && (
          <dl class="hero__meta">
            {date && (
              <div>
                <dt class="en">Date</dt>
                <dd class="num">{date}</dd>
              </div>
            )}
            {venue && (
              <div>
                <dt class="en">Venue</dt>
                <dd>{venue}</dd>
              </div>
            )}
          </dl>
        )
      }

      {
        (ctaHref || subCtaHref) && (
          <div class="hero__cta">
            {ctaHref && (
              <a class="btn" href={ctaHref}>
                {ctaLabel}
              </a>
            )}
            {subCtaHref && (
              <a class="btn btn--ghost" href={subCtaHref}>
                {subCtaLabel}
              </a>
            )}
          </div>
        )
      }
    </div>

    <div class="hero__media">
      {
        image ? (
          <img src={image} alt={overlay ? "" : title} fetchpriority="high" decoding="async" />
        ) : (
          <div class="hero__ph" aria-hidden="true" />
        )
      }
    </div>
  </div>
</section>

<style>
  /* ---------- 共通 ---------- */
  .hero {
    position: relative;
    /* sticky ヘッダーの下まで敷く */
    margin-top: calc(-1 * var(--header-h));
    isolation: isolate;
    overflow: hidden;
  }

  .hero__glow {
    position: absolute;
    inset: -12%;
    z-index: -3;
    background-size: cover;
    background-position: center;
    filter: blur(80px) saturate(1.6);
    opacity: 0.32;
    pointer-events: none;
    /* 下端で断ち切れると段差に見えるので、地の色へ溶かす */
    mask-image: linear-gradient(to bottom, #000 0%, #000 52%, transparent 92%);
  }

  .hero__ph {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: radial-gradient(
        120% 90% at 20% 15%,
        color-mix(in srgb, var(--brand) 26%, transparent),
        transparent 60%
      ),
      radial-gradient(
        90% 80% at 85% 80%,
        color-mix(in srgb, var(--brand) 14%, transparent),
        transparent 55%
      ),
      var(--surface-2);
  }

  .hero__eyebrow {
    font-size: clamp(0.9rem, 1.6vw, 1.05rem);
    letter-spacing: 0.28em;
    color: var(--brand);
    line-height: 1.4;
  }

  .hero__catch {
    margin-top: 18px;
    max-width: 26em;
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    line-height: 1.85;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 48px;
    margin-top: clamp(26px, 4vw, 40px);
    padding-top: 22px;
    border-top: 1px solid var(--border-strong);
  }

  .hero__meta dt {
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    color: var(--text-muted);
    line-height: 1;
  }

  .hero__meta dd {
    margin: 8px 0 0;
    font-size: clamp(1.15rem, 2.6vw, 1.6rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(26px, 4vw, 36px);
  }

  /* ---------- overlay ---------- */
  .hero--overlay {
    min-height: min(88svh, 820px);
    display: flex;
    align-items: flex-end;
  }

  .hero--overlay .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero--overlay .hero__media img,
  .hero--overlay .hero__ph {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: auto;
  }

  .hero--overlay::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 82%, transparent) 26%,
      color-mix(in srgb, var(--bg) 30%, transparent) 62%,
      color-mix(in srgb, var(--bg) 55%, transparent) 100%
    );
  }

  .hero--overlay .hero__inner {
    padding-top: calc(var(--header-h) + 40px);
    padding-bottom: clamp(48px, 7vw, 84px);
  }

  .hero--overlay .hero__title {
    margin-top: 16px;
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: 0.01em;
  }

  /* ---------- band ---------- */
  .hero--band .hero__media {
    order: -1;
    display: grid;
    place-items: center;
  }

  .hero--band .hero__media img {
    width: auto;
    max-width: min(100%, 1100px);
    max-height: min(72svh, 780px);
    object-fit: contain;
  }

  .hero--band .hero__inner {
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--header-h) + 12px);
    padding-bottom: clamp(40px, 6vw, 64px);
  }

  .hero--band .hero__text {
    margin-top: clamp(28px, 4vw, 44px);
  }

  /* ---------- split ---------- */
  .hero--split {
    display: flex;
    align-items: center;
    min-height: min(92svh, 900px);
  }

  .hero--split .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(28px, 5vw, 64px);
    width: 100%;
    padding-top: calc(var(--header-h) + 24px);
    padding-bottom: clamp(32px, 5vw, 56px);
  }

  .hero--split .hero__media img {
    width: 100%;
    height: auto;
    max-height: min(74svh, 760px);
    object-fit: contain;
  }

  /* 縦並びになる幅では、KVを先に出して画面いっぱいに広げる */
  @media (max-width: 900px) {
    .hero--split {
      min-height: 0;
    }

    .hero--split .hero__inner {
      grid-template-columns: 1fr;
      gap: clamp(24px, 5vw, 36px);
      padding-top: calc(var(--header-h) + 12px);
      padding-bottom: clamp(36px, 7vw, 56px);
    }

    .hero--split .hero__media {
      order: -1;
      /* 左右の余白を打ち消して、KVを画面幅いっぱいに */
      margin-inline: calc(-1 * var(--page-pad));
    }

    .hero--split .hero__media img {
      max-height: none;
    }
  }
</style>
