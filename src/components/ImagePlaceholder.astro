---
/**
 * 画像が未入稿のときに置く枠。
 * 写真が入る場所と大きさが分かるので、素材が揃う前でも仕上がりを判断できる。
 */
interface Props {
  /** 比率。指定がなければ親の高さいっぱい */
  ratio?: string;
}
const { ratio } = Astro.props;
---

<div class="ph" style={ratio ? `aspect-ratio:${ratio}` : undefined} aria-hidden="true">
  <svg viewBox="0 0 48 36" width="48" height="36">
    <rect
      x="1.5"
      y="1.5"
      width="45"
      height="33"
      rx="3"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    />
    <circle cx="14" cy="12.5" r="3.5" fill="currentColor" />
    <path d="M5 30 L18.5 17 L27 24.5 L34 18.5 L43 30 Z" fill="currentColor" />
  </svg>
</div>

<style>
  .ph {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: color-mix(in srgb, var(--text) 16%, transparent);
    /* 斜めの筋を薄く入れて、写真ではなく空き枠だと分かるようにする */
    background-image: repeating-linear-gradient(
      45deg,
      color-mix(in srgb, var(--text) 3%, transparent) 0 8px,
      transparent 8px 16px
    );
    background-color: var(--surface-2);
  }

  .ph svg {
    width: clamp(34px, 12%, 64px);
    height: auto;
  }
</style>
