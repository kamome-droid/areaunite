---
import type { Sheet } from "../../lib/og/templates";

/** SNS画像を並べて、1枚ずつ落とせるようにする */
interface Props {
  sheets: Sheet[];
}
const { sheets } = Astro.props;

/** 一覧は小さい画像で足りる。落とすときだけ原寸を作る */
const thumb = (src: string) => `${src}${src.includes("?") ? "&" : "?"}w=360`;
---

<div class="sheets">
  {
    sheets.map((s) => (
      <div class="sheet">
        <img src={thumb(s.src)} alt="" loading="lazy" width="1080" height="1350" />
        <div class="sheet__foot">
          <div class="sheet__text">
            <span class="sheet__label">{s.label}</span>
            <span class="sheet__note">{s.note}</span>
          </div>
          <a class="btn btn--small" href={s.src} download={`${s.key}.png`}>
            保存
          </a>
        </div>

        {s.caption && (
          <details class="cap">
            <summary>
              キャプション
              <button type="button" class="cap__copy" data-copy={s.caption}>
                コピー
              </button>
            </summary>
            <pre class="cap__text">{s.caption}</pre>
          </details>
        )}
      </div>
    ))
  }
</div>

<script>
  /** キャプションを写す。押したら少しのあいだ「コピーしました」に変える */
  document.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement)?.closest<HTMLButtonElement>("[data-copy]");
    if (!btn) return;
    e.preventDefault();

    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? "");
      const original = btn.textContent;
      btn.textContent = "コピーしました";
      setTimeout(() => (btn.textContent = original), 1600);
    } catch {
      btn.textContent = "コピーできません";
    }
  });
</script>

<style>
  .sheets {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: 18px;
  }

  .sheet {
    display: flex;
    flex-direction: column;
    background: var(--a-panel);
    border: 1px solid var(--a-line);
    border-radius: var(--a-radius);
    overflow: hidden;
  }

  .sheet img {
    display: block;
    width: 100%;
    height: auto;
    background: #111;
  }

  .sheet__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 14px;
    border-top: 1px solid var(--a-line);
  }

  .sheet__text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  /* 幅が狭いカードでも、ボタンの文字を折り返さない */
  .sheet__foot .btn {
    flex: none;
    white-space: nowrap;
  }

  .sheet__label,
  .sheet__note {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sheet__label {
    font-size: 14px;
    font-weight: 700;
  }

  .sheet__note {
    font-size: 12px;
    color: var(--a-muted);
  }

  /* SNSに貼る文章の下書き */
  .cap {
    border-top: 1px solid var(--a-line);
  }

  .cap summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 14px;
    font-size: 12px;
    color: var(--a-muted);
    cursor: pointer;
  }

  .cap__copy {
    padding: 4px 10px;
    border: 1px solid var(--a-line);
    border-radius: 999px;
    background: #fff;
    font: inherit;
    font-size: 11px;
    white-space: nowrap;
    cursor: pointer;
  }

  .cap__copy:hover {
    border-color: var(--a-ink);
  }

  .cap__text {
    max-height: 220px;
    margin: 0;
    padding: 0 14px 14px;
    overflow: auto;
    font: inherit;
    font-size: 12px;
    line-height: 1.7;
    white-space: pre-wrap;
    color: var(--a-ink);
  }
</style>
