---
import ImagePlaceholder from "./ImagePlaceholder.astro";

/** 一覧の1行（時刻つきのラインナップ向け）。左に時刻、次にサムネイル、右に情報。 */
interface Props {
  title: string;
  subtitle?: string;
  time?: string;
  image?: string;
  link?: string;
  linkLabel?: string;
}

const { title, subtitle, time, image, link, linkLabel = "詳しく" } = Astro.props;
const external = Boolean(link && /^https?:\/\//.test(link));
---

<article class="row">
  {time && <p class="row__time num">{time}</p>}

  <div class="row__thumb">
    {
      image ? (
        <img src={image} alt="" loading="lazy" decoding="async" />
      ) : (
        <ImagePlaceholder />
      )
    }
  </div>

  <div class="row__body">
    {subtitle && <p class="row__sub">{subtitle}</p>}
    <h3 class="row__title">{title}</h3>
    <div class="row__text prose"><slot /></div>
  </div>

  {
    link && (
      <a
        class="en row__link"
        href={link}
        target={external ? "_blank" : undefined}
        rel={external ? "noopener noreferrer" : undefined}
      >
        {linkLabel}
        <span aria-hidden="true">→</span>
      </a>
    )
  }
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: 72px 148px minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px;
    padding: 14px 20px 14px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color 0.2s ease;
  }

  .row:hover {
    border-color: var(--border-strong);
  }

  .row__time {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--brand);
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .row__thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .row__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .row__sub {
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: var(--brand);
    line-height: 1.6;
  }

  .row__title {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.6;
  }

  .row__text {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.8;
  }

  .row__text:empty {
    display: none;
  }

  .row__link {
    font-size: 0.88rem;
    color: var(--brand);
    white-space: nowrap;
  }

  /* 時刻がない行でも列が崩れないよう、狭い幅では積む */
  @media (max-width: 860px) {
    .row {
      grid-template-columns: 96px minmax(0, 1fr);
      align-items: start;
      row-gap: 12px;
    }
    .row__time {
      grid-column: 1 / -1;
    }
    .row__link {
      grid-column: 2;
    }
  }

  @media (max-width: 520px) {
    .row {
      grid-template-columns: 1fr;
    }
    .row__thumb {
      max-width: 100%;
    }
    .row__link {
      grid-column: 1;
    }
  }
</style>
