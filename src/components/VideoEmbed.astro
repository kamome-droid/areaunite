---
import { embedUrl } from "../lib/content";

/** 動画の埋め込み。YouTube / Vimeo のURLをそのまま渡せばよい。
    対応外のURLや未設定のときは何も出さない。 */
interface Props {
  url?: string;
  title?: string;
}
const { url, title = "動画" } = Astro.props;
const src = embedUrl(url);
---

{
  src && (
    <div class="embed">
      <iframe
        src={src}
        title={title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      />
    </div>
  )
}

<style>
  .embed {
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
