---
import type { ProgramBlock } from "../lib/content";

/** 当日のプログラム。「部」ごとに見出しを立て、その下に時刻と内容を並べる。 */
interface Props {
  blocks: ProgramBlock[];
}
const { blocks } = Astro.props;
---

<div class="tt">
  {
    blocks.map((block) => (
      <section class="tt__block">
        {block.part && <h3 class="tt__part">{block.part}</h3>}
        <ol class="tt__list">
          {block.items.map((s, i) => (
            <li class="tt__row">
              {/* 同じ時刻が続くときは時刻を繰り返さない（20:55に3本 など） */}
              <p class="tt__time num">
                {i > 0 && block.items[i - 1].time === s.time ? "" : s.time}
              </p>
              <div class="tt__body">
                <p class="tt__title">
                  {s.href ? <a href={s.href} data-modal>{s.title}</a> : s.title}
                </p>
                {(s.credit || s.tag) && (
                  <p class="tt__meta">
                    {s.credit && <span class="tt__credit">{s.credit}</span>}
                    {s.tag && <span class="tt__tag">{s.tag}</span>}
                  </p>
                )}
                {s.note && <p class="tt__note muted">{s.note}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .tt__block + .tt__block {
    margin-top: clamp(36px, 5vw, 56px);
  }

  .tt__part {
    margin-bottom: 14px;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.6vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.3;
    color: var(--brand);
  }

  .tt__list {
    border-top: 1px solid var(--border);
  }

  /* 先頭のかたまりは、上に見出しの罫線があるので引かない */
  .tt__block:first-child .tt__list {
    border-top: 0;
  }

  .tt__row {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    gap: 8px 24px;
    padding-block: 16px;
    border-bottom: 1px solid var(--border);
  }

  /* 時刻が省かれた行は、上の行と地続きに見えるよう罫線を薄くする */
  .tt__row:has(.tt__time:empty) {
    border-top: 0;
    padding-top: 0;
    margin-top: -8px;
  }

  .tt__time {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--brand);
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  /* 分類。ムービー / DJ など */
  /* タイトルの下に、制作者・登壇者と分類を並べる */
  .tt__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin-top: 4px;
  }

  .tt__credit {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .tt__tag {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--brand);
  }

  .tt__title {
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.7;
  }

  .tt__title a {
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 1px;
    transition: color 0.16s ease, border-color 0.16s ease;
  }

  .tt__title a:hover {
    color: var(--brand);
    border-bottom-color: var(--brand);
  }

  .tt__note {
    margin-top: 4px;
    font-size: 0.86rem;
  }

  @media (max-width: 600px) {
    .tt__row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .tt__time {
      font-size: 1.15rem;
    }
    .tt__time:empty {
      display: none;
    }
  }
</style>
