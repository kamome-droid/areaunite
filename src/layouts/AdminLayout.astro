---
import { collections, menu } from "../lib/admin/schema";

/**
 * 管理画面の外枠。公開ページとは別の見た目にしている。
 * 編集中の画面と、公開されているサイトを取り違えないようにするため。
 */
interface Props {
  title: string;
  current?: string;
  /** 画面の説明。何を編集する場所か1行で伝える */
  intro?: string;
}
const { title, current, intro } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{`${title}｜AREA UNITE 管理`}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="shell">
      <aside class="side">
        <a class="side__home" href="/admin/">AREA UNITE<span>管理画面</span></a>

        <nav class="side__nav">
          {
            menu.map((key) => (
              <a
                href={`/admin/${key}/`}
                aria-current={current === key ? "page" : undefined}
              >
                {collections[key].label}
              </a>
            ))
          }
        </nav>

        <div class="side__foot">
          <a href="/" target="_blank" rel="noopener">サイトを見る ↗</a>
          <form method="post" action="/api/admin/logout">
            <button type="submit">ログアウト</button>
          </form>
        </div>
      </aside>

      <main class="main">
        <header class="head">
          <h1>{title}</h1>
          {intro && <p class="head__intro">{intro}</p>}
        </header>
        <slot />
      </main>
    </div>

    <style is:global>
      :root {
        --a-bg: #f6f6f4;
        --a-panel: #ffffff;
        --a-ink: #1b1b1e;
        --a-muted: #6d6d76;
        --a-line: #dedee2;
        --a-accent: #b8860b;
        --a-danger: #b3261e;
        --a-radius: 8px;
        --a-side: 216px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--a-bg);
        color: var(--a-ink);
        font-family: "Hiragino Sans", "Noto Sans JP", system-ui, sans-serif;
        font-size: 15px;
        line-height: 1.7;
      }

      a {
        color: inherit;
      }

      .shell {
        display: grid;
        grid-template-columns: var(--a-side) minmax(0, 1fr);
        min-height: 100vh;
      }

      /* ---- 左のメニュー ---- */
      .side {
        position: sticky;
        top: 0;
        align-self: start;
        height: 100vh;
        display: flex;
        flex-direction: column;
        padding: 20px 14px;
        background: var(--a-ink);
        color: #fff;
      }

      .side__home {
        display: block;
        padding: 0 8px 18px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-decoration: none;
      }

      .side__home span {
        display: block;
        font-size: 11px;
        font-weight: 400;
        letter-spacing: 0.16em;
        color: #9b9ba3;
      }

      .side__nav {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .side__nav a {
        padding: 10px 12px;
        border-radius: var(--a-radius);
        color: #d7d7dc;
        text-decoration: none;
      }

      .side__nav a:hover {
        background: rgb(255 255 255 / 0.08);
        color: #fff;
      }

      .side__nav a[aria-current] {
        background: #fff;
        color: var(--a-ink);
        font-weight: 700;
      }

      .side__foot {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 0 12px;
        font-size: 13px;
      }

      .side__foot a,
      .side__foot button {
        padding: 0;
        border: 0;
        background: none;
        color: #9b9ba3;
        font: inherit;
        text-align: left;
        text-decoration: none;
        cursor: pointer;
      }

      .side__foot a:hover,
      .side__foot button:hover {
        color: #fff;
      }

      /* ---- 本体 ---- */
      .main {
        padding: 28px clamp(20px, 4vw, 44px) 80px;
        max-width: 1000px;
      }

      .head {
        margin-bottom: 24px;
      }

      .head h1 {
        margin: 0;
        font-size: 24px;
        letter-spacing: 0.02em;
      }

      .head__intro {
        margin: 8px 0 0;
        max-width: 60ch;
        color: var(--a-muted);
        font-size: 13.5px;
      }

      /* ---- 共通部品 ---- */
      .panel {
        background: var(--a-panel);
        border: 1px solid var(--a-line);
        border-radius: var(--a-radius);
        padding: 20px;
      }

      .panel + .panel {
        margin-top: 16px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 38px;
        padding: 0 16px;
        border: 1px solid var(--a-ink);
        border-radius: var(--a-radius);
        background: var(--a-ink);
        color: #fff;
        font: inherit;
        font-size: 14px;
        text-decoration: none;
        cursor: pointer;
      }

      .btn--ghost {
        background: transparent;
        color: var(--a-ink);
        border-color: var(--a-line);
      }

      .btn--danger {
        background: transparent;
        border-color: var(--a-danger);
        color: var(--a-danger);
      }

      .btn:disabled {
        opacity: 0.5;
        cursor: default;
      }

      @media (max-width: 720px) {
        .shell {
          grid-template-columns: 1fr;
        }

        .side {
          position: static;
          height: auto;
          flex-direction: row;
          align-items: center;
          gap: 12px;
          overflow-x: auto;
        }

        .side__home {
          padding: 0 8px 0 0;
        }

        .side__nav {
          flex-direction: row;
        }

        .side__foot {
          margin: 0 0 0 auto;
          flex-direction: row;
          gap: 12px;
        }
      }
    </style>
  </body>
</html>
