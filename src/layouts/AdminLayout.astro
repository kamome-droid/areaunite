---
import { collections, menu, tools } from "../lib/admin/schema";
import { readOne } from "../lib/admin/store";
import { pageOfScreen, type PageKey } from "../lib/visibility";
import "../styles/admin.css";

/**
 * 管理画面の外枠。公開ページとは別の見た目にしている。
 * 編集中の画面と、公開されているサイトを取り違えないようにするため。
 */
interface Props {
  title: string;
  current?: string;
  /** プレビューを横に並べる画面は幅いっぱいを使う */
  wide?: boolean;
  /** ページ全体の公開・非公開のスイッチを出すか。
      ページそのものを編集する画面だけに出す（コンテンツ1件の画面に出すと、
      その1件だけを隠すスイッチに見えてしまうため） */
  pageSwitch?: boolean;
}
const { title, current, wide = false, pageSwitch = false } = Astro.props;

/** 準備中にしているページ。メニューに印を付け、該当する画面の上部に切り替えを出す */
let hiddenPages: PageKey[] = [];
try {
  const top = collections.top;
  hiddenPages = ((await readOne(top, top.singleton!))?.data.hiddenPages ?? []) as PageKey[];
} catch {
  /* 読めなくても画面は出す。切り替えは保存時にエラーで知らせる */
}
const page = pageSwitch && current ? pageOfScreen[current] : undefined;
const pageHidden = !!page && hiddenPages.includes(page);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{`${title}｜AREA UNITE 管理`}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="shell">
      <aside class="side">
        <a class="side__home" href="/admin/">AREA UNITE<span>管理画面</span></a>

        <nav class="side__nav">
          {
            menu.map((key) => (
              <a
                href={`/admin/${key}/`}
                aria-current={current === key ? "page" : undefined}
              >
                {collections[key].label}
                {pageOfScreen[key] && hiddenPages.includes(pageOfScreen[key]) && (
                  <span class="side__chip">非公開</span>
                )}
              </a>
            ))
          }
          {
            tools.map((t) => (
              <a href={t.href} aria-current={current === t.key ? "page" : undefined}>
                {t.label}
              </a>
            ))
          }
        </nav>

        <div class="side__foot">
          <a href="/" target="_blank" rel="noopener">サイトを見る ↗</a>
          <form method="post" action="/api/admin/logout">
            <button type="submit">ログアウト</button>
          </form>
        </div>
      </aside>

      <main class:list={["main", wide && "main--wide"]}>
        <header class="head">
          <h1>{title}</h1>
        </header>
        {
          page && (
            <div class:list={["pub", pageHidden && "pub--hidden"]} data-page={page}>
              <button
                type="button"
                class="pub__switch"
                role="switch"
                aria-checked={pageHidden ? "false" : "true"}
                aria-label="このページを公開する"
              >
                <span class="pub__track" aria-hidden="true"><span class="pub__thumb" /></span>
                <span class="pub__state">{pageHidden ? "非公開" : "公開中"}</span>
              </button>
              <p class="pub__text">
                {pageHidden
                  ? "サイトでは「COMING SOON」と表示されています。プレビューでは中身を確認できます。"
                  : "サイトに表示されています。"}
              </p>
            </div>
          )
        }
        <slot />
      </main>

    <dialog id="ask" class="ask">
      <p id="askText" class="ask__text" />
      <div class="ask__btns">
        <button type="button" class="btn btn--ghost" data-ask="no">やめる</button>
        <button type="button" class="btn btn--danger" data-ask="yes">削除する</button>
      </div>
    </dialog>

    <script is:inline>
      /**
       * 保存したコミットが公開サイトに反映されるのを待つ。
       * 本番は保存するたびにサイトを作り直すので、1〜2分かかる。
       * live … 反映されたとき / slow … 5分たっても反映されないとき
       */
      window.adminWaitLive = (commit, { live = () => {}, slow = () => {} } = {}) => {
        const started = Date.now();
        let warned = false;
        const tick = async () => {
          const res = await fetch(`/api/admin/live?commit=${encodeURIComponent(commit)}`).catch(() => null);
          const { live: done } = res?.ok ? await res.json() : { live: null };
          const waited = Date.now() - started;
          // 判断できない環境では、作り直しにかかる時間だけ待って読み直す
          if (done === true || (done === null && waited > 90_000)) return live();
          if (!warned && waited > 5 * 60_000) {
            warned = true;
            slow();
          }
          if (waited < 15 * 60_000) setTimeout(tick, 5000);
        };
        setTimeout(tick, commit === "local" ? 0 : 5000);
      };
    </script>

    <script is:inline>
      /** ページの公開・非公開。押した時点で保存する */
      (() => {
        const box = document.querySelector(".pub");
        if (!box) return;
        const button = box.querySelector(".pub__switch");
        const state = box.querySelector(".pub__state");
        const text = box.querySelector(".pub__text");
        const draw = (hidden) => {
          box.classList.toggle("pub--hidden", hidden);
          button.setAttribute("aria-checked", hidden ? "false" : "true");
          state.textContent = hidden ? "非公開" : "公開中";
          const chip = document.querySelector('.side__nav [aria-current="page"] .side__chip');
          if (hidden && !chip) {
            const c = document.createElement("span");
            c.className = "side__chip";
            c.textContent = "非公開";
            document.querySelector('.side__nav [aria-current="page"]')?.append(c);
          } else if (!hidden) chip?.remove();
        };
        button.addEventListener("click", async () => {
          const hidden = !box.classList.contains("pub--hidden");
          button.disabled = true;
          text.textContent = "切り替えています…";
          try {
            const res = await fetch("/api/admin/visibility", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ page: box.dataset.page, hidden }),
            });
            if (!res.ok) throw new Error(await res.text());
            const { commit } = await res.json();
            draw(hidden);
            const done = hidden
              ? "非公開にしました。サイトでは「COMING SOON」と表示されます。"
              : "公開しました。サイトに表示されます。";
            if (!commit) {
              text.textContent = done;
            } else {
              text.textContent = hidden
                ? "非公開にしています…（サイトに反映されるまで1〜2分）"
                : "公開しています…（サイトに反映されるまで1〜2分）";
              window.adminWaitLive(commit, {
                live: () => {
                  text.textContent = done;
                  // 右のプレビューも読み直す（管理画面からは中身が見えるので、帯の有無だけ変わる）
                  document.getElementById("reload")?.click();
                },
                slow: () => (text.textContent = "切り替えは保存できています。サイトへの反映に時間がかかっています。"),
              });
            }
          } catch (e) {
            text.textContent = `切り替えられませんでした：${e.message}`;
          } finally {
            button.disabled = false;
          }
        });
      })();
    </script>

    <script is:inline>
      /** 管理画面共通の確認ダイアログ。ブラウザの confirm は使わない */
      window.adminConfirm = (text, label) => {
        const box = document.getElementById("ask");
        const yes = box.querySelector('[data-ask="yes"]');
        document.getElementById("askText").textContent = text;
        yes.textContent = label ?? "削除する";
        return new Promise((done) => {
          const close = (ok) => {
            box.removeEventListener("close", onClose);
            box.close();
            done(ok);
          };
          const onClose = () => done(false);
          box.addEventListener("close", onClose, { once: true });
          yes.onclick = () => close(true);
          box.querySelector('[data-ask="no"]').onclick = () => close(false);
          box.showModal();
        });
      };
    </script>
    </div>

    <style is:global>
      :root {
        --a-bg: #f6f6f4;
        --a-panel: #ffffff;
        --a-ink: #1b1b1e;
        --a-muted: #6d6d76;
        --a-line: #dedee2;
        --a-accent: #b8860b;
        --a-danger: #b3261e;
        --a-radius: 8px;
        --a-side: 216px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--a-bg);
        color: var(--a-ink);
        font-family: "Hiragino Sans", "Noto Sans JP", system-ui, sans-serif;
        font-size: 15px;
        line-height: 1.7;
      }

      a {
        color: inherit;
      }

      .shell {
        display: grid;
        grid-template-columns: var(--a-side) minmax(0, 1fr);
        min-height: 100vh;
      }

      /* ---- 左のメニュー ---- */
      .side {
        position: sticky;
        top: 0;
        align-self: start;
        height: 100vh;
        display: flex;
        flex-direction: column;
        padding: 20px 14px;
        background: var(--a-ink);
        color: #fff;
      }

      .side__home {
        display: block;
        padding: 0 8px 18px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-decoration: none;
      }

      .side__home span {
        display: block;
        font-size: 11px;
        font-weight: 400;
        letter-spacing: 0.16em;
        color: #9b9ba3;
      }

      .side__nav {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .side__nav a {
        padding: 10px 12px;
        border-radius: var(--a-radius);
        color: #d7d7dc;
        text-decoration: none;
      }


      .side__nav a:hover {
        background: rgb(255 255 255 / 0.08);
        color: #fff;
      }

      .side__nav a[aria-current] {
        background: #fff;
        color: var(--a-ink);
        font-weight: 700;
      }

      .side__foot {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 0 12px;
        font-size: 13px;
      }

      .side__foot a,
      .side__foot button {
        padding: 0;
        border: 0;
        background: none;
        color: #9b9ba3;
        font: inherit;
        text-align: left;
        text-decoration: none;
        cursor: pointer;
      }

      .side__foot a:hover,
      .side__foot button:hover {
        color: #fff;
      }

      /* ---- 本体 ---- */
      .main {
        padding: 28px clamp(20px, 4vw, 44px) 80px;
        max-width: 1000px;
      }

      .main--wide {
        max-width: none;
      }

      .head {
        margin-bottom: 24px;
      }

      .head h1 {
        margin: 0;
        font-size: 24px;
        letter-spacing: 0.02em;
      }

      /* ---- ページの公開・非公開 ----
         見落とさないよう、見出しのすぐ下に帯で出す。非公開のときは色を変える */
      .pub {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin: -8px 0 24px;
        padding: 12px 16px;
        border: 1px solid #b7dfc3;
        border-radius: var(--a-radius);
        background: #eef8f1;
      }

      .pub--hidden {
        border-color: #e6cf8f;
        background: #fdf6e3;
      }

      .pub__switch {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 0;
        border: 0;
        background: none;
        font: inherit;
        font-weight: 700;
        color: var(--a-ink);
        cursor: pointer;
      }

      .pub__switch:disabled {
        cursor: progress;
        opacity: 0.6;
      }

      .pub__track {
        position: relative;
        width: 46px;
        height: 26px;
        border-radius: 999px;
        background: #2e9d57;
        transition: background 0.2s ease;
      }

      .pub__thumb {
        position: absolute;
        top: 3px;
        left: 23px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
        transition: left 0.2s ease;
      }

      .pub--hidden .pub__track {
        background: #b9b9c0;
      }

      .pub--hidden .pub__thumb {
        left: 3px;
      }

      .pub__switch:focus-visible .pub__track {
        outline: 2px solid var(--a-ink);
        outline-offset: 2px;
      }

      .pub__state {
        min-width: 4em;
      }

      .pub__text {
        margin: 0;
        font-size: 13px;
        color: var(--a-muted);
      }

      .side__chip {
        display: inline-block;
        white-space: nowrap;
        margin-left: 8px;
        padding: 1px 7px;
        border-radius: 999px;
        background: #e6cf8f;
        color: #5a4610;
        font-size: 11px;
        font-weight: 700;
        vertical-align: 1px;
      }


      /* ---- 共通部品 ---- */
      .panel {
        background: var(--a-panel);
        border: 1px solid var(--a-line);
        border-radius: var(--a-radius);
        padding: 20px;
      }

      .panel + .panel {
        margin-top: 16px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 38px;
        padding: 0 16px;
        border: 1px solid var(--a-ink);
        border-radius: var(--a-radius);
        background: var(--a-ink);
        color: #fff;
        font: inherit;
        font-size: 14px;
        text-decoration: none;
        cursor: pointer;
      }

      .btn--small {
        min-height: 30px;
        padding: 0 12px;
        font-size: 13px;
      }

      .btn--ghost {
        background: transparent;
        color: var(--a-ink);
        border-color: var(--a-line);
      }

      .btn--danger {
        background: transparent;
        border-color: var(--a-danger);
        color: var(--a-danger);
      }

      .btn:disabled {
        opacity: 0.5;
        cursor: default;
      }

      @media (max-width: 720px) {
        .shell {
          grid-template-columns: 1fr;
        }

        .side {
          position: static;
          height: auto;
          flex-direction: row;
          align-items: center;
          gap: 12px;
          overflow-x: auto;
        }

        .side__home {
          padding: 0 8px 0 0;
        }

        .side__nav {
          flex-direction: row;
        }

        .side__foot {
          margin: 0 0 0 auto;
          flex-direction: row;
          gap: 12px;
        }

        /* 幅が足りないときは縮めずに横へ流す（縮めると1文字ずつ縦に折れて読めない） */
        .side > *,
        .side__nav > a,
        .side__foot > * {
          flex-shrink: 0;
          white-space: nowrap;
        }
      }
    </style>
  </body>
</html>
